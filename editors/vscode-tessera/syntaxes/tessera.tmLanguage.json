{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tessera",
  "scopeName": "source.tessera",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#pipelineOperators" },
    { "include": "#operators" },
    { "include": "#annotations" },
    { "include": "#functionCalls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tessera",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.tessera",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tessera",
          "begin": "\\b[rR]\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.tessera",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.tessera",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.tessera",
              "match": "\\\\(?:[0abfnrtv\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
            },
            {
              "name": "meta.interpolation.tessera",
              "begin": "\\\\\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.tessera" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.tessera" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.tessera",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tessera",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tessera",
          "match": "(?<![A-Za-z0-9_])(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|(?:[0-9]+\\.[0-9]*|\\.[0-9]+|[0-9]+)(?:[eE][+-]?[0-9]+)?)(?![A-Za-z0-9_])"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.tessera" },
            "2": { "name": "entity.name.function.tessera" }
          }
        },
        {
          "match": "\\b(def)\\s+(operator)\\s+([^\\s(]+)",
          "captures": {
            "1": { "name": "storage.type.function.tessera" },
            "2": { "name": "storage.modifier.tessera" },
            "3": { "name": "entity.name.function.operator.tessera" }
          }
        },
        {
          "match": "\\b(?:class|struct|object|molecule|cfd|ode|protein)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.tessera" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tessera",
          "match": "\\b(?:case|class|def|else|extends|for|if|import|match|new|object|operator|override|return|struct|super|this|val|var|while|to|until|and|or|xor|map|pmap|reduce|preduce|filter|external|inline|constexpr|template|typename|mut|box|unsafe|unatomic|async|await|build|molecule|cfd|ode|protein|atom|bond|at|steps|dt|temperature|grid|viscosity|velocity|euler|from|step|lattice|spacing|chain|mcmc|cpu|simd|openmp|gpu)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tessera",
          "match": "\\b(?:Int|Long|Float|Double|Real|Bool|Boolean|Char|String|Nat|Unit|Void|Tensor|Vector|Matrix|Array|Shared|Weak|Regex)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.tessera",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "support.class.tessera",
          "match": "\\b(?:System|Console|Math|IO|File)\\b"
        }
      ]
    },
    "pipelineOperators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.tessera",
          "match": ">>\\||<<\\|"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tessera",
          "match": "=>|->|<-|\\[@|\\+\\+|--|\\*\\*|==|!=|<=|>=|<<|>>|\\+=|-=|\\*=|/=|%=|<:|<%|>:|\\.\\.|[=+\\-*/%&|^~!<>?:;,.@#$\\\\]"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.modifier.annotation.tessera",
          "match": "\\[@[A-Za-z_][A-Za-z0-9_]*\\]"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "support.function.tessera",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    }
  }
}
