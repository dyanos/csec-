// Simple feedforward neural network (multilayer perceptron) in CSEC.
//
//   inputs (3) --[W1,b1]--> hidden (4) --ReLU--> --[W2,b2]--> outputs (2)
//
// Batch size 1: a single forward pass over one input row, with fixed weights.
// Demonstrates tensor types, matrix multiply (@), bias add (+), element access,
// and a hand-rolled ReLU activation.

// ReLU applied element-wise to a 1x4 row vector: max(0, v) per element.
def relu4(z: Tensor<Double, 1, 4>): Tensor<Double, 1, 4> {
    val out: Tensor<Double, 1, 4> = new Tensor<Double, 1, 4>(0.0);
    var j: Int = 0;
    while (j < 4) {
        val v: Double = z[0, j];
        if (v > 0.0) {
            out[0, j] = v;
        }
        else {
            out[0, j] = 0.0;
        }
        j = j + 1;
    }
    return out;
}

// Affine map + activation for the hidden layer, then a linear output layer:
//   h = ReLU(x @ W1 + b1)
//   y =      h @ W2 + b2
def forward(
    x: Tensor<Double, 1, 3>,
    w1: Tensor<Double, 3, 4>,
    b1: Tensor<Double, 1, 4>,
    w2: Tensor<Double, 4, 2>,
    b2: Tensor<Double, 1, 2>
): Tensor<Double, 1, 2> {
    val z1: Tensor<Double, 1, 4> = (x @ w1) + b1;
    val h:  Tensor<Double, 1, 4> = relu4(z1);
    val y:  Tensor<Double, 1, 2> = (h @ w2) + b2;
    return y;
}

def printRow4(label: String, t: Tensor<Double, 1, 4>): Int {
    print(label);
    print("[");
    print(t[0, 0]); print(", "); print(t[0, 1]); print(", ");
    print(t[0, 2]); print(", "); print(t[0, 3]);
    println("]");
    return 0;
}

def main(): Int {
    // Input features.
    val x: Tensor<Double, 1, 3> = new Tensor<Double, 1, 3>(0.0);
    x[0, 0] = 1.0;
    x[0, 1] = 0.5;
    x[0, 2] = -1.0;

    // Layer 1 (3 -> 4): weights 0.5, bias 0, but drive hidden unit 0 negative so
    // ReLU visibly clips it to zero.
    val w1: Tensor<Double, 3, 4> = new Tensor<Double, 3, 4>(0.5);
    val b1: Tensor<Double, 1, 4> = new Tensor<Double, 1, 4>(0.0);
    b1[0, 0] = -2.0;

    // Layer 2 (4 -> 2): weights 0.5, bias 0.1.
    val w2: Tensor<Double, 4, 2> = new Tensor<Double, 4, 2>(0.5);
    val b2: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(0.1);

    // Peek at the hidden activations to see ReLU at work (unit 0 clipped to 0).
    val z1: Tensor<Double, 1, 4> = (x @ w1) + b1;
    val ignore1: Int = printRow4("pre-activation = ", z1);
    val ignore2: Int = printRow4("hidden (ReLU)  = ", relu4(z1));

    val y: Tensor<Double, 1, 2> = forward(x, w1, b1, w2, b2);
    print("output = [");
    print(y[0, 0]); print(", "); print(y[0, 1]);
    println("]");

    return 0;
}
