// ============================================================================
//  fortran_array_sections.csec
//
//  Fortran's ':' array-section operator on CSEC++ tensors. A section  t[i:j]
//  (optionally strided, t[i:j:k]) names a run of elements; t[:] is the whole
//  array. Sections read, take part in arithmetic, and -- as in Fortran -- can
//  be assigned: a scalar broadcasts to every element, or another tensor/section
//  copies element-wise. No explicit loops.
// ============================================================================

def show6(name: String, t: Tensor<Double, 6>): Int {
    println(name + " = [" + t[0] + " " + t[1] + " " + t[2] + " " +
            t[3] + " " + t[4] + " " + t[5] + "]");
    return 0;
}

def main(): Int {
    println("=================================================");
    println(" Fortran ':' array sections on CSEC++            ");
    println("=================================================");

    val a: Tensor<Double, 6> = new Tensor<Double, 6>(0.0);

    //  a(:) = 1.0        -- whole-array scalar broadcast
    a[:] = 1.0;
    val r1: Int = show6("a[:] = 1.0        ", a);

    //  a(2:5) = 5.0      -- assign a scalar to a section
    a[2:5] = 5.0;
    val r2: Int = show6("a[2:5] = 5.0      ", a);

    //  a(0:6:2) = 9.0    -- strided section (every other element)
    a[0:6:2] = 9.0;
    val r3: Int = show6("a[0:6:2] = 9.0    ", a);

    // Section-to-section copy (Fortran  a(0:3) = b(3:6)).
    val b: Tensor<Double, 6> = new Tensor<Double, 6>(0.0);
    b[0] = 10.0;  b[1] = 11.0;  b[2] = 12.0;  b[3] = 13.0;  b[4] = 14.0;  b[5] = 15.0;
    a[0:3] = b[3:6];
    val r4: Int = show6("a[0:3] = b[3:6]   ", a);

    println("");
    println("--- Section arithmetic (no loops) ---");
    // A three-point moving average of b's interior, all at once:
    //   avg(i) = (b(i-1) + b(i) + b(i+1)) / 3   for i = 1..4
    val avg: Tensor<Double, 4> = (b[0:4] + b[1:5] + b[2:6]) / 3.0;
    println("  b               = [" + b[0] + " " + b[1] + " " + b[2] + " " +
            b[3] + " " + b[4] + " " + b[5] + "]");
    println("  3-pt moving avg = [" + avg[0] + " " + avg[1] + " " + avg[2] + " " + avg[3] + "]");

    // Dot product of two sections.
    val dot: Double = b[0:3] inner b[3:6];   // 10*13 + 11*14 + 12*15 = 464
    println("  b[0:3] . b[3:6] = " + dot);

    println("=================================================");
    return 0;
}
