// ============================================================================
//  gaussian_integers_nat.csec
//
//  Demonstration of the built-in `Nat` type: a *natural number extended into
//  the imaginary direction* -- a Gaussian integer  z = re + im*i  with whole
//  re and im.  These form the ring Z[i]: closed under +, -, and *.
//
//  Built-in:  new Nat(re, im),  z.re,  z.im,  z1 + z2,  z1 - z2,  z1 * z2.
//  Everything else below (norm, conjugate, pretty-print, equality) is ordinary
//  CSEC written on top of them.
// ============================================================================

// Gaussian norm  N(z) = re^2 + im^2  (a natural number; it is multiplicative).
def norm(z: Nat): Long = z.re * z.re + z.im * z.im

// Complex conjugate  conj(re + im i) = re - im i.
def conj(z: Nat): Nat = new Nat(z.re, 0 - z.im)

def natEq(a: Nat, b: Nat): Boolean = a.re == b.re and a.im == b.im

// Pretty-print  "re + im i"  /  "re - |im| i".
def show(z: Nat): String {
    if (z.im < 0) {
        return z.re + " - " + (0 - z.im) + "i";
    }
    return z.re + " + " + z.im + "i";
}

def main(): Int {
    println("=====================================================");
    println(" Gaussian integers  Z[i]  via the built-in Nat type  ");
    println("=====================================================");

    val a: Nat = new Nat(3, 2);      // 3 + 2i
    val b: Nat = new Nat(1, 4);      // 1 + 4i

    println("a           = " + show(a));
    println("b           = " + show(b));
    println("");
    println("a + b       = " + show(a + b));            // 4 + 6i
    println("a - b       = " + show(a - b));            // 2 - 2i
    println("a * b       = " + show(a * b));            // -5 + 14i
    println("conj(a)     = " + show(conj(a)));          // 3 - 2i

    // z * conj(z) = N(z) + 0 i  (the norm, purely real)
    val aa: Nat = a * conj(a);
    println("a * conj(a) = " + show(aa) + "   (= N(a) = " + norm(a) + ")");

    println("");
    println("--- The norm is multiplicative:  N(a*b) = N(a) * N(b) ---");
    val prod: Nat = a * b;
    println("  N(a)      = " + norm(a));                // 13
    println("  N(b)      = " + norm(b));                // 17
    println("  N(a*b)    = " + norm(prod));             // 221
    println("  N(a)*N(b) = " + (norm(a) * norm(b)));    // 221
    if (norm(prod) == norm(a) * norm(b)) {
        println("  => confirmed:  221 = 13 * 17");
    }

    println("");
    println("--- i is the imaginary unit:  i * i = -1 ---");
    val i: Nat = new Nat(0, 1);
    val i2: Nat = i * i;
    println("  i         = " + show(i));
    println("  i * i     = " + show(i2));               // -1 + 0i
    if (natEq(i2, new Nat(0 - 1, 0))) {
        println("  => confirmed:  i^2 = -1");
    }

    // Distributivity check on integers:  (a + b) * i  ==  a*i + b*i
    val lhs: Nat = (a + b) * i;
    val rhs: Nat = a * i + b * i;
    println("");
    println("--- Distributivity:  (a+b)*i = a*i + b*i ---");
    println("  (a+b)*i   = " + show(lhs));
    println("  a*i + b*i = " + show(rhs));
    if (natEq(lhs, rhs)) {
        println("  => confirmed.");
    }

    println("=====================================================");
    return 0;
}
