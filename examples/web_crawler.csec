// web_crawler -- breadth-first crawl of one web site with std.http.
//
//     csec++ examples/web_crawler.csec --emit-ir -o web_crawler.ll
//     csec++ --run-ir web_crawler.ll -- <start-url> [max-pages] [workers] [max-depth]
//
//     web_crawler https://example.com/ 30 4 3
//
// Starting from one URL, the crawler follows <a href> links that stay on the same host, up to
// max-pages pages (default 20) and max-depth links away from the start (default 3). `workers`
// microthreads (default 4) fetch pages at the same time: each request waits cooperatively, so while
// one worker waits for its page the others keep going. For every HTML page it prints the status,
// depth, title, word count, and link count; at the end it prints a JSON summary of the crawl.
//
// The shared crawl state (queue, seen set, results) is a std.json document; microthreads run on one
// OS thread and only switch at waits, so they can update it without locks.
//
// Be polite when crawling sites you do not own: keep max-pages and workers small, and check the
// site's /robots.txt first.

import std.http
import std.json
import std.io
import std.microthread

// Links to files that are not web pages are skipped without fetching them.
def looksLikeFile(url: String): Boolean {
    val lower: String = url.toLower();
    var path: String = lower;
    val query: Int = lower.indexOf("?");
    if (query >= 0) {
        path = lower.substring(0, query);
    }
    if (path.endsWith(".png") or path.endsWith(".jpg") or path.endsWith(".jpeg") or path.endsWith(".gif")) {
        return true;
    }
    if (path.endsWith(".svg") or path.endsWith(".ico") or path.endsWith(".webp") or path.endsWith(".pdf")) {
        return true;
    }
    if (path.endsWith(".zip") or path.endsWith(".gz") or path.endsWith(".tar") or path.endsWith(".exe")) {
        return true;
    }
    if (path.endsWith(".mp4") or path.endsWith(".mp3") or path.endsWith(".css") or path.endsWith(".js")) {
        return true;
    }
    return false;
}

def wordCount(text: String): Long {
    var count: Long = 0;
    var inWord: Boolean = false;
    var i: Int = 0;
    while (i < text.length) {
        val c: Char = text[i];
        if (c == ' ' or c == '\n' or c == '\t' or c == '\r') {
            inWord = false;
        } else {
            if (!inWord) {
                count = count + 1;
            }
            inWord = true;
        }
        i = i + 1;
    }
    return count;
}

// Queue `url` at `depth` unless it was seen before; true if it was added.
def enqueue(state: Json, url: String, depth: Long): Boolean {
    val seenPath: String = "seen" + jsonKey(url);
    if (state.has(seenPath)) {
        return false;
    }
    state.set(seenPath, true);
    state.set("queue[].url", url);
    state.set("queue[-1].depth", depth);
    return true;
}

// Fetch one page, record it, and queue its same-host links.
def crawlPage(state: Json, url: String, depth: Long, maxDepth: Long): Int {
    val response = httpRequest("GET", url)
        .header("Accept", "text/html,application/xhtml+xml")
        .timeout(20000)
        .send();
    val status: Int = response.status();
    if (status == 0) {
        println("  error  " + url + ": " + response.error());
        state.set("pages[].url", url).set("pages[-1].status", 0).set("pages[-1].error", response.error());
        response.close();
        return 0;
    }
    val isHtml: Boolean = response.contentType().toLower().contains("html");
    if (!response.ok() or !isHtml) {
        println("  " + status + "    " + url + " (" + response.contentType() + ")");
        state.set("pages[].url", url).set("pages[-1].status", status).set("pages[-1].depth", depth);
        response.close();
        return 0;
    }

    val html: String = response.text();
    response.close();
    val title: String = htmlTitle(html);
    val words: Long = wordCount(htmlToText(html));
    val links: String = htmlLinks(html, url);

    // htmlLinks gives one resolved http(s) link per line.
    var linkCount: Long = 0;
    var queued: Long = 0;
    var rest: String = links;
    while (rest != "") {
        val end: Int = rest.indexOf("\n");
        var link: String = rest;
        if (end >= 0) {
            link = rest.substring(0, end);
            rest = rest.substring(end + 1, rest.length - end - 1);
        } else {
            rest = "";
        }
        if (link != "") {
            linkCount = linkCount + 1;
            if (depth < maxDepth and sameHost(link, url) and !looksLikeFile(link)) {
                if (enqueue(state, link, depth + 1)) {
                    queued = queued + 1;
                }
            }
        }
    }

    println("  " + status + "  d" + depth + "  " + url);
    println("         \"" + title + "\", " + words + " words, " + linkCount + " links (" + queued + " new)");
    state.set("pages[].url", url)
        .set("pages[-1].status", status)
        .set("pages[-1].depth", depth)
        .set("pages[-1].title", title)
        .set("pages[-1].words", words)
        .set("pages[-1].links", linkCount);
    return 0;
}

// One worker: take the next queued URL until the page budget is used up or nothing is left.
def worker(state: Json, maxPages: Long, maxDepth: Long): Int {
    var running: Boolean = true;
    while (running) {
        val next: Long = state.getLong("next");
        if (state.getLong("taken") >= maxPages) {
            running = false;
        } else if (next < state.length("queue")) {
            val entry: String = "queue[" + next + "]";
            val url: String = state.getString(entry + ".url");
            val depth: Long = state.getLong(entry + ".depth");
            state.set("next", next + 1);
            state.set("taken", state.getLong("taken") + 1);
            state.set("busy", state.getLong("busy") + 1);
            crawlPage(state, url, depth, maxDepth);
            state.set("busy", state.getLong("busy") - 1);
        } else if (state.getLong("busy") == 0) {
            // Queue empty and nobody fetching: nothing more can be found.
            running = false;
        } else {
            // Others are still fetching pages that may add links.
            yield();
        }
    }
    state.set("finished", state.getLong("finished") + 1);
    return 0;
}

def main(): Int {
    if (commandLineArgCount() < 2) {
        println("usage: web_crawler <start-url> [max-pages] [workers] [max-depth]");
        return 2;
    }
    val start: String = commandLineArg(1);
    var maxPages: Long = 20;
    var workers: Long = 4;
    var maxDepth: Long = 3;
    if (commandLineArgCount() >= 3) {
        maxPages = parseLong(commandLineArg(2), 20);
    }
    if (commandLineArgCount() >= 4) {
        workers = parseLong(commandLineArg(3), 4);
    }
    if (commandLineArgCount() >= 5) {
        maxDepth = parseLong(commandLineArg(4), 3);
    }
    if (urlHost(start) == "") {
        println("not an absolute URL: " + start);
        return 2;
    }

    println("crawling " + urlHost(start) + " from " + start + " (max " + maxPages + " pages, " + workers +
            " workers, depth " + maxDepth + ")");
    val state = jsonObject()
        .setArray("queue")
        .setObject("seen")
        .setArray("pages")
        .set("next", 0)
        .set("taken", 0)
        .set("busy", 0)
        .set("finished", 0);
    enqueue(state, start, 0);

    var i: Long = 0;
    while (i < workers) {
        spawn([=]() -> {
            return worker(state, maxPages, maxDepth);
        });
        i = i + 1;
    }
    while (state.getLong("finished") < workers) {
        yield();
    }

    // Summary.
    val pages = state.get("pages");
    var ok: Long = 0;
    var j: Long = 0;
    while (j < pages.length()) {
        val status: Long = pages.getLong("[" + j + "].status");
        if (status >= 200 and status < 300) {
            ok = ok + 1;
        }
        j = j + 1;
    }
    val summary = jsonObject()
        .set("start", start)
        .set("host", urlHost(start))
        .set("fetched", pages.length())
        .set("ok", ok)
        .set("queued_not_fetched", state.length("queue") - state.getLong("next"))
        .set("pages", pages);
    println("---- summary ----");
    println(summary.pretty());
    if (ok == 0) {
        return 1;
    }
    return 0;
}
