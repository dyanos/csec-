    if (group == 1 and kind == kindOperator()) {
        return strEq(text, "=") or strEq(text, "<-") or strEq(text, "+=") or strEq(text, "-=") or
            strEq(text, "*=") or strEq(text, "/=") or strEq(text, "%=");
    }
    if (group == 2) {
        return (kind == kindKeyword() and strEq(text, "or")) or
            (kind == kindOperator() and (strEq(text, "||") or strEq(text, "|")));
    }
    if (group == 3) {
        return (kind == kindKeyword() and strEq(text, "and")) or
            (kind == kindOperator() and strEq(text, "&&"));
    }
    if (group == 8) {
        return (kind == kindKeyword() and strEq(text, "xor")) or
            (kind == kindOperator() and strEq(text, "^"));
    }
    if (group == 9 and kind == kindOperator()) {
        return strEq(text, "&");
    }
    if (group == 4 and kind == kindOperator()) {
        return strEq(text, "==") or strEq(text, "!=") or strEq(text, "<") or
            strEq(text, ">") or strEq(text, "<=") or strEq(text, ">=");
    }
    if (group == 10 and kind == kindOperator()) {
        return strEq(text, "<<") or strEq(text, ">>");
    }
    if (group == 5) {
        return (kind == kindOperator() and strEq(text, "..")) or
            (kind == kindKeyword() and (strEq(text, "to") or strEq(text, "until")));
    }
    if (group == 6 and kind == kindOperator()) {
        return strEq(text, "+") or strEq(text, "-");
    }
    if (group == 7 and kind == kindOperator()) {
        return strEq(text, "*") or strEq(text, "/") or strEq(text, "%") or strEq(text, "@");
    }
    if (group == 11 and kind == kindKeyword()) {
        return strEq(text, "inner") or strEq(text, "outer") or strEq(text, "tensor");
    }
    return false;
}

def findTopLevelOperator(tokens: String, start: Int, end: Int, group: Int): Int {
    var cursor: Int = end - 1;
    var paren: Int = 0;
    var brace: Int = 0;
    var bracket: Int = 0;
    while (cursor >= start) {
        val text: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            if (strEq(text, ")")) {
                paren = paren + 1;
            }
            else if (strEq(text, "(")) {
                paren = paren - 1;
            }
            else if (strEq(text, "}")) {
                brace = brace + 1;
            }
            else if (strEq(text, "{")) {
                brace = brace - 1;
            }
            else if (strEq(text, "]")) {
                bracket = bracket + 1;
            }
            else if (strEq(text, "[")) {
                bracket = bracket - 1;
            }
        }
        if (paren == 0 and brace == 0 and bracket == 0 and
            tokenIsTopLevelOperator(tokens, cursor, group)) {
            return cursor;
        }
        cursor = cursor - 1;
    }
    return -1;
}

def findTopLevelMatch(tokens: String, start: Int, end: Int): Int {
    var cursor: Int = start;
    var paren: Int = 0;
    var brace: Int = 0;
    var bracket: Int = 0;
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        val text: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            if (strEq(text, "(")) { paren = paren + 1; }
            else if (strEq(text, ")")) { paren = paren - 1; }
            else if (strEq(text, "{")) { brace = brace + 1; }
            else if (strEq(text, "}")) { brace = brace - 1; }
            else if (strEq(text, "[")) { bracket = bracket + 1; }
            else if (strEq(text, "]")) { bracket = bracket - 1; }
        }
        if (paren == 0 and brace == 0 and bracket == 0 and
            tokenIs(tokens, cursor, kindKeyword(), "match")) {
            return cursor;
        }
        cursor = cursor + 1;
    }
    return -1;
}

def findClosingToken(tokens: String, openOrdinal: Int, end: Int, openText: String, closeText: String): Int {
    var cursor: Int = openOrdinal;
    var depth: Int = 0;
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            val text: String = tokenTextAt(tokens, cursor);
            if (strEq(text, openText)) {
                depth = depth + 1;
            }
            else if (strEq(text, closeText)) {
                depth = depth - 1;
                if (depth == 0) {
                    return cursor;
                }
            }
        }
        cursor = cursor + 1;
    }
    return -1;
}

def trimExpressionEnd(tokens: String, start: Int, end: Int): Int {
    var last: Int = end;
    while (last > start and tokenKindAt(tokens, last - 1) == kindComment()) {
        last = last - 1;
    }
    if (last > start and tokenIs(tokens, last - 1, kindOperator(), ";")) {
        return last - 1;
    }
    return last;
}

def expressionLeafKind(tokens: String, start: Int, end: Int): String {
    if (end <= start) {
        return "empty";
    }
    val kind: Char = tokenKindAt(tokens, start);
    if (kind == kindInteger()) { return "integer"; }
    if (kind == kindFloat()) { return "float"; }
    if (kind == kindString()) { return "string"; }
    if (kind == kindRegex()) { return "regex"; }
    if (kind == kindChar()) { return "char"; }
    if (kind == kindBool()) { return "bool"; }
    if (kind == kindIdentifier()) { return "identifier"; }
    if (kind == kindKeyword()) {
        val text: String = tokenTextAt(tokens, start);
        if (strEq(text, "this")) { return "this"; }
        if (strEq(text, "super")) { return "super"; }
        if (strEq(text, "new")) { return "new"; }
        if (strEq(text, "match")) { return "match"; }
    }
    return "unknown";
}

def findTokenTextInRange(tokens: String, start: Int, end: Int, text: String): Int {
    var cursor: Int = start;
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        if (strEq(tokenTextAt(tokens, cursor), text)) {
            return cursor;
        }
        cursor = cursor + 1;
    }
    return -1;
}

def countMatchCases(tokens: String, matchOrdinal: Int, end: Int): Int {
    val openBrace: Int = findTokenTextInRange(tokens, matchOrdinal, end, "{");
    if (openBrace < 0) {
        return 0;
    }
    val closeBrace: Int = findClosingToken(tokens, openBrace, end, "{", "}");
    var cursor: Int = openBrace + 1;
    var count: Int = 0;
    while (cursor < closeBrace and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "case")) {
            count = count + 1;
        }
        cursor = cursor + 1;
    }
    return count;
}

def findStatementParenStart(tokens: String, start: Int, end: Int): Int {
    return findTokenTextInRange(tokens, start, end, "(");
}

def findStatementParenEnd(tokens: String, start: Int, end: Int): Int {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    if (openParen < 0) {
        return -1;
    }
    return findClosingToken(tokens, openParen, end, "(", ")");
}

def findStatementBlockStart(tokens: String, start: Int, end: Int): Int {
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    if (closeParen >= 0) {
        return findTokenTextInRange(tokens, closeParen + 1, end, "{");
    }
    return findTokenTextInRange(tokens, start, end, "{");
}

def findStatementBlockEnd(tokens: String, start: Int, end: Int): Int {
    val openBrace: Int = findStatementBlockStart(tokens, start, end);
    if (openBrace < 0) {
        return -1;
    }
    return findClosingToken(tokens, openBrace, end, "{", "}");
}

def statementHeaderExpression(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    if (openParen >= 0 and closeParen > openParen) {
        return appendExpressionUntil(tokens, openParen + 1, closeParen);
    }
    return "";
}

def countCommaSeparated(tokens: String, start: Int, end: Int): Int {
    if (end <= start) {
        return 0;
    }
    var cursor: Int = start;
    var count: Int = 1;
    var paren: Int = 0;
    var bracket: Int = 0;
    var brace: Int = 0;
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        val text: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            if (strEq(text, "(")) { paren = paren + 1; }
            else if (strEq(text, ")")) { paren = paren - 1; }
            else if (strEq(text, "[")) { bracket = bracket + 1; }
            else if (strEq(text, "]")) { bracket = bracket - 1; }
            else if (strEq(text, "{")) { brace = brace + 1; }
            else if (strEq(text, "}")) { brace = brace - 1; }
            else if (strEq(text, ",") and paren == 0 and bracket == 0 and brace == 0) {
                count = count + 1;
            }
        }
        cursor = cursor + 1;
    }
    return count;
}

def findLastTopLevelToken(tokens: String, start: Int, end: Int, text: String): Int {
    var cursor: Int = end - 1;
    var paren: Int = 0;
    var bracket: Int = 0;
    var brace: Int = 0;
    while (cursor >= start) {
        val current: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            if (strEq(current, ")")) { paren = paren + 1; }
            else if (strEq(current, "(")) { paren = paren - 1; }
            else if (strEq(current, "]")) { bracket = bracket + 1; }
            else if (strEq(current, "[")) { bracket = bracket - 1; }
            else if (strEq(current, "}")) { brace = brace + 1; }
            else if (strEq(current, "{")) { brace = brace - 1; }
        }
        if (paren == 0 and bracket == 0 and brace == 0 and strEq(current, text)) {
            return cursor;
        }
        cursor = cursor - 1;
    }
    return -1;
}

def summarizePostfixExpression(tokens: String, start: Int, end: Int): String {
    if (end <= start) {
        return "";
    }
    if (tokenIs(tokens, end - 1, kindOperator(), ")")) {
        val open: Int = findLastTopLevelToken(tokens, start, end, "(");
        if (open > start) {
            return "Expr call target=" + appendExpressionUntil(tokens, start, open) +
                " argc=" + countCommaSeparated(tokens, open + 1, end - 1);
        }
    }
    if (tokenIs(tokens, end - 1, kindOperator(), "]")) {
        val openBracket: Int = findLastTopLevelToken(tokens, start, end, "[");
        if (openBracket > start) {
            return "Expr index target=" + appendExpressionUntil(tokens, start, openBracket) +
                " argc=" + countCommaSeparated(tokens, openBracket + 1, end - 1);
        }
    }
    val dot: Int = findLastTopLevelToken(tokens, start, end, ".");
    if (dot > start) {
        return "Expr member " + appendExpressionUntil(tokens, start, dot) + "." +
            appendExpressionUntil(tokens, dot + 1, end);
    }
    return "";
}

def findLambdaArrow(tokens: String, start: Int, end: Int): Int {
    val closeCapture: Int = findClosingToken(tokens, start, end, "[", "]");
    if (closeCapture < 0) {
        return -1;
    }
    val openParams: Int = skipTrivia(tokens, closeCapture + 1);
    if (!tokenIs(tokens, openParams, kindOperator(), "(")) {
        return -1;
    }
    val closeParams: Int = findClosingToken(tokens, openParams, end, "(", ")");
    if (closeParams < 0) {
        return -1;
    }
    val arrow: Int = skipTrivia(tokens, closeParams + 1);
    if (tokenIs(tokens, arrow, kindOperator(), "->")) {
        return arrow;
    }
    return -1;
}

def lambdaCaptureSummary(tokens: String, start: Int, end: Int): String {
    val closeCapture: Int = findClosingToken(tokens, start, end, "[", "]");
    if (closeCapture <= start + 1) {
        return "none";
    }
    return appendExpressionUntil(tokens, start + 1, closeCapture);
}

def lambdaParameterCount(tokens: String, start: Int, end: Int): Int {
    val closeCapture: Int = findClosingToken(tokens, start, end, "[", "]");
    if (closeCapture < 0) {
        return 0;
    }
    val openParams: Int = skipTrivia(tokens, closeCapture + 1);
    if (!tokenIs(tokens, openParams, kindOperator(), "(")) {
        return 0;
    }
    val closeParams: Int = findClosingToken(tokens, openParams, end, "(", ")");
    return countCommaSeparated(tokens, openParams + 1, closeParams);
}

def summarizeLambdaExpression(tokens: String, start: Int, end: Int): String {
    if (!tokenIs(tokens, start, kindOperator(), "[")) {
        return "";
    }
    val arrow: Int = findLambdaArrow(tokens, start, end);
    if (arrow < 0) {
        return "";
    }
    return "Expr lambda capture=" + lambdaCaptureSummary(tokens, start, end) +
        " params=" + lambdaParameterCount(tokens, start, end);
}

def generateExpressionAST(tokens: String, rawStart: Int, rawEnd: Int): String {
    val start: Int = skipTrivia(tokens, rawStart);
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "Expr empty";
    }
    val lambda: String = summarizeLambdaExpression(tokens, start, end);
    if (lambda.length > 0) {
        return lambda;
    }
    val matchAt: Int = findTopLevelMatch(tokens, start, end);
    if (matchAt > start) {
        return "Expr match cases=" + countMatchCases(tokens, matchAt, end) + " [" +
            generateExpressionAST(tokens, start, matchAt) + "]";
    }
    if (tokenIs(tokens, start, kindOperator(), "(")) {
        val close: Int = findClosingToken(tokens, start, end, "(", ")");
        if (close == end - 1) {
            return "Expr group (" + generateExpressionAST(tokens, start + 1, end - 1) + ")";
        }
    }

    var op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op >= start) {
        return "Expr assign " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 2);
    if (op >= start) {
        return "Expr binary " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 3);
    if (op >= start) {
        return "Expr binary " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 8);
    if (op >= start) {
        return "Expr binary " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 9);
    if (op >= start) {
        return "Expr binary " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 4);
    if (op >= start) {
        return "Expr compare " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 10);
    if (op >= start) {
        return "Expr shift " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 5);
    if (op >= start) {
        return "Expr range " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 6);
    if (op > start) {
        return "Expr binary " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 7);
    if (op > start) {
        return "Expr binary " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }
    op = findTopLevelOperator(tokens, start, end, 11);
    if (op > start) {
        return "Expr tensor " + tokenTextAt(tokens, op) + " [" +
            generateExpressionAST(tokens, start, op) + "] [" +
            generateExpressionAST(tokens, op + 1, end) + "]";
    }

    if (tokenKindAt(tokens, start) == kindOperator() and
        (strEq(tokenTextAt(tokens, start), "!") or strEq(tokenTextAt(tokens, start), "-") or
         strEq(tokenTextAt(tokens, start), "+") or strEq(tokenTextAt(tokens, start), "~") or
         strEq(tokenTextAt(tokens, start), "*") or strEq(tokenTextAt(tokens, start), "&") or
         strEq(tokenTextAt(tokens, start), "<-") or strEq(tokenTextAt(tokens, start), "++") or
         strEq(tokenTextAt(tokens, start), "--"))) {
        return "Expr unary " + tokenTextAt(tokens, start) + " [" +
            generateExpressionAST(tokens, start + 1, end) + "]";
    }
    if (end > start + 1 and tokenKindAt(tokens, end - 1) == kindOperator() and
        (strEq(tokenTextAt(tokens, end - 1), "++") or strEq(tokenTextAt(tokens, end - 1), "--"))) {
        return "Expr postfix " + tokenTextAt(tokens, end - 1) + " [" +
            generateExpressionAST(tokens, start, end - 1) + "]";
    }
    val postfix: String = summarizePostfixExpression(tokens, start, end);
    if (postfix.length > 0) {
        return postfix;
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and
        start + 1 < end and tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return "Expr call " + tokenTextAt(tokens, start) + "(" +
            appendExpressionUntil(tokens, start + 2, end - 1) + ")";
    }
    if (tokenIs(tokens, start, kindOperator(), "[")) {
        return "Expr array count=" + countCommaSeparated(tokens, start + 1, end - 1) +
            " [" + appendExpressionUntil(tokens, start + 1, end - 1) + "]";
    }
    if (tokenKindAt(tokens, start) == kindKeyword() and strEq(tokenTextAt(tokens, start), "new")) {
        return "Expr new " + appendExpressionUntil(tokens, start + 1, end);
    }
    if (tokenKindAt(tokens, start) == kindKeyword() and strEq(tokenTextAt(tokens, start), "match")) {
        return "Expr match";
    }
    return "Expr " + expressionLeafKind(tokens, start, end) + " " +
        appendExpressionUntil(tokens, start, end);
}

def advanceStatement(tokens: String, ordinal: Int, bodyEnd: Int): Int {
    var cursor: Int = ordinal;
    var paren: Int = 0;
    var brace: Int = 0;
    var bracket: Int = 0;
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val text: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            if (strEq(text, "(")) {
                paren = paren + 1;
            }
            else if (strEq(text, ")")) {
                paren = paren - 1;
            }
            else if (strEq(text, "{")) {
                brace = brace + 1;
            }
            else if (strEq(text, "}")) {
                if (brace == 0 and paren == 0 and bracket == 0) {
                    return cursor;
                }
                brace = brace - 1;
                if (brace == 0 and paren == 0 and bracket == 0) {
                    val possibleElse: Int = skipTrivia(tokens, cursor + 1);
                    if (tokenIs(tokens, ordinal, kindKeyword(), "if") and
                        tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                        val afterElse: Int = skipTrivia(tokens, possibleElse + 1);
                        if (tokenIs(tokens, afterElse, kindKeyword(), "if")) {
                            return advanceStatement(tokens, afterElse, bodyEnd);
                        }
                        if (tokenIs(tokens, afterElse, kindOperator(), "{")) {
                            val elseEnd: Int = findClosingToken(tokens, afterElse, bodyEnd, "{", "}");
                            if (elseEnd > afterElse) {
                                return elseEnd + 1;
                            }
                        }
                    }
                    return cursor + 1;
                }
            }
            else if (strEq(text, "[")) {
                bracket = bracket + 1;
            }
            else if (strEq(text, "]")) {
                bracket = bracket - 1;
            }
            else if (strEq(text, ";") and brace == 0 and paren == 0 and bracket == 0) {
                return cursor + 1;
            }
        }
        cursor = cursor + 1;
    }
    return cursor;
}

def generateStatementAST(tokens: String, start: Int, end: Int): String {
    val kind: String = statementKind(tokens, start);
    if (strEq(kind, "return")) {
        return "  Stmt return " + generateExpressionAST(tokens, start + 1, end) + "\n";
    }
    if (strEq(kind, "value") or strEq(kind, "variable")) {
        val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
        if (initializer >= start) {
            return "  Stmt " + kind + " " + tokenTextAt(tokens, start + 1) + " = " +
                generateExpressionAST(tokens, initializer + 1, end) + "\n";
        }
        return "  Stmt " + kind + " " + tokenTextAt(tokens, start + 1) + "\n";
    }
    if (strEq(kind, "if") or strEq(kind, "for") or strEq(kind, "while") or
        strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
        strEq(kind, "preduce") or strEq(kind, "filter")) {
        return "  Stmt " + kind + " (" + statementHeaderExpression(tokens, start, end) + ")\n";
    }
    if (strEq(kind, "unsafe") or strEq(kind, "unatomic") or strEq(kind, "constexpr")) {
        return "  Stmt " + kind + "\n";
    }
    if (strEq(kind, "function") or strEq(kind, "object")) {
        return "  Stmt " + kind + " " + tokenTextAt(tokens, start + 1) + "\n";
    }
    return "  Stmt expression " + generateExpressionAST(tokens, start, end) + "\n";
}

def generateBodyAST(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (next <= cursor) {
            return output + "  Stmt error\n";
        }
        output = output + generateStatementAST(tokens, cursor, next);
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def findFunctionParamStart(tokens: String, declStart: Int): Int {
    var cursor: Int = declStart;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindOperator(), "(")) {
            return cursor;
        }
        if (tokenIs(tokens, cursor, kindOperator(), "{") or tokenIs(tokens, cursor, kindOperator(), ";")) {
            return -1;
        }
        cursor = cursor + 1;
    }
    return -1;
}

def findFunctionReturnTypeStart(tokens: String, declStart: Int): Int {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return -1;
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, declStart), "(", ")");
    if (paramEnd < 0) {
        return -1;
    }
    if (tokenIs(tokens, paramEnd + 1, kindOperator(), ":")) {
        return paramEnd + 2;
    }
    return -1;
}

def collectTypeName(tokens: String, start: Int, end: Int): String {
    var cursor: Int = start;
    var output: String = "";
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        val text: String = tokenTextAt(tokens, cursor);
        if (strEq(text, "{") or strEq(text, "=") or strEq(text, ";") or strEq(text, ",")) {
            return output;
        }
        output = output + text;
        cursor = cursor + 1;
    }
    return output;
}

def functionReturnType(tokens: String, declStart: Int): String {
    val typeStart: Int = findFunctionReturnTypeStart(tokens, declStart);
    if (typeStart < 0) {
        return "Unit";
    }
    val declEnd: Int = advanceTopLevelDecl(tokens, declStart);
    val typeName: String = collectTypeName(tokens, typeStart, declEnd);
    if (typeName.length == 0) {
        return "Unit";
    }
    return typeName;
}

def countFunctionParams(tokens: String, declStart: Int): Int {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return 0;
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, declStart), "(", ")");
    if (paramEnd <= paramStart + 1) {
        return 0;
    }
    var cursor: Int = paramStart + 1;
    var count: Int = 1;
    while (cursor < paramEnd) {
        if (tokenIs(tokens, cursor, kindOperator(), ",")) {
            count = count + 1;
        }
        cursor = cursor + 1;
    }
    return count;
}

def typeSummary(tokens: String, start: Int, end: Int): String {
    if (tokenIs(tokens, start, kindOperator(), "(")) {
        val close: Int = findClosingToken(tokens, start, end, "(", ")");
        if (close > start and tokenIs(tokens, close + 1, kindOperator(), "=>")) {
            return "FunctionType params=" + countCommaSeparated(tokens, start + 1, close) +
                " returns=" + collectTypeName(tokens, close + 2, end);
        }
    }
    return collectTypeName(tokens, start, end);
}

def declaredValueType(tokens: String, declStart: Int, declEnd: Int): String {
    var cursor: Int = declStart;
    while (cursor < declEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindOperator(), ":")) {
            return typeSummary(tokens, cursor + 1, declEnd);
        }
        if (tokenIs(tokens, cursor, kindOperator(), "=") or tokenIs(tokens, cursor, kindOperator(), ";")) {
            return "infer";
        }
        cursor = cursor + 1;
    }
    return "infer";
}

def lookupFunctionReturnType(tokens: String, name: String): String {
    var cursor: Int = skipTrivia(tokens, 0);
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val kind: String = topLevelDeclKind(tokens, cursor);
        if ((strEq(kind, "function") or strEq(kind, "external-function")) and
            strEq(topLevelDeclName(tokens, cursor), name)) {
            return functionReturnType(tokens, cursor);
        }
        cursor = skipTrivia(tokens, advanceTopLevelDecl(tokens, cursor));
    }
    return "unknown";
}

def inferExpressionType(tokens: String, rawStart: Int, rawEnd: Int): String {
    val start: Int = skipTrivia(tokens, rawStart);
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "Unit";
    }
    val kind: Char = tokenKindAt(tokens, start);
    if (kind == kindInteger()) { return "Int"; }
    if (kind == kindFloat()) { return "Double"; }
    if (kind == kindString()) { return "String"; }
    if (kind == kindRegex()) { return "Regex"; }
    if (kind == kindChar()) { return "Char"; }
    if (kind == kindBool()) { return "Boolean"; }
    val lambda: String = summarizeLambdaExpression(tokens, start, end);
    if (lambda.length > 0) { return "Function"; }
    val matchAt: Int = findTopLevelMatch(tokens, start, end);
    if (matchAt > start) { return "unknown"; }
    var op: Int = findTopLevelOperator(tokens, start, end, 4);
    if (op >= start) { return "Boolean"; }
    op = findTopLevelOperator(tokens, start, end, 2);
    if (op >= start) { return "Boolean"; }
    op = findTopLevelOperator(tokens, start, end, 3);
    if (op >= start) { return "Boolean"; }
    op = findTopLevelOperator(tokens, start, end, 8);
    if (op >= start) { return inferExpressionType(tokens, start, op); }
    op = findTopLevelOperator(tokens, start, end, 9);
    if (op >= start) { return inferExpressionType(tokens, start, op); }
    op = findTopLevelOperator(tokens, start, end, 10);
    if (op >= start) { return inferExpressionType(tokens, start, op); }
    op = findTopLevelOperator(tokens, start, end, 5);
    if (op >= start) { return "Range"; }
    op = findTopLevelOperator(tokens, start, end, 6);
    if (op >= start) { return inferExpressionType(tokens, start, op); }
    op = findTopLevelOperator(tokens, start, end, 7);
    if (op >= start) { return inferExpressionType(tokens, start, op); }
    op = findTopLevelOperator(tokens, start, end, 11);
    if (op >= start) { return inferExpressionType(tokens, start, op); }
    if (tokenKindAt(tokens, start) == kindKeyword() and strEq(tokenTextAt(tokens, start), "new")) {
        return collectTypeName(tokens, start + 1, end);
    }
    if (tokenIs(tokens, start, kindOperator(), "[")) {
        return "Array";
    }
    val postfix: String = summarizePostfixExpression(tokens, start, end);
    if (postfix.startsWith("Expr call")) {
        return lookupFunctionReturnType(tokens, tokenTextAt(tokens, start));
    }
    if (postfix.startsWith("Expr index")) {
        return "unknown";
    }
    if (postfix.startsWith("Expr member")) {
        return "unknown";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier()) {
        return "unknown";
    }
    return "unknown";
}

def declaredLocalType(tokens: String, start: Int, end: Int): String {
    var cursor: Int = start;
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindOperator(), ":")) {
            return typeSummary(tokens, cursor + 1, end);
        }
        if (tokenIs(tokens, cursor, kindOperator(), "=") or tokenIs(tokens, cursor, kindOperator(), ";")) {
            return "";
        }
        cursor = cursor + 1;
    }
    return "";
}

def localDeclarationType(tokens: String, start: Int, end: Int): String {
    val explicitType: String = declaredLocalType(tokens, start, end);
    if (explicitType.length > 0) {
        return explicitType;
    }
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    if (initializer >= start) {
        return inferExpressionType(tokens, initializer + 1, end);
    }
    return "unknown";
}

def generateFunctionScopeSymbols(tokens: String, functionName: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "value") or strEq(kind, "variable")) {
            output = output + "  Local " + functionName + "." + tokenTextAt(tokens, cursor + 1) +
                " mut=" + kind + " type=" + localDeclarationType(tokens, cursor, next) + "\n";
        }
        else if (strEq(kind, "if") or strEq(kind, "while") or strEq(kind, "for") or
            strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
            strEq(kind, "preduce") or strEq(kind, "filter")) {
            output = output + "  Block " + functionName + "." + kind +
                " header=" + statementHeaderExpression(tokens, cursor, next) + "\n";
        }
        else {
            val assignment: Int = findTopLevelOperator(tokens, cursor, next, 1);
            if (assignment > cursor and tokenKindAt(tokens, cursor) == kindIdentifier()) {
                output = output + "  Assign " + functionName + "." + tokenTextAt(tokens, cursor) +
                    " op=" + tokenTextAt(tokens, assignment) + " type=" +
                    inferExpressionType(tokens, assignment + 1, next) + "\n";
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateFunctionParamSymbols(tokens: String, functionName: String, declStart: Int): String {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return "";
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, declStart), "(", ")");
    var cursor: Int = paramStart + 1;
    var output: String = "";
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            var typeName: String = "unknown";
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                typeName = collectTypeName(tokens, cursor + 2, paramEnd);
            }
            output = output + "  Param " + functionName + "." + tokenTextAt(tokens, cursor) +
                " type=" + typeName + "\n";
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        if (tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
    }
    return output;
}

def classMemberStart(tokens: String, ordinal: Int): Int {
    if (tokenIs(tokens, ordinal, kindKeyword(), "override") or
        tokenIs(tokens, ordinal, kindKeyword(), "unsafe") or
        tokenIs(tokens, ordinal, kindKeyword(), "constexpr")) {
        return ordinal + 1;
    }
    return ordinal;
}

def classMemberKind(tokens: String, ordinal: Int): String {
    val start: Int = classMemberStart(tokens, ordinal);
    if (tokenIs(tokens, start, kindKeyword(), "def")) {
        return "method";
    }
    if (tokenIs(tokens, start, kindKeyword(), "val")) {
        return "field";
    }
    if (tokenIs(tokens, start, kindKeyword(), "var")) {
        return "mutable-field";
    }
    return "member";
}

def classMemberName(tokens: String, ordinal: Int): String {
    val start: Int = classMemberStart(tokens, ordinal);
    if (tokenIs(tokens, start, kindKeyword(), "def")) {
        if (tokenIs(tokens, start + 1, kindKeyword(), "operator")) {
            return "operator" + tokenTextAt(tokens, start + 2);
        }
        return tokenTextAt(tokens, start + 1);
    }
    if (tokenIs(tokens, start, kindKeyword(), "val") or tokenIs(tokens, start, kindKeyword(), "var")) {
        return tokenTextAt(tokens, start + 1);
    }
    return "<member>";
}

def generateClassMemberSymbols(tokens: String, className: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val memberStart: Int = classMemberStart(tokens, cursor);
        val kind: String = classMemberKind(tokens, cursor);
        val name: String = classMemberName(tokens, cursor);
        if (strEq(kind, "method")) {
            output = output + "  Method " + className + "." + name +
                " params=" + countFunctionParams(tokens, memberStart) +
                " returns=" + functionReturnType(tokens, memberStart) + "\n";
        }
        else if (strEq(kind, "field") or strEq(kind, "mutable-field")) {
            output = output + "  Field " + className + "." + name +
                " mut=" + kind + " type=" + declaredValueType(tokens, memberStart, next) + "\n";
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateClassMemberAST(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        output = output + "  Member " + classMemberKind(tokens, cursor) + " " +
            classMemberName(tokens, cursor) + "\n";
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def templateParameterSummary(tokens: String, ordinal: Int): String {
    if (!tokenIs(tokens, ordinal, kindKeyword(), "template")) {
        return "";
    }
    val open: Int = findTokenTextInRange(tokens, ordinal, advanceTopLevelDecl(tokens, ordinal), "<");
    if (open < 0) {
        return "";
    }
    var cursor: Int = open + 1;
    var output: String = "";
    while (tokenKindAt(tokens, cursor) != kindEof() and !tokenIs(tokens, cursor, kindOperator(), ">")) {
        if (tokenIs(tokens, cursor, kindKeyword(), "typename") or tokenIs(tokens, cursor, kindKeyword(), "class")) {
            output = output + " type " + tokenTextAt(tokens, cursor + 1);
            cursor = cursor + 2;
        }
        else if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            output = output + " value " + tokenTextAt(tokens, cursor);
            cursor = cursor + 1;
        }
        else {
            cursor = cursor + 1;
        }
    }
    return output;
}

def templateTargetKind(tokens: String, ordinal: Int): String {
    if (!tokenIs(tokens, ordinal, kindKeyword(), "template")) {
        return "";
    }
    var cursor: Int = ordinal + 1;
    var depth: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val text: String = tokenTextAt(tokens, cursor);
        if (strEq(text, "<")) {
            depth = depth + 1;
        }
        else if (strEq(text, ">")) {
            depth = depth - 1;
            if (depth == 0) {
                val target: String = tokenTextAt(tokens, cursor + 1);
                if (strEq(target, "def")) { return "function"; }
                if (strEq(target, "class")) { return "class"; }
                return target;
            }
        }
        cursor = cursor + 1;
    }
    return "";
}

def attributeSummary(tokens: String, ordinal: Int): String {
    if (!tokenIs(tokens, ordinal, kindOperator(), "[@")) {
        return "";
    }
    var cursor: Int = ordinal + 1;
    var output: String = "";
    while (tokenKindAt(tokens, cursor) != kindEof() and !tokenIs(tokens, cursor, kindOperator(), "]")) {
        if (output.length > 0) {
            output = output + " ";
        }
        output = output + tokenTextAt(tokens, cursor);
        cursor = cursor + 1;
    }
    return output;
}

def externalSymbolKind(tokens: String, ordinal: Int): String {
    val kind: String = topLevelDeclKind(tokens, ordinal);
    if (strEq(kind, "external-function")) { return "function"; }
    if (strEq(kind, "external-class")) { return "class"; }
    if (strEq(kind, "external-object")) { return "object"; }
    return kind;
}

def generateSymbolTable(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "error: parse failed\n";
    }
    var output: String = "Symbols\n";
    var cursor: Int = skipTrivia(tokens, 0);
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val kind: String = topLevelDeclKind(tokens, cursor);
        val name: String = topLevelDeclName(tokens, cursor);
        val declEnd: Int = advanceTopLevelDecl(tokens, cursor);
        if (strEq(kind, "function") or strEq(kind, "external-function")) {
            output = output + "Symbol function " + name + " params=" +
                countFunctionParams(tokens, cursor) + " returns=" +
                functionReturnType(tokens, cursor) + "\n";
            if (strEq(kind, "external-function")) {
                output = output + "  External function " + name + "\n";
            }
            output = output + generateFunctionParamSymbols(tokens, name, cursor);
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                output = output + generateFunctionScopeSymbols(tokens, name, bodyStart, bodyEnd);
            }
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            output = output + "Symbol " + kind + " " + name + " type=" +
                declaredValueType(tokens, cursor, declEnd) + "\n";
        }
        else if (strEq(kind, "template")) {
            output = output + "Symbol template " + name + " target=" +
                templateTargetKind(tokens, cursor) + " params=" +
                templateParameterSummary(tokens, cursor) + "\n";
        }
        else if (strEq(kind, "attribute")) {
            output = output + "Symbol attribute " + attributeSummary(tokens, cursor) + "\n";
        }
        else if (strEq(kind, "external") or strEq(kind, "external-function") or
            strEq(kind, "external-class") or strEq(kind, "external-object")) {
            output = output + "Symbol external " + externalSymbolKind(tokens, cursor) +
                " " + name + "\n";
        }
        else if (strEq(kind, "class") or strEq(kind, "object") or strEq(kind, "external-class") or
            strEq(kind, "external-object")) {
            output = output + "Symbol type " + name + " kind=" + kind + "\n";
            if (strEq(kind, "external-class") or strEq(kind, "external-object")) {
                output = output + "  External " + externalSymbolKind(tokens, cursor) + " " + name + "\n";
            }
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                output = output + generateClassMemberSymbols(tokens, name, bodyStart, bodyEnd);
            }
        }
        else if (strEq(kind, "import")) {
            output = output + "Symbol import " + name + "\n";
        }
        cursor = skipTrivia(tokens, declEnd);
    }
    return output;
}

def generateAST(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "error: parse failed\n";
    }
    var output: String = "Program\n";
    var cursor: Int = skipTrivia(tokens, 0);
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val kind: String = topLevelDeclKind(tokens, cursor);
        val name: String = topLevelDeclName(tokens, cursor);
        output = output + "Decl " + kind + " " + name + "\n";
        if (strEq(kind, "attribute")) {
            output = output + "Attribute " + attributeSummary(tokens, cursor) + "\n";
        }
        if (strEq(kind, "template")) {
            output = output + "Template target " + templateTargetKind(tokens, cursor) +
                " params" + templateParameterSummary(tokens, cursor) + "\n";
        }
        if (strEq(kind, "function") or strEq(kind, "external-function") or strEq(kind, "template")) {
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                output = output + generateBodyAST(tokens, bodyStart, bodyEnd);
            }
        }
        else if (strEq(kind, "class") or strEq(kind, "object") or strEq(kind, "external-class") or
            strEq(kind, "external-object")) {
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                output = output + generateClassMemberAST(tokens, bodyStart, bodyEnd);
            }
        }
        cursor = skipTrivia(tokens, advanceTopLevelDecl(tokens, cursor));
    }
    return output;
}

// ---- selfhost/src/ir_generator.csec ----
def parseReturnIntegerInRange(tokens: String, start: Int, end: Int): Int {
    var cursor: Int = start;
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "return") and
            tokenKindAt(tokens, cursor + 1) == kindInteger()) {
            return toInt(tokenTextAt(tokens, cursor + 1));
        }
        cursor = cursor + 1;
    }
    return 0;
}

def appendCExpression(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    var cursor: Int = start;
    var output: String = "";
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        val text: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindKeyword() and strEq(text, "and")) {
            output = output + "&&";
        }
        else if (tokenKindAt(tokens, cursor) == kindKeyword() and strEq(text, "or")) {
            output = output + "||";
        }
        else if (tokenKindAt(tokens, cursor) == kindKeyword() and strEq(text, "xor")) {
            output = output + "^";
        }
        else {
            output = output + text;
        }
        if (cursor + 1 < end) {
            output = output + " ";
        }
        cursor = cursor + 1;
    }
    return output;
}

def cTypeName(typeName: String): String {
    if (strEq(typeName, "Boolean")) { return "int"; }
    if (strEq(typeName, "Char")) { return "char"; }
    if (strEq(typeName, "Int")) { return "int"; }
    if (strEq(typeName, "Long")) { return "long long"; }
    if (strEq(typeName, "Float")) { return "float"; }
    if (strEq(typeName, "Double")) { return "double"; }
    if (strEq(typeName, "String")) { return "const char*"; }
    if (strEq(typeName, "Regex")) { return "const char*"; }
    if (typeName.startsWith("Array")) { return "void*"; }
    if (strEq(typeName, "Unit")) { return "void"; }
    return "void*";
}

def generateCBody(tokens: String, bodyStart: Int, bodyEnd: Int, indent: String): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            output = output + indent + "return " + appendCExpression(tokens, cursor + 1, next) + ";\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            val initializer: Int = findTopLevelOperator(tokens, cursor, next, 1);
            var typeName: String = declaredLocalType(tokens, cursor, next);
            if (initializer >= cursor) {
                if (typeName.length == 0) {
                    typeName = inferExpressionType(tokens, initializer + 1, next);
                }
                output = output + indent + cTypeName(typeName) + " " + tokenTextAt(tokens, cursor + 1) + " = " +
                    appendCExpression(tokens, initializer + 1, next) + ";\n";
            }
            else {
                if (typeName.length == 0) {
                    typeName = "Int";
                }
                output = output + indent + cTypeName(typeName) + " " + tokenTextAt(tokens, cursor + 1) + " = 0;\n";
            }
        }
        else if (strEq(kind, "if") or strEq(kind, "while")) {
            val openParen: Int = findTokenTextInRange(tokens, cursor, next, "(");
            val closeParen: Int = findClosingToken(tokens, openParen, next, "(", ")");
            val openBrace: Int = findTokenTextInRange(tokens, closeParen + 1, next, "{");
            val closeBrace: Int = findClosingToken(tokens, openBrace, next, "{", "}");
            if (openParen >= cursor and closeParen > openParen and openBrace > closeParen and closeBrace > openBrace) {
                output = output + indent + kind + " (" + appendCExpression(tokens, openParen + 1, closeParen) + ") {\n" +
                    generateCBody(tokens, openBrace + 1, closeBrace, indent + "    ") +
                    indent + "}\n";
                if (strEq(kind, "if")) {
                    val possibleElse: Int = skipTrivia(tokens, closeBrace + 1);
                    if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                        val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                        if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                            val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                            if (elseEnd > elseStart) {
                                output = output + indent + "else {\n" +
                                    generateCBody(tokens, elseStart + 1, elseEnd, indent + "    ") +
                                    indent + "}\n";
                            }
                        }
                    }
                }
            }
        }
        else if (strEq(kind, "for")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val blockStart: Int = findStatementBlockStart(tokens, cursor, next);
            val blockEnd: Int = findStatementBlockEnd(tokens, cursor, next);
            val sourceArrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
            val rangeOp: Int = findTopLevelOperator(tokens, sourceArrow + 1, closeParen, 5);
            if (openParen >= cursor and closeParen > openParen and blockStart > closeParen and
                blockEnd > blockStart and tokenKindAt(tokens, openParen + 1) == kindIdentifier() and
                sourceArrow > openParen and rangeOp > sourceArrow) {
                var compareOp: String = " < ";
                if (strEq(tokenTextAt(tokens, rangeOp), "to") or strEq(tokenTextAt(tokens, rangeOp), "..")) {
                    compareOp = " <= ";
                }
                val iteratorName: String = tokenTextAt(tokens, openParen + 1);
                output = output + indent + "for (int " + iteratorName + " = " +
                    appendCExpression(tokens, sourceArrow + 1, rangeOp) + "; " +
                    iteratorName + compareOp + appendCExpression(tokens, rangeOp + 1, closeParen) +
                    "; " + iteratorName + "++) {\n" +
                    generateCBody(tokens, blockStart + 1, blockEnd, indent + "    ") +
                    indent + "}\n";
            }
            else {
                output = output + indent + "/* for (" + statementHeaderExpression(tokens, cursor, next) + ") */\n";
                if (blockStart >= 0 and blockEnd > blockStart) {
                    output = output + generateCBody(tokens, blockStart + 1, blockEnd, indent);
                }
            }
        }
        else if (strEq(kind, "map") or strEq(kind, "pmap") or
            strEq(kind, "reduce") or strEq(kind, "preduce") or strEq(kind, "filter")) {
            val blockStart: Int = findStatementBlockStart(tokens, cursor, next);
            val blockEnd: Int = findStatementBlockEnd(tokens, cursor, next);
            output = output + indent + "/* " + kind + " (" + statementHeaderExpression(tokens, cursor, next) + ") */\n";
            if (blockStart >= 0 and blockEnd > blockStart) {
                output = output + generateCBody(tokens, blockStart + 1, blockEnd, indent);
            }
        }
        else {
            output = output + indent + appendCExpression(tokens, cursor, next) + ";\n";
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateCStatement(tokens: String, start: Int, end: Int, indent: String): String {
    val kind: String = statementKind(tokens, start);
    if (strEq(kind, "return")) {
        return indent + "return " + appendCExpression(tokens, start + 1, end) + ";\n";
    }
    if (strEq(kind, "value") or strEq(kind, "variable")) {
        val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
        var typeName: String = declaredLocalType(tokens, start, end);
        if (initializer >= start) {
            if (typeName.length == 0) {
                typeName = inferExpressionType(tokens, initializer + 1, end);
            }
            return indent + cTypeName(typeName) + " " + tokenTextAt(tokens, start + 1) + " = " +
                appendCExpression(tokens, initializer + 1, end) + ";\n";
        }
        if (typeName.length == 0) {
            typeName = "Int";
        }
        return indent + cTypeName(typeName) + " " + tokenTextAt(tokens, start + 1) + " = 0;\n";
    }
    if (strEq(kind, "if") or strEq(kind, "while") or strEq(kind, "for") or
        strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
        strEq(kind, "preduce") or strEq(kind, "filter")) {
        return indent + "/* unsupported nested block */\n";
    }
    return indent + appendCExpression(tokens, start, end) + ";\n";
}

def parseMainReturnInt(tokens: String): Int {
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def") and
            tokenIs(tokens, cursor + 1, kindIdentifier(), "main") and
            tokenIs(tokens, cursor + 2, kindOperator(), "(") and
            tokenIs(tokens, cursor + 3, kindOperator(), ")") and
            tokenIs(tokens, cursor + 4, kindOperator(), ":") and
            strEq(tokenTextAt(tokens, cursor + 5), "Int") and
            tokenIs(tokens, cursor + 6, kindOperator(), "{") and
            tokenKindAt(tokens, cursor + 7) != kindEof()) {
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                return parseReturnIntegerInRange(tokens, bodyStart, bodyEnd);
            }
        }
        cursor = cursor + 1;
    }
    return 0;
}

def generateMainExecutionC(tokens: String): String {
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def") and
            tokenIs(tokens, cursor + 1, kindIdentifier(), "main") and
            tokenIs(tokens, cursor + 2, kindOperator(), "(") and
            tokenIs(tokens, cursor + 3, kindOperator(), ")") and
            tokenIs(tokens, cursor + 4, kindOperator(), ":") and
            strEq(tokenTextAt(tokens, cursor + 5), "Int")) {
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                return "int main(int argc, char** argv) {\n" +
                    "    (void)argc;\n" +
                    "    (void)argv;\n" +
                    generateCBody(tokens, bodyStart, bodyEnd, "    ") +
                    "    return 0;\n" +
                    "}\n";
            }
        }
        cursor = cursor + 1;
    }
    return "";
}

def irTypeName(typeName: String): String {
    if (strEq(typeName, "Boolean")) { return "i1"; }
    if (strEq(typeName, "Char")) { return "i8"; }
    if (strEq(typeName, "Int")) { return "i32"; }
    if (strEq(typeName, "Long")) { return "i64"; }
    if (strEq(typeName, "Float")) { return "float"; }
    if (strEq(typeName, "Double")) { return "double"; }
    if (strEq(typeName, "Unit")) { return "void"; }
    if (strEq(typeName, "String")) { return "ptr"; }
    if (strEq(typeName, "Regex")) { return "ptr"; }
    if (strEq(typeName, "Range")) { return "ptr"; }
    if (typeName.startsWith("Array")) { return "ptr"; }
    if (typeName.length == 0) { return "ptr"; }
    return "ptr";
}

def irOperatorName(text: String): String {
    if (strEq(text, "+")) { return "add"; }
    if (strEq(text, "-")) { return "sub"; }
    if (strEq(text, "*")) { return "mul"; }
    if (strEq(text, "/")) { return "sdiv"; }
    if (strEq(text, "%")) { return "srem"; }
    if (strEq(text, "<<")) { return "shl"; }
    if (strEq(text, ">>")) { return "ashr"; }
    if (strEq(text, "&")) { return "and"; }
    if (strEq(text, "|")) { return "or"; }
    if (strEq(text, "^") or strEq(text, "xor")) { return "xor"; }
    if (strEq(text, "and") or strEq(text, "&&")) { return "and"; }
    if (strEq(text, "or") or strEq(text, "||")) { return "or"; }
    if (strEq(text, "==")) { return "icmp_eq"; }
    if (strEq(text, "!=")) { return "icmp_ne"; }
    if (strEq(text, "<")) { return "icmp_slt"; }
    if (strEq(text, "<=")) { return "icmp_sle"; }
    if (strEq(text, ">")) { return "icmp_sgt"; }
    if (strEq(text, ">=")) { return "icmp_sge"; }
    if (strEq(text, "..")) { return "range"; }
    if (strEq(text, "to")) { return "range_to"; }
    if (strEq(text, "until")) { return "range_until"; }
    if (strEq(text, "@")) { return "matmul"; }
    if (strEq(text, "inner")) { return "inner"; }
    if (strEq(text, "outer")) { return "outer"; }
    if (strEq(text, "tensor")) { return "tensor"; }
    return text;
}

def expressionTopLevelOperator(tokens: String, start: Int, end: Int): Int {
    var op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 2);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 3);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 8);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 9);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 4);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 10);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 5);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 6);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 7);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 11);
    if (op >= start) { return op; }
    return -1;
}

def generateIRExpression(tokens: String, rawStart: Int, rawEnd: Int): String {
    val start: Int = skipTrivia(tokens, rawStart);
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "void";
    }
    val typeName: String = inferExpressionType(tokens, start, end);
    val irType: String = irTypeName(typeName);
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start) {
        return irOperatorName(tokenTextAt(tokens, op)) + " " + irType + " (" +
            appendExpressionUntil(tokens, start, op) + "), (" +
            appendExpressionUntil(tokens, op + 1, end) + ")";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and
        start + 1 < end and tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return "call " + irType + " @" + tokenTextAt(tokens, start) + "(" +
            appendExpressionUntil(tokens, start + 2, end - 1) + ")";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "load " + irType + ", ptr %" + tokenTextAt(tokens, start);
    }
    return irType + " " + appendExpressionUntil(tokens, start, end);
}

def generateIRAssignment(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val opText: String = tokenTextAt(tokens, op);
    val rhs: String = generateIRExpression(tokens, op + 1, end);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        return "    store " + rhs + ", ptr %" + name + "\n";
    }
    val typeName: String = inferExpressionType(tokens, op + 1, end);
    val irType: String = irTypeName(typeName);
    var binaryOp: String = opText.substring(0, 1);
    if (strEq(opText, "%=")) {
        binaryOp = "%";
    }
    return "    %old." + name + " = load " + irType + ", ptr %" + name + "\n" +
        "    %new." + name + " = " + irOperatorName(binaryOp) + " " + irType +
        " %old." + name + ", (" + appendExpressionUntil(tokens, op + 1, trimExpressionEnd(tokens, op + 1, end)) + ")\n" +
        "    store " + irType + " %new." + name + ", ptr %" + name + "\n";
}

def generateIRParamList(tokens: String, declStart: Int): String {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return "";
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, declStart), "(", ")");
    var cursor: Int = paramStart + 1;
    var output: String = "";
    var first: Boolean = true;
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            var typeName: String = "unknown";
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                typeName = collectTypeName(tokens, cursor + 2, paramEnd);
            }
            if (!first) {
                output = output + ", ";
            }
            output = output + irTypeName(typeName) + " %" + tokenTextAt(tokens, cursor);
            first = false;
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        if (tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
    }
    return output;
}

def generateIRFlatBody(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            output = output + "    ret " + generateIRExpression(tokens, cursor + 1, next) + "\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            val initializer: Int = findTopLevelOperator(tokens, cursor, next, 1);
            if (initializer >= cursor) {
                val localType: String = inferExpressionType(tokens, initializer + 1, next);
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca " +
                    irTypeName(localType) + "\n" +
                    "    store " + generateIRExpression(tokens, initializer + 1, next) +
                    ", ptr %" + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            else {
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca ptr\n";
            }
        }
        else if (strEq(kind, "if") or strEq(kind, "while") or strEq(kind, "for") or
            strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
            strEq(kind, "preduce") or strEq(kind, "filter")) {
            output = output + "    ; nested block " + kind + " (" +
                statementHeaderExpression(tokens, cursor, next) + ")\n";
        }
        else {
            val assignmentIR: String = generateIRAssignment(tokens, cursor, next);
            if (assignmentIR.length > 0) {
                output = output + assignmentIR;
            }
            else {
                output = output + "    " + generateIRExpression(tokens, cursor, next) + "\n";
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateIRElseFlatBody(tokens: String, possibleElse: Int, end: Int, hasElse: Boolean): String {
    if (!hasElse) {
        return "    ; no else body\n";
    }
    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
    if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
        val elseEnd: Int = findClosingToken(tokens, elseStart, end, "{", "}");
        if (elseEnd > elseStart) {
            return generateIRFlatBody(tokens, elseStart + 1, elseEnd);
        }
    }
    if (tokenIs(tokens, elseStart, kindKeyword(), "if")) {
        return "    ; else-if body\n";
    }
    return "    ; malformed else body\n";
}

def generateIRIf(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val thenStart: Int = findStatementBlockStart(tokens, start, end);
    val thenEnd: Int = findClosingToken(tokens, thenStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
        return "    ; malformed if\n";
    }
    val labelSeed: String = "" + start;
    val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
    var hasElse: Boolean = false;
    if (possibleElse < end and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
        hasElse = true;
    }
    return "    %cond." + labelSeed + " = " +
        generateIRExpression(tokens, openParen + 1, closeParen) + "\n" +
        "    br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
        ", label %if.else." + labelSeed + "\n" +
        "if.then." + labelSeed + ":\n" +
        generateIRFlatBody(tokens, thenStart + 1, thenEnd) +
        "    br label %if.end." + labelSeed + "\n" +
        "if.else." + labelSeed + ":\n" +
        generateIRElseFlatBody(tokens, possibleElse, end, hasElse) +
        "    br label %if.end." + labelSeed + "\n" +
        "if.end." + labelSeed + ":\n";
}

def generateIRWhile(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "    ; malformed while\n";
    }
    val labelSeed: String = "" + start;
    return "    br label %while.cond." + labelSeed + "\n" +
        "while.cond." + labelSeed + ":\n" +
        "    %whilecond." + labelSeed + " = " +
        generateIRExpression(tokens, openParen + 1, closeParen) + "\n" +
        "    br i1 %whilecond." + labelSeed + ", label %while.body." + labelSeed +
        ", label %while.end." + labelSeed + "\n" +
        "while.body." + labelSeed + ":\n" +
        generateIRFlatBody(tokens, bodyStart + 1, bodyEnd) +
        "    br label %while.cond." + labelSeed + "\n" +
        "while.end." + labelSeed + ":\n";
}

def generateIRFor(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "    ; malformed for\n";
    }
    val iteratorName: String = tokenTextAt(tokens, openParen + 1);
    val arrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
    if (arrow < 0) {
        return "    ; malformed for source\n";
    }
    val labelSeed: String = "" + start;
    return "    ; for source " + generateIRExpression(tokens, arrow + 1, closeParen) + "\n" +
        "    %" + iteratorName + " = alloca ptr\n" +
        "    br label %for.cond." + labelSeed + "\n" +
        "for.cond." + labelSeed + ":\n" +
        "    ; iterator next " + iteratorName + "\n" +
        "    br i1 %for.hasnext." + labelSeed + ", label %for.body." + labelSeed +
        ", label %for.end." + labelSeed + "\n" +
        "for.body." + labelSeed + ":\n" +
        generateIRFlatBody(tokens, bodyStart + 1, bodyEnd) +
        "    br label %for.cond." + labelSeed + "\n" +
        "for.end." + labelSeed + ":\n";
}

def generateIRBody(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            output = output + "    ret " + generateIRExpression(tokens, cursor + 1, next) + "\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            val initializer: Int = findTopLevelOperator(tokens, cursor, next, 1);
            if (initializer >= cursor) {
                val localType: String = inferExpressionType(tokens, initializer + 1, next);
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca " +
                    irTypeName(localType) + "\n" +
                    "    store " + generateIRExpression(tokens, initializer + 1, next) +
                    ", ptr %" + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            else {
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca ptr\n";
            }
        }
        else if (strEq(kind, "if")) {
            output = output + generateIRIf(tokens, cursor, next);
        }
        else if (strEq(kind, "while")) {
            output = output + generateIRWhile(tokens, cursor, next);
        }
        else if (strEq(kind, "for")) {
            output = output + generateIRFor(tokens, cursor, next);
        }
        else if (strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
            strEq(kind, "preduce") or strEq(kind, "filter")) {
            output = output + "    ; block " + kind + " (" + statementHeaderExpression(tokens, cursor, next) + ")\n";
        }
        else {
            val assignmentIR: String = generateIRAssignment(tokens, cursor, next);
            if (assignmentIR.length > 0) {
                output = output + assignmentIR;
            }
            else {
                output = output + "    " + generateIRExpression(tokens, cursor, next) + "\n";
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateIRDeclarations(tokens: String): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, 0);
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val kind: String = topLevelDeclKind(tokens, cursor);
        val name: String = topLevelDeclName(tokens, cursor);
        if (strEq(kind, "function") or strEq(kind, "external-function")) {
            output = output + "define " + irTypeName(functionReturnType(tokens, cursor)) +
                " @" + name + "(" + generateIRParamList(tokens, cursor) + ")\n";
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                output = output + generateIRBody(tokens, bodyStart, bodyEnd);
            }
            output = output + "end define\n";
        }
        else if (strEq(kind, "class") or strEq(kind, "object") or strEq(kind, "external-class") or
            strEq(kind, "external-object")) {
            output = output + "%type." + name + " = type opaque ; " + kind + "\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            output = output + "@" + name + " = global ptr null ; " + kind + "\n";
        }
        cursor = skipTrivia(tokens, advanceTopLevelDecl(tokens, cursor));
    }
    return output;
}

def generateIR(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "error: parse failed\n";
    }
    val returnValue: Int = parseMainReturnInt(tokens);
    return "module csec.selfhost\n" +
        generateSymbolTable(tokens) +
        "entry main\n" +
        "lowering llvm-text\n" +
        generateIRDeclarations(tokens) +
        "main.return " + returnValue + "\n";
}

def generateLLVMMainBody(tokens: String): String {
    val returnValue: Int = parseMainReturnInt(tokens);
    return "entry:\n" +
        "  ret i32 " + returnValue + "\n";
}

def llvmCharI8Value(text: String): String {
    if (text.length == 0) { return "0"; }
    val ch: Char = text.charAt(0);
    if (ch == 'I') { return "73"; }
    if (ch == 'K') { return "75"; }
    if (ch == 'N') { return "78"; }
    if (ch == 'F') { return "70"; }
    if (ch == 'S') { return "83"; }
    if (ch == 'R') { return "82"; }
    if (ch == 'C') { return "67"; }
    if (ch == 'B') { return "66"; }
    if (ch == 'O') { return "79"; }
    if (ch == 'M') { return "77"; }
    if (ch == 'E') { return "69"; }
    if (ch == 'x') { return "120"; }
    if (ch == 'y') { return "121"; }
    if (ch == 'z') { return "122"; }
    if (ch == 'a') { return "97"; }
    if (ch == 't') { return "116"; }
    if (ch == 'u') { return "117"; }
    if (ch == '0') { return "48"; }
    if (ch == '1') { return "49"; }
    if (ch == '2') { return "50"; }
    if (ch == '3') { return "51"; }
    if (ch == '4') { return "52"; }
    if (ch == '5') { return "53"; }
    if (ch == '6') { return "54"; }
    if (ch == '7') { return "55"; }
    if (ch == '8') { return "56"; }
    if (ch == '9') { return "57"; }
    if (ch == '_') { return "95"; }
    if (ch == ' ') { return "32"; }
    if (ch == '"') { return "34"; }
    if (ch == '\\' and text.length > 1 and text.charAt(1) == '\\') { return "92"; }
    if (ch == '\\' and text.length > 1 and text.charAt(1) == 'n') { return "10"; }
    if (ch == '\\' and text.length > 1 and text.charAt(1) == 't') { return "9"; }
    return "0";
}

def llvmI32Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return llvmCharI8Value(tokenTextAt(tokens, start));
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".val." + start;
    }
    return "%tmp";
}

def lookupFunctionParamType(tokens: String, limit: Int, name: String): String {
    var decl: Int = 0;
    while (tokenKindAt(tokens, decl) != kindEof()) {
        if (tokenIs(tokens, decl, kindKeyword(), "def")) {
            val bodyStart: Int = findDeclBodyStart(tokens, decl);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd > bodyStart and limit > bodyStart and limit < bodyEnd) {
                val paramStart: Int = findFunctionParamStart(tokens, decl);
                if (paramStart < 0) {
                    return "unknown";
                }
                val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, decl), "(", ")");
                if (paramEnd <= paramStart) {
                    return "unknown";
                }
                var cursor: Int = paramStart + 1;
                while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
                    if (tokenKindAt(tokens, cursor) == kindIdentifier() and strEq(tokenTextAt(tokens, cursor), name)) {
                        if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                            return typeSummary(tokens, cursor + 2, paramEnd);
                        }
                        return "unknown";
                    }
                    while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
                        cursor = cursor + 1;
                    }
                    cursor = cursor + 1;
                }
            }
        }
        decl = skipTrivia(tokens, advanceTopLevelDecl(tokens, decl));
        if (decl < 0) {
            return "unknown";
        }
    }
    return "unknown";
}

def lookupVisibleValueType(tokens: String, limit: Int, name: String): String {
    val paramType: String = lookupFunctionParamType(tokens, limit, name);
    if (!strEq(paramType, "unknown")) {
        return paramType;
    }
    var cursor: Int = 0;
    var found: String = "";
    while (cursor < limit and tokenKindAt(tokens, cursor) != kindEof()) {
        if ((tokenIs(tokens, cursor, kindKeyword(), "val") or
            tokenIs(tokens, cursor, kindKeyword(), "var")) and
            tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
            strEq(tokenTextAt(tokens, cursor + 1), name)) {
            val next: Int = advanceStatement(tokens, cursor, limit);
            if (next > cursor) {
                found = localDeclarationType(tokens, cursor, next);
                cursor = next;
            }
            else {
                cursor = cursor + 1;
            }
        }
        else {
            cursor = cursor + 1;
        }
    }
    if (found.length == 0) {
        return "unknown";
    }
    return found;
}

def llvmLoadForValueType(tokens: String, name: String, valueType: String, resultName: String): String {
    if (strEq(valueType, "Boolean")) {
        return "  " + resultName + " = load i1, ptr %" + name + "\n";
    }
    if (strEq(valueType, "Char")) {
        return "  " + resultName + " = load i8, ptr %" + name + "\n";
    }
    if (strEq(valueType, "Double")) {
        return "  " + resultName + " = load double, ptr %" + name + "\n";
    }
    if (strEq(valueType, "Long")) {
        return "  " + resultName + " = load i64, ptr %" + name + "\n";
    }
    if (strEq(irTypeName(valueType), "ptr")) {
        return "  " + resultName + " = load ptr, ptr %" + name + "\n";
    }
    return "  " + resultName + " = load i32, ptr %" + name + "\n";
}

def generateLLVMLoadIfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val valueType: String = lookupVisibleValueType(tokens, start, name);
        if (strEq(valueType, "Char")) {
            return "  %" + name + ".cval." + start + " = load i8, ptr %" + name + "\n" +
                "  %" + name + ".val." + start + " = zext i8 %" + name + ".cval." + start + " to i32\n";
        }
        return "  %" + name + ".val." + start + " = load i32, ptr %" + name + "\n";
    }
    return "";
}

def llvmI1Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "false";
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".bval";
    }
    return "%btmp";
}

def generateLLVMLoadBoolIfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        return "  %" + name + ".bval = load i1, ptr %" + name + "\n";
    }
    return "";
}

def llvmI32CallArgumentValue(tokens: String, start: Int, rawEnd: Int, resultName: String, index: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    return resultName + ".arg" + index;
}

def llvmCallArgumentType(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "i32";
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        return "ptr";
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return "i8";
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        return "i1";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val valueType: String = lookupVisibleValueType(tokens, start, tokenTextAt(tokens, start));
        val llvmType: String = irTypeName(valueType);
        if (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or strEq(llvmType, "i1") or
            strEq(llvmType, "i64") or strEq(llvmType, "double")) {
            return llvmType;
        }
    }
    return "i32";
}

def llvmCallArgumentValue(tokens: String, start: Int, rawEnd: Int, resultName: String, index: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return llvmCharI8Value(tokenTextAt(tokens, start));
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    return resultName + ".arg" + index;
}

def generateLLVMCallArgumentLoadI32(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = add i32 0, 0\n";
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        val text: String = tokenTextAt(tokens, start);
        val byteLength: Int = text.length + 1;
        return "  " + resultName + " = getelementptr inbounds [" + byteLength +
            " x i8], ptr @.str." + start + ", i32 0, i32 0\n";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + llvmCharI8Value(tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val valueType: String = lookupVisibleValueType(tokens, start, name);
        val llvmType: String = irTypeName(valueType);
        if (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or strEq(llvmType, "i1") or
            strEq(llvmType, "i64") or strEq(llvmType, "double")) {
            return "  " + resultName + " = load " + llvmType + ", ptr %" + name + "\n";
        }
        return "  " + resultName + " = load i32, ptr %" + name + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 4 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "charAt") and
        tokenIs(tokens, start + 3, kindOperator(), "(") and
        findClosingToken(tokens, start + 3, end, "(", ")") == end - 1) {
        val name: String = tokenTextAt(tokens, start);
        val indexStart: Int = skipTrivia(tokens, start + 4);
        val indexEnd: Int = trimExpressionEnd(tokens, indexStart, end - 1);
        var output: String = "  " + resultName + ".obj = load ptr, ptr %" + name + "\n";
        if (tokenKindAt(tokens, indexStart) == kindInteger() and indexEnd == indexStart + 1) {
            output = output + "  " + resultName + ".index = add i32 0, " + tokenTextAt(tokens, indexStart) + "\n";
        }
        else if (tokenKindAt(tokens, indexStart) == kindIdentifier() and indexEnd == indexStart + 1) {
            output = output + "  " + resultName + ".index = load i32, ptr %" + tokenTextAt(tokens, indexStart) + "\n";
        }
        else {
            output = output + "  " + resultName + ".index = add i32 0, 0\n";
        }
        return output +
            "  " + resultName + ".i8 = call i8 @csec_string_char_at(ptr " + resultName + ".obj, i32 " + resultName + ".index)\n" +
            "  " + resultName + " = zext i8 " + resultName + ".i8 to i32\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (strEq(mnemonic, "add") or strEq(mnemonic, "sub") or strEq(mnemonic, "mul") or
            strEq(mnemonic, "sdiv") or strEq(mnemonic, "srem") or strEq(mnemonic, "shl") or
            strEq(mnemonic, "ashr") or strEq(mnemonic, "and") or strEq(mnemonic, "or") or
            strEq(mnemonic, "xor")) {
            return generateLLVMCallArgumentLoadI32(tokens, start, op, resultName + ".left") +
                generateLLVMCallArgumentLoadI32(tokens, op + 1, end, resultName + ".right") +
                "  " + resultName + " = " + mnemonic + " i32 " + resultName + ".left, " + resultName + ".right\n";
        }
    }
    return "  " + resultName + " = add i32 0, 0\n";
}

def generateLLVMCallArgumentLoadsI32(tokens: String, argsStart: Int, argsEnd: Int, resultName: String): String {
    var cursor: Int = argsStart;
    var argStart: Int = argsStart;
    var index: Int = 0;
    var paren: Int = 0;
    var bracket: Int = 0;
    var brace: Int = 0;
    var output: String = "";
    while (cursor <= argsEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        var boundary: Boolean = cursor == argsEnd;
        if (!boundary and tokenKindAt(tokens, cursor) == kindOperator()) {
            val text: String = tokenTextAt(tokens, cursor);
            if (strEq(text, "(")) { paren = paren + 1; }
            else if (strEq(text, ")")) { paren = paren - 1; }
            else if (strEq(text, "[")) { bracket = bracket + 1; }
            else if (strEq(text, "]")) { bracket = bracket - 1; }
            else if (strEq(text, "{")) { brace = brace + 1; }
            else if (strEq(text, "}")) { brace = brace - 1; }
            else if (strEq(text, ",") and paren == 0 and bracket == 0 and brace == 0) {
                boundary = true;
            }
        }
        if (boundary) {
            val argEnd: Int = trimExpressionEnd(tokens, argStart, cursor);
            if (argEnd > argStart) {
                if (tokenKindAt(tokens, argStart) == kindInteger() and argEnd == argStart + 1) {
                    output = output;
                }
                else {
                    output = output + generateLLVMCallArgumentLoadI32(tokens, argStart, argEnd, resultName + ".arg" + index);
                }
                index = index + 1;
            }
            argStart = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return output;
}

def generateLLVMCallArgumentListI32(tokens: String, argsStart: Int, argsEnd: Int, resultName: String): String {
    var cursor: Int = argsStart;
    var argStart: Int = argsStart;
    var index: Int = 0;
    var paren: Int = 0;
    var bracket: Int = 0;
    var brace: Int = 0;
    var output: String = "";
    var first: Boolean = true;
    while (cursor <= argsEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        var boundary: Boolean = cursor == argsEnd;
        if (!boundary and tokenKindAt(tokens, cursor) == kindOperator()) {
            val text: String = tokenTextAt(tokens, cursor);
            if (strEq(text, "(")) { paren = paren + 1; }
            else if (strEq(text, ")")) { paren = paren - 1; }
            else if (strEq(text, "[")) { bracket = bracket + 1; }
            else if (strEq(text, "]")) { bracket = bracket - 1; }
            else if (strEq(text, "{")) { brace = brace + 1; }
            else if (strEq(text, "}")) { brace = brace - 1; }
            else if (strEq(text, ",") and paren == 0 and bracket == 0 and brace == 0) {
                boundary = true;
            }
        }
        if (boundary) {
            val argEnd: Int = trimExpressionEnd(tokens, argStart, cursor);
            if (argEnd > argStart) {
                if (!first) {
                    output = output + ", ";
                }
                output = output + llvmCallArgumentType(tokens, argStart, argEnd) + " " +
                    llvmCallArgumentValue(tokens, argStart, argEnd, resultName, index);
                first = false;
                index = index + 1;
            }
            argStart = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return output;
}

def llvmRuntimeCallName(name: String): String {
    if (strEq(name, "commandLineArgCount")) { return "csec_command_line_arg_count"; }
    if (strEq(name, "commandLineArg")) { return "csec_command_line_arg"; }
    return name;
}

def llvmCallReturnsChar(tokens: String, name: String): Boolean {
    if (name.startsWith("kind")) { return true; }
    if (strEq(name, "tokenKindAt")) { return true; }
    if (strEq(name, "csec_token_kind_at")) { return true; }
    if (strEq(lookupFunctionReturnType(tokens, name), "Char")) { return true; }
    return false;
}

def generateLLVMExpressionI32(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = add i32 0, 0\n";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + llvmCharI8Value(tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val valueType: String = lookupVisibleValueType(tokens, start, name);
        if (strEq(valueType, "Char")) {
            return "  " + resultName + ".c = load i8, ptr %" + name + "\n" +
                "  " + resultName + " = zext i8 " + resultName + ".c to i32\n";
        }
        return "  " + resultName + " = load i32, ptr %" + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 2 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "length")) {
        val name: String = tokenTextAt(tokens, start);
        return "  " + resultName + ".obj = load ptr, ptr %" + name + "\n" +
            "  " + resultName + ".i64 = call i64 @csec_string_length(ptr " + resultName + ".obj)\n" +
            "  " + resultName + " = trunc i64 " + resultName + ".i64 to i32\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 4 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "charAt") and
        tokenIs(tokens, start + 3, kindOperator(), "(") and
        findClosingToken(tokens, start + 3, end, "(", ")") == end - 1) {
        val name: String = tokenTextAt(tokens, start);
        return "  " + resultName + ".obj = load ptr, ptr %" + name + "\n" +
            generateLLVMExpressionI32(tokens, start + 4, end - 1, resultName + ".index") +
            "  " + resultName + ".i8 = call i8 @csec_string_char_at(ptr " + resultName + ".obj, i32 " + resultName + ".index)\n" +
            "  " + resultName + " = zext i8 " + resultName + ".i8 to i32\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        val callee: String = tokenTextAt(tokens, start);
        if (llvmCallReturnsChar(tokens, callee)) {
            return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
                "  " + resultName + ".i8 = call i8 @" + llvmRuntimeCallName(callee) + "(" +
                generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n" +
                "  " + resultName + " = zext i8 " + resultName + ".i8 to i32\n";
        }
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call i32 @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (strEq(mnemonic, "add") or strEq(mnemonic, "sub") or strEq(mnemonic, "mul") or
            strEq(mnemonic, "sdiv") or strEq(mnemonic, "srem") or strEq(mnemonic, "shl") or
            strEq(mnemonic, "ashr") or strEq(mnemonic, "and") or strEq(mnemonic, "or") or
            strEq(mnemonic, "xor")) {
            return generateLLVMExpressionI32(tokens, start, op, resultName + ".left") +
                generateLLVMExpressionI32(tokens, op + 1, end, resultName + ".right") +
                "  " + resultName + " = " + mnemonic + " i32 " +
                resultName + ".left, " + resultName + ".right\n";
        }
    }
    return "  " + resultName + " = add i32 0, 0\n";
}

def generateLLVMLocalI32(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    if (initializer >= start) {
        return "  %" + name + " = alloca i32\n" +
            generateLLVMExpressionI32(tokens, initializer + 1, end, "%" + name + ".init") +
            "  store i32 %" + name + ".init, ptr %" + name + "\n";
    }
    return "  %" + name + " = alloca i32\n" +
        "  store i32 0, ptr %" + name + "\n";
}

def llvmI64Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".lval." + start;
    }
    return "%ltmp";
}

def generateLLVMLoadI64IfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        return "  %" + name + ".lval." + start + " = load i64, ptr %" + name + "\n";
    }
    return "";
}

def generateLLVMExpressionI64(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = add i64 0, 0\n";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return "  " + resultName + " = add i64 0, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load i64, ptr %" + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call i64 @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (strEq(mnemonic, "add") or strEq(mnemonic, "sub") or strEq(mnemonic, "mul") or
            strEq(mnemonic, "sdiv") or strEq(mnemonic, "srem") or strEq(mnemonic, "shl") or
            strEq(mnemonic, "ashr") or strEq(mnemonic, "and") or strEq(mnemonic, "or") or
            strEq(mnemonic, "xor")) {
            return generateLLVMLoadI64IfIdentifier(tokens, start, op) +
                generateLLVMLoadI64IfIdentifier(tokens, op + 1, end) +
                "  " + resultName + " = " + mnemonic + " i64 " +
                llvmI64Value(tokens, start, op) + ", " + llvmI64Value(tokens, op + 1, end) + "\n";
        }
    }
    return "  " + resultName + " = add i64 0, 0\n";
}

def generateLLVMLocalI64(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    if (initializer >= start) {
        return "  %" + name + " = alloca i64\n" +
            generateLLVMExpressionI64(tokens, initializer + 1, end, "%" + name + ".linit") +
            "  store i64 %" + name + ".linit, ptr %" + name + "\n";
    }
    return "  %" + name + " = alloca i64\n" +
        "  store i64 0, ptr %" + name + "\n";
}

def llvmF64Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0.000000e+00";
    }
    if ((tokenKindAt(tokens, start) == kindFloat() or tokenKindAt(tokens, start) == kindInteger()) and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".fval." + start;
    }
    return "%ftmp";
}

def generateLLVMLoadF64IfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        return "  %" + name + ".fval." + start + " = load double, ptr %" + name + "\n";
    }
    return "";
}

def generateLLVMExpressionF64(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = fadd double 0.000000e+00, 0.000000e+00\n";
    }
    if ((tokenKindAt(tokens, start) == kindFloat() or tokenKindAt(tokens, start) == kindInteger()) and end == start + 1) {
        return "  " + resultName + " = fadd double 0.000000e+00, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load double, ptr %" + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call double @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        val opText: String = tokenTextAt(tokens, op);
        var mnemonic: String = "";
        if (strEq(opText, "+")) { mnemonic = "fadd"; }
        if (strEq(opText, "-")) { mnemonic = "fsub"; }
        if (strEq(opText, "*")) { mnemonic = "fmul"; }
        if (strEq(opText, "/")) { mnemonic = "fdiv"; }
        if (mnemonic.length > 0) {
            return generateLLVMLoadF64IfIdentifier(tokens, start, op) +
                generateLLVMLoadF64IfIdentifier(tokens, op + 1, end) +
                "  " + resultName + " = " + mnemonic + " double " +
                llvmF64Value(tokens, start, op) + ", " +
                llvmF64Value(tokens, op + 1, end) + "\n";
        }
    }
    return "  " + resultName + " = fadd double 0.000000e+00, 0.000000e+00\n";
}

def generateLLVMLocalF64(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    if (initializer >= start) {
        return "  %" + name + " = alloca double\n" +
            generateLLVMExpressionF64(tokens, initializer + 1, end, "%" + name + ".finit") +
            "  store double %" + name + ".finit, ptr %" + name + "\n";
    }
    return "  %" + name + " = alloca double\n" +
        "  store double 0.000000e+00, ptr %" + name + "\n";
}

def generateLLVMLocalPtr(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    if (initializer >= start) {
        val exprStart: Int = skipTrivia(tokens, initializer + 1);
        val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
        if (tokenKindAt(tokens, exprStart) == kindString() and exprEnd == exprStart + 1) {
            val text: String = tokenTextAt(tokens, exprStart);
            val byteLength: Int = text.length + 1;
            return "  %" + name + " = alloca ptr\n" +
                "  %" + name + ".pinit = getelementptr inbounds [" + byteLength +
                " x i8], ptr @.str." + exprStart + ", i32 0, i32 0\n" +
                "  store ptr %" + name + ".pinit, ptr %" + name + "\n";
        }
        if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprEnd == exprStart + 1) {
            return "  %" + name + " = alloca ptr\n" +
                "  %" + name + ".pinit = load ptr, ptr %" + tokenTextAt(tokens, exprStart) + "\n" +
                "  store ptr %" + name + ".pinit, ptr %" + name + "\n";
        }
        if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 1 < exprEnd and
            tokenIs(tokens, exprStart + 1, kindOperator(), "(") and
            findClosingToken(tokens, exprStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
            return "  %" + name + " = alloca ptr\n" +
                generateLLVMCallArgumentLoadsI32(tokens, exprStart + 2, exprEnd - 1, "%" + name + ".pinit") +
                "  %" + name + ".pinit = call ptr @" + llvmRuntimeCallName(tokenTextAt(tokens, exprStart)) + "(" +
                generateLLVMCallArgumentListI32(tokens, exprStart + 2, exprEnd - 1, "%" + name + ".pinit") + ")\n" +
                "  store ptr %" + name + ".pinit, ptr %" + name + "\n";
        }
    }
    return "  %" + name + " = alloca ptr\n" +
        "  store ptr null, ptr %" + name + "\n";
}

def generateLLVMLocalI8(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    if (initializer >= start) {
        val exprStart: Int = skipTrivia(tokens, initializer + 1);
        val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
        if (tokenKindAt(tokens, exprStart) == kindChar() and exprEnd == exprStart + 1) {
            return "  %" + name + " = alloca i8\n" +
                "  store i8 " + llvmCharI8Value(tokenTextAt(tokens, exprStart)) + ", ptr %" + name + "\n";
        }
        if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprEnd == exprStart + 1) {
            return "  %" + name + " = alloca i8\n" +
                "  %" + name + ".cinit = load i8, ptr %" + tokenTextAt(tokens, exprStart) + "\n" +
                "  store i8 %" + name + ".cinit, ptr %" + name + "\n";
        }
        if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 1 < exprEnd and
            tokenIs(tokens, exprStart + 1, kindOperator(), "(") and
            findClosingToken(tokens, exprStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
            return "  %" + name + " = alloca i8\n" +
                generateLLVMCallArgumentLoadsI32(tokens, exprStart + 2, exprEnd - 1, "%" + name + ".cinit") +
                "  %" + name + ".cinit = call i8 @" + llvmRuntimeCallName(tokenTextAt(tokens, exprStart)) + "(" +
                generateLLVMCallArgumentListI32(tokens, exprStart + 2, exprEnd - 1, "%" + name + ".cinit") + ")\n" +
                "  store i8 %" + name + ".cinit, ptr %" + name + "\n";
        }
    }
    return "  %" + name + " = alloca i8\n" +
        "  store i8 0, ptr %" + name + "\n";
}

def generateLLVMAssignmentF64(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".fassign." + start;
        return generateLLVMExpressionF64(tokens, op + 1, end, resultName) +
            "  store double " + resultName + ", ptr %" + name + "\n";
    }
    return "";
}

def generateLLVMAssignmentPtr(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val exprStart: Int = skipTrivia(tokens, op + 1);
    val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
    if (tokenKindAt(tokens, exprStart) == kindString() and exprEnd == exprStart + 1) {
        val text: String = tokenTextAt(tokens, exprStart);
        val byteLength: Int = text.length + 1;
        return "  %" + name + ".passign." + start + " = getelementptr inbounds [" + byteLength +
            " x i8], ptr @.str." + exprStart + ", i32 0, i32 0\n" +
            "  store ptr %" + name + ".passign." + start + ", ptr %" + name + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprEnd == exprStart + 1) {
        return "  %" + name + ".passign." + start + " = load ptr, ptr %" + tokenTextAt(tokens, exprStart) + "\n" +
            "  store ptr %" + name + ".passign." + start + ", ptr %" + name + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 1 < exprEnd and
        tokenIs(tokens, exprStart + 1, kindOperator(), "(") and
        findClosingToken(tokens, exprStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
        val resultName: String = "%" + name + ".passign." + start;
        return generateLLVMCallArgumentLoadsI32(tokens, exprStart + 2, exprEnd - 1, resultName) +
            "  " + resultName + " = call ptr @" + llvmRuntimeCallName(tokenTextAt(tokens, exprStart)) + "(" +
            generateLLVMCallArgumentListI32(tokens, exprStart + 2, exprEnd - 1, resultName) + ")\n" +
            "  store ptr " + resultName + ", ptr %" + name + "\n";
    }
    return "";
}

def generateLLVMAssignmentI8(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val exprStart: Int = skipTrivia(tokens, op + 1);
    val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
    if (tokenKindAt(tokens, exprStart) == kindChar() and exprEnd == exprStart + 1) {
        return "  store i8 " + llvmCharI8Value(tokenTextAt(tokens, exprStart)) + ", ptr %" + name + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprEnd == exprStart + 1) {
        return "  %" + name + ".cassign." + start + " = load i8, ptr %" + tokenTextAt(tokens, exprStart) + "\n" +
            "  store i8 %" + name + ".cassign." + start + ", ptr %" + name + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 1 < exprEnd and
        tokenIs(tokens, exprStart + 1, kindOperator(), "(") and
        findClosingToken(tokens, exprStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
        val resultName: String = "%" + name + ".cassign." + start;
        return generateLLVMCallArgumentLoadsI32(tokens, exprStart + 2, exprEnd - 1, resultName) +
            "  " + resultName + " = call i8 @" + llvmRuntimeCallName(tokenTextAt(tokens, exprStart)) + "(" +
            generateLLVMCallArgumentListI32(tokens, exprStart + 2, exprEnd - 1, resultName) + ")\n" +
            "  store i8 " + resultName + ", ptr %" + name + "\n";
    }
    return "";
}

def generateLLVMAssignmentI32(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".assign." + start;
        return generateLLVMExpressionI32(tokens, op + 1, end, resultName) +
            "  store i32 " + resultName + ", ptr %" + name + "\n";
    }
    var binaryOp: String = opText.substring(0, 1);
    if (strEq(opText, "%=")) {
        binaryOp = "%";
    }
    return "  %" + name + ".old." + start + " = load i32, ptr %" + name + "\n" +
        generateLLVMExpressionI32(tokens, op + 1, end, "%" + name + ".rhs." + start) +
        "  %" + name + ".next." + start + " = " + irOperatorName(binaryOp) + " i32 %" + name + ".old." + start + ", %" + name + ".rhs." + start + "\n" +
        "  store i32 %" + name + ".next." + start + ", ptr %" + name + "\n";
}

def generateLLVMAssignmentI64(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".lassign." + start;
        return generateLLVMExpressionI64(tokens, op + 1, end, resultName) +
            "  store i64 " + resultName + ", ptr %" + name + "\n";
    }
    var binaryOp: String = opText.substring(0, 1);
    if (strEq(opText, "%=")) {
        binaryOp = "%";
    }
    return "  %" + name + ".lold." + start + " = load i64, ptr %" + name + "\n" +
        generateLLVMExpressionI64(tokens, op + 1, end, "%" + name + ".lrhs." + start) +
        "  %" + name + ".lnext." + start + " = " + irOperatorName(binaryOp) + " i64 %" + name + ".lold." + start + ", %" + name + ".lrhs." + start + "\n" +
        "  store i64 %" + name + ".lnext." + start + ", ptr %" + name + "\n";
}

def generateLLVMConditionI1(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    val op: Int = findTopLevelOperator(tokens, start, end, 4);
    if (op > start) {
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (mnemonic.startsWith("icmp_")) {
            return generateLLVMExpressionI32(tokens, start, op, resultName + ".left.i32") +
                generateLLVMExpressionI32(tokens, op + 1, end, resultName + ".right.i32") +
                "  " + resultName + " = icmp " + mnemonic.substring(5, mnemonic.length - 5) +
                " i32 " + resultName + ".left.i32, " + resultName + ".right.i32\n";
        }
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        if (strEq(tokenTextAt(tokens, start), "true")) {
            return "  " + resultName + " = icmp eq i1 true, true\n";
        }
        return "  " + resultName + " = icmp eq i1 false, true\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load i1, ptr %" + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call i1 @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    return "  " + resultName + " = icmp eq i32 0, 0\n";
}

def generateLLVMExpressionI1(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = icmp eq i1 false, true\n";
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        if (strEq(tokenTextAt(tokens, start), "true")) {
            return "  " + resultName + " = icmp eq i1 true, true\n";
        }
        return "  " + resultName + " = icmp eq i1 false, true\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load i1, ptr %" + tokenTextAt(tokens, start) + "\n";
    }
    var op: Int = findTopLevelOperator(tokens, start, end, 2);
    if (op > start) {
        return generateLLVMExpressionI1(tokens, start, op, resultName + ".left") +
            generateLLVMExpressionI1(tokens, op + 1, end, resultName + ".right") +
            "  " + resultName + " = or i1 " + resultName + ".left, " + resultName + ".right\n" +
            "  ; bool operands " + llvmI1Value(tokens, start, op) + ", " +
            llvmI1Value(tokens, op + 1, end) + "\n";
    }
    op = findTopLevelOperator(tokens, start, end, 3);
    if (op > start) {
        return generateLLVMExpressionI1(tokens, start, op, resultName + ".left") +
            generateLLVMExpressionI1(tokens, op + 1, end, resultName + ".right") +
            "  " + resultName + " = and i1 " + resultName + ".left, " + resultName + ".right\n" +
            "  ; bool operands " + llvmI1Value(tokens, start, op) + ", " +
            llvmI1Value(tokens, op + 1, end) + "\n";
    }
    return generateLLVMConditionI1(tokens, start, end, resultName);
}

def generateLLVMLocalI1(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    if (initializer >= start) {
        return "  %" + name + " = alloca i1\n" +
            generateLLVMExpressionI1(tokens, initializer + 1, end, "%" + name + ".binit") +
            "  store i1 %" + name + ".binit, ptr %" + name + "\n";
    }
    return "  %" + name + " = alloca i1\n" +
        "  store i1 false, ptr %" + name + "\n";
}

def generateLLVMAssignmentI1(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".bassign." + start;
        return generateLLVMExpressionI1(tokens, op + 1, end, resultName) +
            "  store i1 " + resultName + ", ptr %" + name + "\n";
    }
    return "";
}

def llvmBlockEndsWithTopLevelReturn(tokens: String, bodyStart: Int, bodyEnd: Int): Boolean {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var result: Boolean = false;
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            result = true;
        }
        else {
            result = false;
        }
        cursor = skipTrivia(tokens, next);
    }
    return result;
}

def generateLLVMExpressionPtr(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = inttoptr i64 0 to ptr\n";
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        val text: String = tokenTextAt(tokens, start);
        val byteLength: Int = text.length + 1;
        return "  " + resultName + " = getelementptr inbounds [" + byteLength +
            " x i8], ptr @.str." + start + ", i32 0, i32 0\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load ptr, ptr %" + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call ptr @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator() and strEq(tokenTextAt(tokens, op), "+")) {
        return generateLLVMExpressionPtr(tokens, start, op, resultName + ".left") +
            generateLLVMExpressionPtr(tokens, op + 1, end, resultName + ".right") +
            "  " + resultName + " = call ptr @csec_string_concat(ptr " + resultName + ".left, ptr " +
            resultName + ".right)\n";
    }
    return "  " + resultName + " = inttoptr i64 0 to ptr\n";
}

def llvmExpressionLooksPtr(tokens: String, start: Int, rawEnd: Int): Boolean {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return false;
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        return true;
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return strEq(irTypeName(lookupVisibleValueType(tokens, start, tokenTextAt(tokens, start))), "ptr");
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return strEq(irTypeName(lookupFunctionReturnType(tokens, tokenTextAt(tokens, start))), "ptr");
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator() and strEq(tokenTextAt(tokens, op), "+")) {
        return llvmExpressionLooksPtr(tokens, start, op) or llvmExpressionLooksPtr(tokens, op + 1, end);
    }
    return false;
}

def generateLLVMFlatBodyI32(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "value") or strEq(kind, "variable")) {
            if (strEq(localDeclarationType(tokens, cursor, next), "Int") or
                strEq(localDeclarationType(tokens, cursor, next), "unknown")) {
                output = output + generateLLVMLocalI32(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Boolean")) {
                output = output + generateLLVMLocalI1(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Double")) {
                output = output + generateLLVMLocalF64(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Long")) {
                output = output + generateLLVMLocalI64(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Char")) {
                output = output + generateLLVMLocalI8(tokens, cursor, next);
            }
            else if (strEq(irTypeName(localDeclarationType(tokens, cursor, next)), "ptr")) {
                output = output + generateLLVMLocalPtr(tokens, cursor, next);
            }
        }
        else if (strEq(kind, "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindBool() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                output = output + "  ret i1 " + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            else if (tokenKindAt(tokens, cursor + 1) == kindString() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val text: String = tokenTextAt(tokens, cursor + 1);
                val byteLength: Int = text.length + 1;
                val resultName: String = "%ret." + cursor;
                output = output + "  " + resultName + " = getelementptr inbounds [" + byteLength +
                    " x i8], ptr @.str." + (cursor + 1) + ", i32 0, i32 0\n" +
                    "  ret ptr " + resultName + "\n";
            }
            else if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val returnName: String = tokenTextAt(tokens, cursor + 1);
                val returnType: String = lookupVisibleValueType(tokens, cursor, returnName);
                val llvmType: String = irTypeName(returnType);
                val resultName: String = "%ret." + cursor;
                if (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or strEq(llvmType, "i1") or
                    strEq(llvmType, "i64") or strEq(llvmType, "double")) {
                    output = output + "  " + resultName + " = load " + llvmType + ", ptr %" + returnName + "\n" +
                        "  ret " + llvmType + " " + resultName + "\n";
                }
                else {
                    output = output + generateLLVMExpressionI32(tokens, cursor + 1, next, resultName) +
                        "  ret i32 " + resultName + "\n";
                }
            }
            else if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and cursor + 2 < next and
                tokenIs(tokens, cursor + 2, kindOperator(), "(")) {
                val callEnd: Int = findClosingToken(tokens, cursor + 2, next, "(", ")");
                val returnType: String = lookupFunctionReturnType(tokens, tokenTextAt(tokens, cursor + 1));
                val llvmType: String = irTypeName(returnType);
                val resultName: String = "%ret." + cursor;
                if (callEnd > cursor + 2 and (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or
                    strEq(llvmType, "i1") or strEq(llvmType, "i64") or strEq(llvmType, "double"))) {
                    output = output + generateLLVMCallArgumentLoadsI32(tokens, cursor + 3, callEnd, resultName) +
                        "  " + resultName + " = call " + llvmType + " @" +
                        llvmRuntimeCallName(tokenTextAt(tokens, cursor + 1)) + "(" +
                        generateLLVMCallArgumentListI32(tokens, cursor + 3, callEnd, resultName) + ")\n" +
                        "  ret " + llvmType + " " + resultName + "\n";
                }
                else {
                    output = output + generateLLVMExpressionI32(tokens, cursor + 1, next, resultName) +
                        "  ret i32 " + resultName + "\n";
                }
            }
            else if (llvmExpressionLooksPtr(tokens, cursor + 1, next)) {
                val resultName: String = "%ret." + cursor;
                output = output + generateLLVMExpressionPtr(tokens, cursor + 1, next, resultName) +
                    "  ret ptr " + resultName + "\n";
            }
            else {
                val resultName: String = "%ret." + cursor;
                output = output + generateLLVMExpressionI32(tokens, cursor + 1, next, resultName) +
                    "  ret i32 " + resultName + "\n";
            }
        }
        else if (strEq(kind, "if")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val thenStart: Int = findStatementBlockStart(tokens, cursor, next);
            val thenEnd: Int = findClosingToken(tokens, thenStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
                output = output + "  ; malformed if\n";
            }
            else {
                val labelSeed: String = "" + cursor;
                val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
                val thenBody: String = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
                var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
                    thenBranch = "";
                }
                var elseBody: String = "";
                var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                    if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                        val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                        if (elseEnd > elseStart) {
                            elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                            if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                                elseBranch = "";
                            }
                        }
                    }
                }
                output = output + generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
                    "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
                    ", label %if.else." + labelSeed + "\n" +
                    "if.then." + labelSeed + ":\n" +
                    thenBody +
                    thenBranch +
                    "if.else." + labelSeed + ":\n" +
                    elseBody +
                    elseBranch +
                    "if.end." + labelSeed + ":\n";
            }
        }
        else if (strEq(kind, "while")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val bodyStart: Int = findStatementBlockStart(tokens, cursor, next);
            val bodyEnd: Int = findClosingToken(tokens, bodyStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
                output = output + "  ; malformed while\n";
            }
            else {
                val labelSeed: String = "" + cursor;
                val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
                var continueBranch: String = "  br label %while.cond." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
                    continueBranch = "";
                }
                output = output + "  br label %while.cond." + labelSeed + "\n" +
                    "while.cond." + labelSeed + ":\n" +
                    generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%whilecond." + labelSeed) +
                    "  br i1 %whilecond." + labelSeed + ", label %while.body." + labelSeed +
                    ", label %while.end." + labelSeed + "\n" +
                    "while.body." + labelSeed + ":\n" +
                    body +
                    continueBranch +
                    "while.end." + labelSeed + ":\n";
            }
        }
        else if (strEq(kind, "for")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val bodyStart: Int = findStatementBlockStart(tokens, cursor, next);
            val bodyEnd: Int = findClosingToken(tokens, bodyStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
                output = output + "  ; malformed for\n";
            }
            else if (tokenKindAt(tokens, openParen + 1) != kindIdentifier()) {
                output = output + "  ; malformed for iterator\n";
            }
            else {
                val iteratorName: String = tokenTextAt(tokens, openParen + 1);
                val sourceArrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
                if (sourceArrow < 0) {
                    output = output + "  ; malformed for source\n";
                }
                else {
                    val rangeOp: Int = findTopLevelOperator(tokens, sourceArrow + 1, closeParen, 5);
                    if (rangeOp <= sourceArrow) {
                        output = output + "  ; unsupported for source\n";
                    }
                    else {
                        val labelSeed: String = "" + cursor;
                        var compareOp: String = "slt";
                        if (strEq(tokenTextAt(tokens, rangeOp), "to") or strEq(tokenTextAt(tokens, rangeOp), "..")) {
                            compareOp = "sle";
                        }
                        val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
                        var stepBranch: String = "  %" + iteratorName + ".step." + labelSeed + " = load i32, ptr %" + iteratorName + "\n" +
                            "  %" + iteratorName + ".next." + labelSeed + " = add i32 %" + iteratorName + ".step." + labelSeed + ", 1\n" +
                            "  store i32 %" + iteratorName + ".next." + labelSeed + ", ptr %" + iteratorName + "\n" +
                            "  br label %for.cond." + labelSeed + "\n";
                        if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
                            stepBranch = "";
                        }
                        output = output + "  %" + iteratorName + " = alloca i32\n" +
                            generateLLVMExpressionI32(tokens, sourceArrow + 1, rangeOp, "%" + iteratorName + ".start") +
                            "  store i32 %" + iteratorName + ".start, ptr %" + iteratorName + "\n" +
                            "  br label %for.cond." + labelSeed + "\n" +
                            "for.cond." + labelSeed + ":\n" +
                            "  %" + iteratorName + ".val = load i32, ptr %" + iteratorName + "\n" +
                            generateLLVMExpressionI32(tokens, rangeOp + 1, closeParen, "%" + iteratorName + ".end") +
                            "  %forcond." + labelSeed + " = icmp " + compareOp + " i32 %" + iteratorName + ".val, %" + iteratorName + ".end\n" +
                            "  br i1 %forcond." + labelSeed + ", label %for.body." + labelSeed +
                            ", label %for.end." + labelSeed + "\n" +
                            "for.body." + labelSeed + ":\n" +
                            body +
                            stepBranch +
                            "for.end." + labelSeed + ":\n";
                    }
                }
            }
        }
        else {
            if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
                val targetType: String = lookupVisibleValueType(tokens, cursor, tokenTextAt(tokens, cursor));
                if (strEq(targetType, "Boolean")) {
                    output = output + generateLLVMAssignmentI1(tokens, cursor, next);
                }
                else if (strEq(targetType, "Double")) {
                    output = output + generateLLVMAssignmentF64(tokens, cursor, next);
                }
                else if (strEq(targetType, "Long")) {
                    output = output + generateLLVMAssignmentI64(tokens, cursor, next);
                }
                else if (strEq(targetType, "Char")) {
                    output = output + generateLLVMAssignmentI8(tokens, cursor, next);
                }
                else if (strEq(irTypeName(targetType), "ptr")) {
                    output = output + generateLLVMAssignmentPtr(tokens, cursor, next);
                }
                else {
                    output = output + generateLLVMAssignmentI32(tokens, cursor, next);
                }
            }
            else {
                output = output + generateLLVMAssignmentI32(tokens, cursor, next);
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateLLVMIfI32(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val thenStart: Int = findStatementBlockStart(tokens, start, end);
    val thenEnd: Int = findClosingToken(tokens, thenStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
        return "  ; malformed if\n";
    }
    val labelSeed: String = "" + start;
    val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
    val thenBody: String = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
    var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
    if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
        thenBranch = "";
    }
    var elseBody: String = "";
    var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
    if (possibleElse < end and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
        val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
        if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
            val elseEnd: Int = findClosingToken(tokens, elseStart, end, "{", "}");
            if (elseEnd > elseStart) {
                elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                    elseBranch = "";
                }
            }
        }
    }
    return generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
        "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
        ", label %if.else." + labelSeed + "\n" +
        "if.then." + labelSeed + ":\n" +
        thenBody +
        thenBranch +
        "if.else." + labelSeed + ":\n" +
        elseBody +
        elseBranch +
        "if.end." + labelSeed + ":\n";
}

def generateLLVMWhileI32(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "  ; malformed while\n";
    }
    val labelSeed: String = "" + start;
    val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
    var continueBranch: String = "  br label %while.cond." + labelSeed + "\n";
    if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
        continueBranch = "";
    }
    return "  br label %while.cond." + labelSeed + "\n" +
        "while.cond." + labelSeed + ":\n" +
        generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%whilecond." + labelSeed) +
        "  br i1 %whilecond." + labelSeed + ", label %while.body." + labelSeed +
        ", label %while.end." + labelSeed + "\n" +
        "while.body." + labelSeed + ":\n" +
        body +
        continueBranch +
        "while.end." + labelSeed + ":\n";
}

def generateLLVMForI32(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "  ; malformed for\n";
    }
    if (tokenKindAt(tokens, openParen + 1) != kindIdentifier()) {
        return "  ; malformed for iterator\n";
    }
    val iteratorName: String = tokenTextAt(tokens, openParen + 1);
    val sourceArrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
    if (sourceArrow < 0) {
        return "  ; malformed for source\n";
    }
    val rangeOp: Int = findTopLevelOperator(tokens, sourceArrow + 1, closeParen, 5);
    if (rangeOp <= sourceArrow) {
        return "  ; unsupported for source\n";
    }
    val labelSeed: String = "" + start;
    var compareOp: String = "slt";
    if (strEq(tokenTextAt(tokens, rangeOp), "to") or strEq(tokenTextAt(tokens, rangeOp), "..")) {
        compareOp = "sle";
    }
    val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
    var stepBranch: String = "  %" + iteratorName + ".step." + labelSeed + " = load i32, ptr %" + iteratorName + "\n" +
        "  %" + iteratorName + ".next." + labelSeed + " = add i32 %" + iteratorName + ".step." + labelSeed + ", 1\n" +
        "  store i32 %" + iteratorName + ".next." + labelSeed + ", ptr %" + iteratorName + "\n" +
        "  br label %for.cond." + labelSeed + "\n";
    if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
        stepBranch = "";
    }
    return "  %" + iteratorName + " = alloca i32\n" +
        generateLLVMExpressionI32(tokens, sourceArrow + 1, rangeOp, "%" + iteratorName + ".start") +
        "  store i32 %" + iteratorName + ".start, ptr %" + iteratorName + "\n" +
        "  br label %for.cond." + labelSeed + "\n" +
        "for.cond." + labelSeed + ":\n" +
        "  %" + iteratorName + ".val = load i32, ptr %" + iteratorName + "\n" +
        generateLLVMExpressionI32(tokens, rangeOp + 1, closeParen, "%" + iteratorName + ".end") +
        "  %forcond." + labelSeed + " = icmp " + compareOp + " i32 %" + iteratorName + ".val, %" + iteratorName + ".end\n" +
        "  br i1 %forcond." + labelSeed + ", label %for.body." + labelSeed +
        ", label %for.end." + labelSeed + "\n" +
        "for.body." + labelSeed + ":\n" +
        body +
        stepBranch +
        "for.end." + labelSeed + ":\n";
}

def generateLLVMReturnI32(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = bodyStart;
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindInteger() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return "  ret i32 " + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            return generateLLVMExpressionI32(tokens, cursor + 1, advanceStatement(tokens, cursor, bodyEnd), "%ret") +
                "  ret i32 %ret\n";
        }
        cursor = cursor + 1;
    }
    return "  ret i32 0\n";
}

def generateLLVMMainBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "entry:\n";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "value") or strEq(kind, "variable")) {
            if (strEq(localDeclarationType(tokens, cursor, next), "Int") or
                strEq(localDeclarationType(tokens, cursor, next), "unknown")) {
                output = output + generateLLVMLocalI32(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Boolean")) {
                output = output + generateLLVMLocalI1(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Double")) {
                output = output + generateLLVMLocalF64(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Long")) {
                output = output + generateLLVMLocalI64(tokens, cursor, next);
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Char")) {
                output = output + generateLLVMLocalI8(tokens, cursor, next);
            }
            else if (strEq(irTypeName(localDeclarationType(tokens, cursor, next)), "ptr")) {
                output = output + generateLLVMLocalPtr(tokens, cursor, next);
            }
        }
        else if (strEq(kind, "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindInteger() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + "  ret i32 " + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val returnName: String = tokenTextAt(tokens, cursor + 1);
                val returnType: String = lookupVisibleValueType(tokens, cursor, returnName);
                if (strEq(returnType, "Boolean")) {
                    return output +
                        llvmLoadForValueType(tokens, returnName, returnType, "%" + returnName + ".ret") +
                        "  %ret.bool = zext i1 %" + returnName + ".ret to i32\n" +
                        "  ret i32 %ret.bool\n";
                }
                if (strEq(returnType, "Double")) {
                    return output +
                        llvmLoadForValueType(tokens, returnName, returnType, "%" + returnName + ".ret") +
                        "  %ret.double = fptosi double %" + returnName + ".ret to i32\n" +
                        "  ret i32 %ret.double\n";
                }
                return output +
                    llvmLoadForValueType(tokens, returnName, returnType, "%" + returnName + ".ret") +
                    "  ret i32 %" + returnName + ".ret\n";
            }
            output = output + generateLLVMExpressionI32(tokens, cursor + 1, next, "%ret");
            return output + "  ret i32 %ret\n";
        }
        else if (strEq(kind, "if")) {
            output = output + generateLLVMIfI32(tokens, cursor, next);
        }
        else if (strEq(kind, "while")) {
            output = output + generateLLVMWhileI32(tokens, cursor, next);
        }
        else if (strEq(kind, "for")) {
            output = output + generateLLVMForI32(tokens, cursor, next);
        }
        else {
            if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
                val targetType: String = lookupVisibleValueType(tokens, cursor, tokenTextAt(tokens, cursor));
                if (strEq(targetType, "Boolean")) {
                    output = output + generateLLVMAssignmentI1(tokens, cursor, next);
                }
                else if (strEq(targetType, "Double")) {
                    output = output + generateLLVMAssignmentF64(tokens, cursor, next);
                }
                else if (strEq(targetType, "Long")) {
                    output = output + generateLLVMAssignmentI64(tokens, cursor, next);
                }
                else if (strEq(targetType, "Char")) {
                    output = output + generateLLVMAssignmentI8(tokens, cursor, next);
                }
                else if (strEq(irTypeName(targetType), "ptr")) {
                    output = output + generateLLVMAssignmentPtr(tokens, cursor, next);
                }
                else {
                    output = output + generateLLVMAssignmentI32(tokens, cursor, next);
                }
            }
            else {
                output = output + generateLLVMAssignmentI32(tokens, cursor, next);
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return output + "  ret i32 0\n";
}

def generateLLVMParamList(tokens: String, declStart: Int): String {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return "";
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, declStart), "(", ")");
    if (paramEnd <= paramStart) {
        return "";
    }
    var cursor: Int = paramStart + 1;
    var output: String = "";
    var first: Boolean = true;
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            var typeName: String = "unknown";
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                typeName = typeSummary(tokens, cursor + 2, paramEnd);
            }
            if (!first) {
                output = output + ", ";
            }
            output = output + irTypeName(typeName) + " %arg." + tokenTextAt(tokens, cursor);
            first = false;
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return output;
}

def generateLLVMParamAllocas(tokens: String, declStart: Int): String {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return "";
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, declStart), "(", ")");
    if (paramEnd <= paramStart) {
        return "";
    }
    var cursor: Int = paramStart + 1;
    var output: String = "";
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            val name: String = tokenTextAt(tokens, cursor);
            var typeName: String = "unknown";
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                typeName = typeSummary(tokens, cursor + 2, paramEnd);
            }
            val llvmType: String = irTypeName(typeName);
            output = output +
                "  %" + name + " = alloca " + llvmType + "\n" +
                "  store " + llvmType + " %arg." + name + ", ptr %" + name + "\n";
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return output;
}

def generateLLVMBooleanBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var output: String = "";
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            val resultName: String = "%ret." + cursor;
            if (tokenKindAt(tokens, cursor + 1) == kindBool() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + generateLLVMExpressionI1(tokens, cursor + 1, next, resultName) +
                    "  ret i1 " + resultName + "\n";
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + "  " + resultName + " = load i1, ptr %" + tokenTextAt(tokens, cursor + 1) + "\n" +
                    "  ret i1 " + resultName + "\n";
            }
            return output + generateLLVMExpressionI1(tokens, cursor + 1, next, resultName) +
                "  ret i1 " + resultName + "\n";
        }
        else if (strEq(kind, "if")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val thenStart: Int = findStatementBlockStart(tokens, cursor, next);
            val thenEnd: Int = findClosingToken(tokens, thenStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
                output = output + "  ; malformed if\n";
            }
            else {
                val labelSeed: String = "" + cursor;
                val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
                var thenBody: String = "";
                var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
                    thenBody = generateLLVMBooleanBodyFromRange(tokens, thenStart + 1, thenEnd);
                    thenBranch = "";
                }
                else {
                    thenBody = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
                }
                var elseBody: String = "";
                var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                    if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                        val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                        if (elseEnd > elseStart) {
                            if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                                elseBody = generateLLVMBooleanBodyFromRange(tokens, elseStart + 1, elseEnd);
                                elseBranch = "";
                            }
                            else {
                                elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                            }
                        }
                    }
                }
                output = output + generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
                    "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
                    ", label %if.else." + labelSeed + "\n" +
                    "if.then." + labelSeed + ":\n" +
                    thenBody +
                    thenBranch +
                    "if.else." + labelSeed + ":\n" +
                    elseBody +
                    elseBranch +
                    "if.end." + labelSeed + ":\n";
            }
        }
        else {
            output = output + generateLLVMFlatBodyI32(tokens, cursor, next);
        }
        cursor = skipTrivia(tokens, next);
    }
    return output + "  ret i1 false\n";
}

def generateLLVMCharBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var output: String = "";
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindChar() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + "  ret i8 " + llvmCharI8Value(tokenTextAt(tokens, cursor + 1)) + "\n";
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + "  %ret = load i8, ptr %" + tokenTextAt(tokens, cursor + 1) + "\n" +
                    "  ret i8 %ret\n";
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and cursor + 2 < next and
                tokenIs(tokens, cursor + 2, kindOperator(), "(")) {
                val callEnd: Int = findClosingToken(tokens, cursor + 2, next, "(", ")");
                if (callEnd > cursor + 2) {
                    val resultName: String = "%ret." + cursor;
                    return output + generateLLVMCallArgumentLoadsI32(tokens, cursor + 3, callEnd, resultName) +
                        "  " + resultName + " = call i8 @" + llvmRuntimeCallName(tokenTextAt(tokens, cursor + 1)) + "(" +
                        generateLLVMCallArgumentListI32(tokens, cursor + 3, callEnd, resultName) + ")\n" +
                        "  ret i8 " + resultName + "\n";
                }
            }
        }
        output = output + generateLLVMFlatBodyI32(tokens, cursor, next);
        cursor = skipTrivia(tokens, next);
    }
    return output + "  ret i8 0\n";
}

def generateLLVMDoubleBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var output: String = "";
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            if ((tokenKindAt(tokens, cursor + 1) == kindFloat() or
                tokenKindAt(tokens, cursor + 1) == kindInteger()) and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + generateLLVMExpressionF64(tokens, cursor + 1, next, "%ret") +
                    "  ret double %ret\n";
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + "  %ret = load double, ptr %" + tokenTextAt(tokens, cursor + 1) + "\n" +
                    "  ret double %ret\n";
            }
            return output + generateLLVMExpressionF64(tokens, cursor + 1, next, "%ret") +
                "  ret double %ret\n";
        }
        output = output + generateLLVMFlatBodyI32(tokens, cursor, next);
        cursor = skipTrivia(tokens, next);
    }
    return output + "  ret double 0.000000e+00\n";
}

def generateLLVMLongBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var output: String = "";
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindInteger() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + generateLLVMExpressionI64(tokens, cursor + 1, next, "%ret") +
                    "  ret i64 %ret\n";
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + "  %ret = load i64, ptr %" + tokenTextAt(tokens, cursor + 1) + "\n" +
                    "  ret i64 %ret\n";
            }
            return output + generateLLVMExpressionI64(tokens, cursor + 1, next, "%ret") +
                "  ret i64 %ret\n";
        }
        output = output + generateLLVMFlatBodyI32(tokens, cursor, next);
        cursor = skipTrivia(tokens, next);
    }
    return output + "  ret i64 0\n";
}

def llvmStringLiteralByteLength(text: String): Int {
    var cursor: Int = 0;
    var length: Int = 1;
    while (cursor < text.length) {
        if (text.charAt(cursor) == '\\' and cursor + 1 < text.length) {
            cursor = cursor + 2;
        }
        else {
            cursor = cursor + 1;
        }
        length = length + 1;
    }
    return length;
}

def generateLLVMPointerBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var output: String = "";
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            val resultName: String = "%ret." + cursor;
            if (tokenKindAt(tokens, cursor + 1) == kindString() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val text: String = tokenTextAt(tokens, cursor + 1);
                val byteLength: Int = llvmStringLiteralByteLength(text);
                return output + "  " + resultName + " = getelementptr inbounds [" + byteLength + " x i8], ptr @.str." + (cursor + 1) +
                    ", i32 0, i32 0\n" +
                    "  ret ptr " + resultName + "\n";
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return output + "  " + resultName + " = load ptr, ptr %" + tokenTextAt(tokens, cursor + 1) + "\n" +
                    "  ret ptr " + resultName + "\n";
            }
            return output + "  ret ptr null\n";
        }
        else if (strEq(kind, "if")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val thenStart: Int = findStatementBlockStart(tokens, cursor, next);
            val thenEnd: Int = findClosingToken(tokens, thenStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
                output = output + "  ; malformed if\n";
            }
            else {
                val labelSeed: String = "" + cursor;
                val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
                var thenBody: String = "";
                var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
                    thenBody = generateLLVMPointerBodyFromRange(tokens, thenStart + 1, thenEnd);
                    thenBranch = "";
                }
                else {
                    thenBody = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
                }
                var elseBody: String = "";
                var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                    if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                        val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                        if (elseEnd > elseStart) {
                            if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                                elseBody = generateLLVMPointerBodyFromRange(tokens, elseStart + 1, elseEnd);
                                elseBranch = "";
                            }
                            else {
                                elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                            }
                        }
                    }
                }
                output = output + generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
                    "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
                    ", label %if.else." + labelSeed + "\n" +
                    "if.then." + labelSeed + ":\n" +
                    thenBody +
                    thenBranch +
                    "if.else." + labelSeed + ":\n" +
                    elseBody +
                    elseBranch +
                    "if.end." + labelSeed + ":\n";
            }
        }
        else {
            output = output + generateLLVMFlatBodyI32(tokens, cursor, next);
        }
        cursor = skipTrivia(tokens, next);
    }
    return output + "  ret ptr null\n";
}

def generateLLVMVoidBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var output: String = "";
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            return output + "  ret void\n";
        }
        output = output + generateLLVMFlatBodyI32(tokens, cursor, next);
        cursor = skipTrivia(tokens, next);
    }
    return output + "  ret void\n";
}

def llvmStringLiteralBytes(text: String): String {
    var cursor: Int = 0;
    var output: String = "";
    while (cursor < text.length) {
        val ch: Char = text.charAt(cursor);
        if (ch == '\\' and cursor + 1 < text.length) {
            val escaped: Char = text.charAt(cursor + 1);
            if (escaped == 'n') { output = output + "\\0A"; }
            else if (escaped == 'r') { output = output + "\\0D"; }
            else if (escaped == 't') { output = output + "\\09"; }
            else if (escaped == '"') { output = output + "\\22"; }
            else if (escaped == '\\') { output = output + "\\5C"; }
            else { output = output + escaped; }
            cursor = cursor + 2;
        }
        else {
            if (ch == '"') { output = output + "\\22"; }
            else if (ch == '\\') { output = output + "\\5C"; }
            else { output = output + "" + ch; }
            cursor = cursor + 1;
        }
    }
    return output + "\\00";
}

def generateLLVMStringLiteralGlobals(tokens: String): String {
    var cursor: Int = 0;
    var output: String = "";
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindString()) {
            val text: String = tokenTextAt(tokens, cursor);
            val byteLength: Int = llvmStringLiteralByteLength(text);
            output = output + "@.str." + cursor +
                " = private unnamed_addr constant [" + byteLength + " x i8] c\"" +
                llvmStringLiteralBytes(text) + "\"\n";
        }
        cursor = cursor + 1;
    }
    if (output.length > 0) {
        return output + "\n";
    }
    return "";
}

def generateLLVMFunctionDefinition(tokens: String, declStart: Int): String {
    val name: String = topLevelDeclName(tokens, declStart);
    val returnType: String = functionReturnType(tokens, declStart);
    val bodyStart: Int = findDeclBodyStart(tokens, declStart);
    val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
    val declEnd: Int = advanceTopLevelDecl(tokens, declStart);
    val expressionStart: Int = findTopLevelOperator(tokens, declStart, declEnd, 1);
    if (expressionStart > declStart and (bodyStart < 0 or expressionStart < bodyStart)) {
        val valueStart: Int = skipTrivia(tokens, expressionStart + 1);
        val valueEnd: Int = trimExpressionEnd(tokens, valueStart, declEnd);
        if (strEq(returnType, "Char") and tokenKindAt(tokens, valueStart) == kindChar() and valueEnd == valueStart + 1) {
            return "define i8 @" + name + "() {\nentry:\n" +
                "  ret i8 " + llvmCharI8Value(tokenTextAt(tokens, valueStart)) + "\n}\n\n";
        }
        if (strEq(returnType, "Int") and tokenKindAt(tokens, valueStart) == kindInteger() and valueEnd == valueStart + 1) {
            return "define i32 @" + name + "() {\nentry:\n" +
                "  ret i32 " + tokenTextAt(tokens, valueStart) + "\n}\n\n";
        }
        if (strEq(returnType, "Boolean") and tokenKindAt(tokens, valueStart) == kindBool() and valueEnd == valueStart + 1) {
            return "define i1 @" + name + "() {\nentry:\n" +
                "  ret i1 " + tokenTextAt(tokens, valueStart) + "\n}\n\n";
        }
        if (strEq(irTypeName(returnType), "ptr") and tokenKindAt(tokens, valueStart) == kindString() and valueEnd == valueStart + 1) {
            val text: String = tokenTextAt(tokens, valueStart);
            val byteLength: Int = llvmStringLiteralByteLength(text);
            return "define ptr @" + name + "() {\nentry:\n" +
                "  %ret = getelementptr inbounds [" + byteLength + " x i8], ptr @.str." + valueStart +
                ", i32 0, i32 0\n" +
                "  ret ptr %ret\n}\n\n";
        }
    }
    if (bodyStart < 0 or bodyEnd <= bodyStart) {
        return "";
    }
    if (strEq(returnType, "Int")) {
        val body: String = generateLLVMMainBodyFromRange(tokens, bodyStart, bodyEnd);
        return "define i32 @" + name + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            body.substring(7, body.length - 7) +
            "}\n\n";
    }
    if (strEq(returnType, "Boolean")) {
        return "define i1 @" + name + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMBooleanBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Char")) {
        return "define i8 @" + name + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMCharBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Double")) {
        return "define double @" + name + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMDoubleBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Long")) {
        return "define i64 @" + name + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMLongBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Unit")) {
        return "define void @" + name + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMVoidBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(irTypeName(returnType), "ptr")) {
        return "define ptr @" + name + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMPointerBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    return "";
}

def generateLLVMModule(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "";
    }
    var output: String = "; ModuleID = 'csec.selfhost'\n" +
        "source_filename = \"csec.selfhost\"\n\n" +
        "declare i64 @csec_string_length(ptr)\n" +
        "declare i8 @csec_string_char_at(ptr, i32)\n\n" +
        "declare i32 @csec_command_line_arg_count()\n" +
        "declare ptr @csec_command_line_arg(i32)\n" +
        "declare ptr @csec_file_read_all_text(ptr)\n" +
        "declare i32 @csec_file_write_all_text(ptr, ptr)\n" +
        "declare void @csec_print_string(ptr)\n" +
        "declare ptr @csec_string_concat(ptr, ptr)\n" +
        "declare i32 @csec_string_starts_with(ptr, ptr)\n" +
        "declare ptr @csec_string_substring(ptr, i32, i32)\n" +
        "declare i64 @csec_token_builder_new()\n" +
        "declare i32 @csec_token_builder_append(i64, i8, ptr)\n" +
        "declare ptr @csec_token_builder_finish(i64)\n" +
        "declare i8 @csec_token_kind_at(ptr, i32)\n" +
        "declare ptr @csec_token_text_at(ptr, i32)\n" +
        "declare ptr @csec_expand_imports(ptr)\n\n" +
        generateLLVMStringLiteralGlobals(tokens);
    var emitted: Boolean = false;
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def")) {
            val definition: String = generateLLVMFunctionDefinition(tokens, cursor);
            if (definition.length > 0) {
                output = output + definition;
                emitted = true;
            }
        }
        val next: Int = advanceTopLevelDecl(tokens, cursor);
        if (next <= cursor) {
            cursor = cursor + 1;
        }
        else {
            cursor = skipTrivia(tokens, next);
        }
    }
    if (emitted) {
        return output;
    }
    return output +
        "define i32 @main() {\n" +
        generateLLVMMainBody(tokens) +
        "}\n";
}

def generateExecutionC(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "";
    }
    return generateMainExecutionC(tokens);
}

// ---- selfhost/src/driver.csec ----
external def csec_expand_imports(path: String): String;

def trimAscii(text: String): String {
    var start: Int = 0;
    var end: Int = text.length;
    while (start < end and isWhitespace(text.charAt(start))) {
        start = start + 1;
    }
    while (end > start and isWhitespace(text.charAt(end - 1))) {
        end = end - 1;
    }
    return text.substring(start, end - start);
}

def stringEndsWith(text: String, suffix: String): Boolean {
    if (suffix.length > text.length) {
        return false;
    }
    val start: Int = text.length - suffix.length;
    val tail: String = text.substring(start, suffix.length);
    return tail.startsWith(suffix);
}

def parentDirectory(path: String): String {
    var cursor: Int = path.length - 1;
    while (cursor >= 0) {
        val ch: Char = path.charAt(cursor);
        if (ch == '/' or ch == '\\') {
            return path.substring(0, cursor);
        }
        cursor = cursor - 1;
    }
    return ".";
}

def replaceDotsWithSlash(text: String): String {
    var cursor: Int = 0;
    var output: String = "";
    while (cursor < text.length) {
        val ch: Char = text.charAt(cursor);
        if (ch == '.') {
            output = output + "/";
        }
        else {
            output = output + "" + ch;
        }
        cursor = cursor + 1;
    }
    return output;
}

def importTargetFromLine(line: String): String {
    val trimmed: String = trimAscii(line);
    if (trimmed.startsWith("//") or !trimmed.startsWith("import")) {
        return "";
    }
    if (trimmed.length > 6) {
        val next: Char = trimmed.charAt(6);
        if (!(next == ' ' or next == '\t' or next == '"' or next == '\'')) {
            return "";
        }
    }
    var rest: String = trimAscii(trimmed.substring(6, trimmed.length - 6));
    if (rest.length > 0 and rest.charAt(rest.length - 1) == ';') {
        rest = trimAscii(rest.substring(0, rest.length - 1));
    }
    if (rest.length >= 2 and
        ((rest.charAt(0) == '"' and rest.charAt(rest.length - 1) == '"') or
         (rest.charAt(0) == '\'' and rest.charAt(rest.length - 1) == '\''))) {
        return rest.substring(1, rest.length - 2);
    }
    return rest;
}

def importCandidate(target: String): String {
    if (stringEndsWith(target, ".csec")) {
        return target;
    }
    return target + ".csec";
}

def resolveImportPath(currentPath: String, target: String): String {
    val base: String = parentDirectory(currentPath);
    val direct: String = importCandidate(target);
    val fromBase: String = base + "/" + direct;
    if (System.IO.File.Exists(fromBase)) {
        return fromBase;
    }
    if (System.IO.File.Exists(direct)) {
        return direct;
    }
    val dotted: String = importCandidate(replaceDotsWithSlash(target));
    val dottedFromBase: String = base + "/" + dotted;
    if (System.IO.File.Exists(dottedFromBase)) {
        return dottedFromBase;
    }
    return fromBase;
}

def expandImportsFromFile(path: String, seen: String): String {
    val marker: String = "|" + path + "|";
    if (seen.contains(marker)) {
        return "";
    }
    val source: String = System.IO.File.ReadAllText(path);
    if (!source.contains("import")) {
        return source;
    }
    val nextSeen: String = seen + marker;
    var cursor: Int = 0;
    var output: String = "";
    while (cursor <= source.length) {
        var lineEnd: Int = cursor;
        while (lineEnd < source.length and source.charAt(lineEnd) != '\n') {
            lineEnd = lineEnd + 1;
        }
        val line: String = source.substring(cursor, lineEnd - cursor);
        val target: String = importTargetFromLine(line);
        if (target.length > 0) {
            val importPath: String = resolveImportPath(path, target);
            if (System.IO.File.Exists(importPath)) {
                output = output + expandImportsFromFile(importPath, nextSeen) + "\n";
            }
            else {
                output = output + line;
                if (lineEnd < source.length) {
                    output = output + "\n";
                }
            }
        }
        else {
            output = output + line;
            if (lineEnd < source.length) {
                output = output + "\n";
            }
        }
        if (lineEnd >= source.length) {
            return output;
        }
        cursor = lineEnd + 1;
    }
    return output;
}

def compileSource(source: String, mode: String): String {
    val tokens: String = tokenize(source);
    if (mode.startsWith("tokenlen")) {
        return "tokens=" + tokens.length + "\n";
    }
    if (mode.startsWith("tokens")) {
        return tokens;
    }
    if (mode.startsWith("ast")) {
        return generateAST(tokens);
    }
    if (mode.startsWith("symbols")) {
        return generateSymbolTable(tokens);
    }
    if (mode.startsWith("ir")) {
        return generateIR(tokens);
    }
    if (mode.startsWith("llvm")) {
        return generateLLVMModule(tokens);
    }
    return generateExecutionC(tokens);
}

def compileFile(inputPath: String, outputPath: String, mode: String): Int {
    val source: String = csec_expand_imports(inputPath);
    val output: String = compileSource(source, mode);
    if (output.length == 0) {
        System.Console.WriteLine("compile error");
        return 1;
    }
    System.IO.File.WriteAllText(outputPath, output);
    return 0;
}

def main(): Int {
    val argc: Int = commandLineArgCount();
    if (argc >= 4) {
        return compileFile(commandLineArg(1), commandLineArg(2), commandLineArg(3));
    }
    return compileFile("selfhost/input.csec", "selfhost/out.c", "c");
}
