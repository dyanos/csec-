def validateBalanced(tokens: String): Boolean {
    var cursor: Int = 0;
    var paren: Int = 0;
    var brace: Int = 0;
    var bracket: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val kind: Char = tokenKindAt(tokens, cursor);
        val text: String = tokenTextAt(tokens, cursor);
        if (kind == kindOperator()) {
            if (strEq(text, "(")) {
                paren = paren + 1;
            }
            if (strEq(text, ")")) {
                paren = paren - 1;
            }
            if (strEq(text, "{")) {
                brace = brace + 1;
            }
            if (strEq(text, "}")) {
                brace = brace - 1;
            }
            if (strEq(text, "[")) {
                bracket = bracket + 1;
            }
            if (strEq(text, "]")) {
                bracket = bracket - 1;
            }
            if (paren < 0 or brace < 0 or bracket < 0) {
                return false;
            }
        }
        cursor = cursor + 1;
    }
    return paren == 0 and brace == 0 and bracket == 0;
}

def startsTopLevelDeclaration(tokens: String, ordinal: Int): Boolean {
    val kind: Char = tokenKindAt(tokens, ordinal);
    val text: String = tokenTextAt(tokens, ordinal);
    if (kind == kindEof()) {
        return true;
    }
    if (kind == kindOperator() and strEq(text, "[@")) {
        return true;
    }
    return kind == kindKeyword() and
        (strEq(text, "import") or strEq(text, "class") or strEq(text, "object") or
         strEq(text, "external") or strEq(text, "def") or strEq(text, "template") or
         strEq(text, "val") or strEq(text, "var") or strEq(text, "unsafe") or
         strEq(text, "unatomic") or strEq(text, "constexpr"));
}

def validateTopLevel(tokens: String): Boolean {
    var cursor: Int = skipTrivia(tokens, 0);
    var paren: Int = 0;
    var brace: Int = 0;
    var bracket: Int = 0;
    var expectingDecl: Boolean = true;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val kind: Char = tokenKindAt(tokens, cursor);
        val text: String = tokenTextAt(tokens, cursor);
        if (expectingDecl and paren == 0 and brace == 0 and bracket == 0) {
            if (!startsTopLevelDeclaration(tokens, cursor)) {
                return false;
            }
            expectingDecl = false;
        }
        if (kind == kindOperator()) {
            if (strEq(text, "(")) {
                paren = paren + 1;
            }
            if (strEq(text, ")")) {
                paren = paren - 1;
            }
            if (strEq(text, "{")) {
                brace = brace + 1;
            }
            if (strEq(text, "}")) {
                brace = brace - 1;
                if (brace == 0 and paren == 0 and bracket == 0) {
                    expectingDecl = true;
                }
            }
            if (strEq(text, "[")) {
                bracket = bracket + 1;
            }
            if (strEq(text, "]")) {
                bracket = bracket - 1;
            }
            if (strEq(text, ";") and brace == 0 and paren == 0 and bracket == 0) {
                expectingDecl = true;
            }
        }
        cursor = skipTrivia(tokens, cursor + 1);
    }
    return true;
}

def parseProgram(tokens: String): Boolean {
    if (!validateBalanced(tokens)) {
        return false;
    }
    System.IO.File.WriteAllText("selfhost/selfhost_llvm_trace.txt", "balanced");
    return validateTopLevel(tokens);
}

def topLevelDeclKind(tokens: String, ordinal: Int): String {
    val text: String = tokenTextAt(tokens, ordinal);
    if (tokenKindAt(tokens, ordinal) == kindOperator() and strEq(text, "[@")) {
        return "attribute";
    }
    if (tokenKindAt(tokens, ordinal) != kindKeyword()) {
        return "unknown";
    }
    if (strEq(text, "external")) {
        val next: String = tokenTextAt(tokens, ordinal + 1);
        if (strEq(next, "class")) { return "external-class"; }
        if (strEq(next, "object")) { return "external-object"; }
        if (strEq(next, "def")) { return "external-function"; }
        return "external";
    }
    if (strEq(text, "unsafe") or strEq(text, "unatomic") or strEq(text, "constexpr")) {
        return topLevelDeclKind(tokens, ordinal + 1);
    }
    if (strEq(text, "template")) { return "template"; }
    if (strEq(text, "import")) { return "import"; }
    if (strEq(text, "class")) { return "class"; }
    if (strEq(text, "object")) { return "object"; }
    if (strEq(text, "def")) { return "function"; }
    if (strEq(text, "val")) { return "value"; }
    if (strEq(text, "var")) { return "variable"; }
    return "unknown";
}

def topLevelDeclName(tokens: String, ordinal: Int): String {
    val kind: String = topLevelDeclKind(tokens, ordinal);
    if (strEq(kind, "external-class") or strEq(kind, "external-object") or strEq(kind, "external-function")) {
        return topLevelDeclName(tokens, ordinal + 1);
    }
    if (strEq(kind, "template")) {
        var cursor: Int = ordinal + 1;
        var depth: Int = 0;
        while (tokenKindAt(tokens, cursor) != kindEof()) {
            val text: String = tokenTextAt(tokens, cursor);
            if (strEq(text, "<")) {
                depth = depth + 1;
            }
            if (strEq(text, ">")) {
                depth = depth - 1;
                if (depth == 0) {
                    return topLevelDeclName(tokens, cursor + 1);
                }
            }
            cursor = cursor + 1;
        }
        return "<template>";
    }
    if (strEq(kind, "import")) {
        return tokenTextAt(tokens, ordinal + 1);
    }
    if (strEq(kind, "function")) {
        if (strEq(tokenTextAt(tokens, ordinal + 1), "operator")) {
            return "operator" + tokenTextAt(tokens, ordinal + 2);
        }
        return tokenTextAt(tokens, ordinal + 1);
    }
    if (strEq(kind, "class") or strEq(kind, "object") or strEq(kind, "value") or strEq(kind, "variable")) {
        return tokenTextAt(tokens, ordinal + 1);
    }
    return "<anonymous>";
}

