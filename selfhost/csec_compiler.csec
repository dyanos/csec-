                    return cursor;
                }
            }
        }
        cursor = cursor + 1;
    }
    return -1;
}

def statementKind(tokens: String, ordinal: Int): String {
    val kind: Char = tokenKindAt(tokens, ordinal);
    val text: String = tokenTextAt(tokens, ordinal);
    if (kind == kindKeyword()) {
        if (strEq(text, "return")) { return "return"; }
        if (strEq(text, "val")) { return "value"; }
        if (strEq(text, "var")) { return "variable"; }
        if (strEq(text, "if")) { return "if"; }
        if (strEq(text, "for")) { return "for"; }
        if (strEq(text, "while")) { return "while"; }
        if (strEq(text, "map")) { return "map"; }
        if (strEq(text, "pmap")) { return "pmap"; }
        if (strEq(text, "reduce")) { return "reduce"; }
        if (strEq(text, "preduce")) { return "preduce"; }
        if (strEq(text, "filter")) { return "filter"; }
        if (strEq(text, "def")) { return "function"; }
        if (strEq(text, "object")) { return "object"; }
        if (strEq(text, "unsafe")) { return "unsafe"; }
        if (strEq(text, "unatomic")) { return "unatomic"; }
        if (strEq(text, "constexpr")) { return "constexpr"; }
    }
    if (kind == kindEof()) {
        return "eof";
    }
    return "expression";
}

