        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            if (strEq(text, "(")) {
                paren = paren + 1;
            }
            else if (strEq(text, ")")) {
                paren = paren - 1;
            }
            else if (strEq(text, "{")) {
                brace = brace + 1;
            }
            else if (strEq(text, "}")) {
                brace = brace - 1;
                if (brace <= 0 and paren == 0 and bracket == 0) {
                    return cursor + 1;
                }
            }
            else if (strEq(text, "[")) {
                bracket = bracket + 1;
            }
            else if (strEq(text, "]")) {
                bracket = bracket - 1;
            }
            else if (strEq(text, ";") and brace == 0 and paren == 0 and bracket == 0) {
                return cursor + 1;
            }
        }
        cursor = cursor + 1;
    }
    return cursor;
