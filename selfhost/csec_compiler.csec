def findDeclBodyStartSlow(tokens: String, ordinal: Int): Int {
    var cursor: Int = ordinal;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (cursor > ordinal and startsTopLevelDeclaration(tokens, cursor)) {
