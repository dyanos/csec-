def main(): Int {
    val seed: Int = 1;
    val ratio: Double = 2.5;
    var enabled: Boolean = true;
    var current: Int = seed + 6;
    var flags: Int = (current << 1) | 3;
    flags = flags & 7;
    flags += 1;
    flags -= 1;
    if (enabled and current > 0) {
        current = current + 0;
    }
    else {
        current = current + 1;
    }
    while (flags > 0) {
        flags = flags - 1;
    }
    return 7;
}
