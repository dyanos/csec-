external def csec_string_builder_new(): Long;
external def csec_string_builder_append(builder: Long, text: String): Int;
external def csec_string_builder_finish(builder: Long): String;
external def csec_string_builder_write_to_file(builder: Long, path: String): Int;
external def csec_llvm_string_literal_bytes(text: String): String;
external def csec_enclosing_function_decl_start(tokens: String, limit: Int): Int;
external def csec_enclosing_function_body_start(tokens: String, limit: Int): Int;
external def csec_enclosing_function_body_end(tokens: String, limit: Int): Int;
external def csec_llvm_lexer_helper_definition(name: String): String;

def parseReturnIntegerInRange(tokens: String, start: Int, end: Int): Int {
    var cursor: Int = start;
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "return") and
            tokenKindAt(tokens, cursor + 1) == kindInteger()) {
            return toInt(tokenTextAt(tokens, cursor + 1));
        }
        cursor = cursor + 1;
    }
    return 0;
}

def appendCExpression(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    var cursor: Int = start;
    var output: String = "";
    while (cursor < end and tokenKindAt(tokens, cursor) != kindEof()) {
        val text: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindKeyword() and strEq(text, "and")) {
            output = output + "&&";
        }
        else if (tokenKindAt(tokens, cursor) == kindKeyword() and strEq(text, "or")) {
            output = output + "||";
        }
        else if (tokenKindAt(tokens, cursor) == kindKeyword() and strEq(text, "xor")) {
            output = output + "^";
        }
        else {
            output = output + text;
        }
        if (cursor + 1 < end) {
            output = output + " ";
        }
        cursor = cursor + 1;
    }
    return output;
}

def cTypeName(typeName: String): String {
    if (strEq(typeName, "Boolean")) { return "int"; }
    if (strEq(typeName, "Char")) { return "char"; }
    if (strEq(typeName, "Int")) { return "int"; }
    if (strEq(typeName, "Long")) { return "long long"; }
    if (strEq(typeName, "Float")) { return "float"; }
    if (strEq(typeName, "Double")) { return "double"; }
    if (strEq(typeName, "String")) { return "const char*"; }
    if (strEq(typeName, "Regex")) { return "const char*"; }
    if (typeName.startsWith("Array")) { return "void*"; }
    if (strEq(typeName, "Unit")) { return "void"; }
    return "void*";
}

def generateCBody(tokens: String, bodyStart: Int, bodyEnd: Int, indent: String): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            output = output + indent + "return " + appendCExpression(tokens, cursor + 1, next) + ";\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            val initializer: Int = findTopLevelOperator(tokens, cursor, next, 1);
            var typeName: String = declaredLocalType(tokens, cursor, next);
            if (initializer >= cursor) {
                if (typeName.length == 0) {
                    typeName = inferExpressionType(tokens, initializer + 1, next);
                }
                output = output + indent + cTypeName(typeName) + " " + tokenTextAt(tokens, cursor + 1) + " = " +
                    appendCExpression(tokens, initializer + 1, next) + ";\n";
            }
            else {
                if (typeName.length == 0) {
                    typeName = "Int";
                }
                output = output + indent + cTypeName(typeName) + " " + tokenTextAt(tokens, cursor + 1) + " = 0;\n";
            }
        }
        else if (strEq(kind, "if") or strEq(kind, "while")) {
            val openParen: Int = findTokenTextInRange(tokens, cursor, next, "(");
            val closeParen: Int = findClosingToken(tokens, openParen, next, "(", ")");
            val openBrace: Int = findTokenTextInRange(tokens, closeParen + 1, next, "{");
            val closeBrace: Int = findClosingToken(tokens, openBrace, next, "{", "}");
            if (openParen >= cursor and closeParen > openParen and openBrace > closeParen and closeBrace > openBrace) {
                output = output + indent + kind + " (" + appendCExpression(tokens, openParen + 1, closeParen) + ") {\n" +
                    generateCBody(tokens, openBrace + 1, closeBrace, indent + "    ") +
                    indent + "}\n";
                if (strEq(kind, "if")) {
                    val possibleElse: Int = skipTrivia(tokens, closeBrace + 1);
                    if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                        val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                        if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                            val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                            if (elseEnd > elseStart) {
                                output = output + indent + "else {\n" +
                                    generateCBody(tokens, elseStart + 1, elseEnd, indent + "    ") +
                                    indent + "}\n";
                            }
                        }
                    }
                }
            }
        }
        else if (strEq(kind, "for")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val blockStart: Int = findStatementBlockStart(tokens, cursor, next);
            val blockEnd: Int = findStatementBlockEnd(tokens, cursor, next);
            val sourceArrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
            val rangeOp: Int = findTopLevelOperator(tokens, sourceArrow + 1, closeParen, 5);
            if (openParen >= cursor and closeParen > openParen and blockStart > closeParen and
                blockEnd > blockStart and tokenKindAt(tokens, openParen + 1) == kindIdentifier() and
                sourceArrow > openParen and rangeOp > sourceArrow) {
                var compareOp: String = " < ";
                if (strEq(tokenTextAt(tokens, rangeOp), "to") or strEq(tokenTextAt(tokens, rangeOp), "..")) {
                    compareOp = " <= ";
                }
                val iteratorName: String = tokenTextAt(tokens, openParen + 1);
                output = output + indent + "for (int " + iteratorName + " = " +
                    appendCExpression(tokens, sourceArrow + 1, rangeOp) + "; " +
                    iteratorName + compareOp + appendCExpression(tokens, rangeOp + 1, closeParen) +
                    "; " + iteratorName + "++) {\n" +
                    generateCBody(tokens, blockStart + 1, blockEnd, indent + "    ") +
                    indent + "}\n";
            }
            else {
                output = output + indent + "/* for (" + statementHeaderExpression(tokens, cursor, next) + ") */\n";
                if (blockStart >= 0 and blockEnd > blockStart) {
                    output = output + generateCBody(tokens, blockStart + 1, blockEnd, indent);
                }
            }
        }
        else if (strEq(kind, "map") or strEq(kind, "pmap") or
            strEq(kind, "reduce") or strEq(kind, "preduce") or strEq(kind, "filter")) {
            val blockStart: Int = findStatementBlockStart(tokens, cursor, next);
            val blockEnd: Int = findStatementBlockEnd(tokens, cursor, next);
            output = output + indent + "/* " + kind + " (" + statementHeaderExpression(tokens, cursor, next) + ") */\n";
            if (blockStart >= 0 and blockEnd > blockStart) {
                output = output + generateCBody(tokens, blockStart + 1, blockEnd, indent);
            }
        }
        else {
            output = output + indent + appendCExpression(tokens, cursor, next) + ";\n";
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateCStatement(tokens: String, start: Int, end: Int, indent: String): String {
    val kind: String = statementKind(tokens, start);
    if (strEq(kind, "return")) {
        return indent + "return " + appendCExpression(tokens, start + 1, end) + ";\n";
    }
    if (strEq(kind, "value") or strEq(kind, "variable")) {
        val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
        var typeName: String = declaredLocalType(tokens, start, end);
        if (initializer >= start) {
            if (typeName.length == 0) {
                typeName = inferExpressionType(tokens, initializer + 1, end);
            }
            return indent + cTypeName(typeName) + " " + tokenTextAt(tokens, start + 1) + " = " +
                appendCExpression(tokens, initializer + 1, end) + ";\n";
        }
        if (typeName.length == 0) {
            typeName = "Int";
        }
        return indent + cTypeName(typeName) + " " + tokenTextAt(tokens, start + 1) + " = 0;\n";
    }
    if (strEq(kind, "if") or strEq(kind, "while") or strEq(kind, "for") or
        strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
        strEq(kind, "preduce") or strEq(kind, "filter")) {
        return indent + "/* unsupported nested block */\n";
    }
    return indent + appendCExpression(tokens, start, end) + ";\n";
}

def parseMainReturnInt(tokens: String): Int {
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def") and
            tokenIs(tokens, cursor + 1, kindIdentifier(), "main") and
            tokenIs(tokens, cursor + 2, kindOperator(), "(") and
            tokenIs(tokens, cursor + 3, kindOperator(), ")") and
            tokenIs(tokens, cursor + 4, kindOperator(), ":") and
            strEq(tokenTextAt(tokens, cursor + 5), "Int") and
            tokenIs(tokens, cursor + 6, kindOperator(), "{") and
            tokenKindAt(tokens, cursor + 7) != kindEof()) {
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                return parseReturnIntegerInRange(tokens, bodyStart, bodyEnd);
            }
        }
        cursor = cursor + 1;
    }
    return 0;
}

def generateMainExecutionC(tokens: String): String {
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def") and
            tokenIs(tokens, cursor + 1, kindIdentifier(), "main") and
            tokenIs(tokens, cursor + 2, kindOperator(), "(") and
            tokenIs(tokens, cursor + 3, kindOperator(), ")") and
            tokenIs(tokens, cursor + 4, kindOperator(), ":") and
            strEq(tokenTextAt(tokens, cursor + 5), "Int")) {
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                return "int main(int argc, char** argv) {\n" +
                    "    (void)argc;\n" +
                    "    (void)argv;\n" +
                    generateCBody(tokens, bodyStart, bodyEnd, "    ") +
                    "    return 0;\n" +
                    "}\n";
            }
        }
        cursor = cursor + 1;
    }
    return "";
}

def irTypeName(typeName: String): String {
    if (strEq(typeName, "Boolean")) { return "i1"; }
    if (strEq(typeName, "Char")) { return "i8"; }
    if (strEq(typeName, "Int")) { return "i32"; }
    if (strEq(typeName, "Long")) { return "i64"; }
    if (strEq(typeName, "Float")) { return "float"; }
    if (strEq(typeName, "Double")) { return "double"; }
    if (strEq(typeName, "Unit")) { return "void"; }
    if (strEq(typeName, "String")) { return "ptr"; }
    if (strEq(typeName, "Regex")) { return "ptr"; }
    if (strEq(typeName, "Range")) { return "ptr"; }
    if (typeName.startsWith("Array")) { return "ptr"; }
    if (typeName.length == 0) { return "ptr"; }
    return "ptr";
}

def irOperatorName(text: String): String {
    if (strEq(text, "+")) { return "add"; }
    if (strEq(text, "-")) { return "sub"; }
    if (strEq(text, "*")) { return "mul"; }
    if (strEq(text, "/")) { return "sdiv"; }
    if (strEq(text, "%")) { return "srem"; }
    if (strEq(text, "<<")) { return "shl"; }
    if (strEq(text, ">>")) { return "ashr"; }
    if (strEq(text, "&")) { return "and"; }
    if (strEq(text, "|")) { return "or"; }
    if (strEq(text, "^") or strEq(text, "xor")) { return "xor"; }
    if (strEq(text, "and") or strEq(text, "&&")) { return "and"; }
    if (strEq(text, "or") or strEq(text, "||")) { return "or"; }
    if (strEq(text, "==")) { return "icmp_eq"; }
    if (strEq(text, "!=")) { return "icmp_ne"; }
    if (strEq(text, "<")) { return "icmp_slt"; }
    if (strEq(text, "<=")) { return "icmp_sle"; }
    if (strEq(text, ">")) { return "icmp_sgt"; }
    if (strEq(text, ">=")) { return "icmp_sge"; }
    if (strEq(text, "..")) { return "range"; }
    if (strEq(text, "to")) { return "range_to"; }
    if (strEq(text, "until")) { return "range_until"; }
    if (strEq(text, "@")) { return "matmul"; }
    if (strEq(text, "inner")) { return "inner"; }
    if (strEq(text, "outer")) { return "outer"; }
    if (strEq(text, "tensor")) { return "tensor"; }
    return text;
}

def expressionTopLevelOperator(tokens: String, start: Int, end: Int): Int {
    var op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 2);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 3);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 8);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 9);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 4);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 10);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 5);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 6);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 7);
    if (op >= start) { return op; }
    op = findTopLevelOperator(tokens, start, end, 11);
    if (op >= start) { return op; }
    return -1;
}

def generateIRExpression(tokens: String, rawStart: Int, rawEnd: Int): String {
    val start: Int = skipTrivia(tokens, rawStart);
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "void";
    }
    val typeName: String = inferExpressionType(tokens, start, end);
    val irType: String = irTypeName(typeName);
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start) {
        return irOperatorName(tokenTextAt(tokens, op)) + " " + irType + " (" +
            appendExpressionUntil(tokens, start, op) + "), (" +
            appendExpressionUntil(tokens, op + 1, end) + ")";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and
        start + 1 < end and tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return "call " + irType + " @" + tokenTextAt(tokens, start) + "(" +
            appendExpressionUntil(tokens, start + 2, end - 1) + ")";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "load " + irType + ", ptr %" + tokenTextAt(tokens, start);
    }
    return irType + " " + appendExpressionUntil(tokens, start, end);
}

def generateIRAssignment(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val opText: String = tokenTextAt(tokens, op);
    val rhs: String = generateIRExpression(tokens, op + 1, end);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        return "    store " + rhs + ", ptr %" + name + "\n";
    }
    val typeName: String = inferExpressionType(tokens, op + 1, end);
    val irType: String = irTypeName(typeName);
    var binaryOp: String = opText.substring(0, 1);
    if (strEq(opText, "%=")) {
        binaryOp = "%";
    }
    return "    %old." + name + " = load " + irType + ", ptr %" + name + "\n" +
        "    %new." + name + " = " + irOperatorName(binaryOp) + " " + irType +
        " %old." + name + ", (" + appendExpressionUntil(tokens, op + 1, trimExpressionEnd(tokens, op + 1, end)) + ")\n" +
        "    store " + irType + " %new." + name + ", ptr %" + name + "\n";
}

def generateIRParamList(tokens: String, declStart: Int): String {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return "";
    }
    val paramEnd: Int = csec_function_param_end(tokens, declStart);
    var cursor: Int = paramStart + 1;
    var output: String = "";
    var first: Boolean = true;
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            var typeName: String = "unknown";
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                typeName = collectTypeName(tokens, cursor + 2, paramEnd);
            }
            if (!first) {
                output = output + ", ";
            }
            output = output + irTypeName(typeName) + " %" + tokenTextAt(tokens, cursor);
            first = false;
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        if (tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
    }
    return output;
}

def generateIRFlatBody(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            output = output + "    ret " + generateIRExpression(tokens, cursor + 1, next) + "\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            val initializer: Int = findTopLevelOperator(tokens, cursor, next, 1);
            if (initializer >= cursor) {
                val localType: String = inferExpressionType(tokens, initializer + 1, next);
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca " +
                    irTypeName(localType) + "\n" +
                    "    store " + generateIRExpression(tokens, initializer + 1, next) +
                    ", ptr %" + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            else {
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca ptr\n";
            }
        }
        else if (strEq(kind, "if") or strEq(kind, "while") or strEq(kind, "for") or
            strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
            strEq(kind, "preduce") or strEq(kind, "filter")) {
            output = output + "    ; nested block " + kind + " (" +
                statementHeaderExpression(tokens, cursor, next) + ")\n";
        }
        else {
            val assignmentIR: String = generateIRAssignment(tokens, cursor, next);
            if (assignmentIR.length > 0) {
                output = output + assignmentIR;
            }
            else {
                output = output + "    " + generateIRExpression(tokens, cursor, next) + "\n";
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateIRElseFlatBody(tokens: String, possibleElse: Int, end: Int, hasElse: Boolean): String {
    if (!hasElse) {
        return "    ; no else body\n";
    }
    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
    if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
        val elseEnd: Int = findClosingToken(tokens, elseStart, end, "{", "}");
        if (elseEnd > elseStart) {
            return generateIRFlatBody(tokens, elseStart + 1, elseEnd);
        }
    }
    if (tokenIs(tokens, elseStart, kindKeyword(), "if")) {
        return "    ; else-if body\n";
    }
    return "    ; malformed else body\n";
}

def generateIRIf(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val thenStart: Int = findStatementBlockStart(tokens, start, end);
    val thenEnd: Int = findClosingToken(tokens, thenStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
        return "    ; malformed if\n";
    }
    val labelSeed: String = "" + start;
    val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
    var hasElse: Boolean = false;
    if (possibleElse < end and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
        hasElse = true;
    }
    return "    %cond." + labelSeed + " = " +
        generateIRExpression(tokens, openParen + 1, closeParen) + "\n" +
        "    br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
        ", label %if.else." + labelSeed + "\n" +
        "if.then." + labelSeed + ":\n" +
        generateIRFlatBody(tokens, thenStart + 1, thenEnd) +
        "    br label %if.end." + labelSeed + "\n" +
        "if.else." + labelSeed + ":\n" +
        generateIRElseFlatBody(tokens, possibleElse, end, hasElse) +
        "    br label %if.end." + labelSeed + "\n" +
        "if.end." + labelSeed + ":\n";
}

def generateIRWhile(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "    ; malformed while\n";
    }
    val labelSeed: String = "" + start;
    return "    br label %while.cond." + labelSeed + "\n" +
        "while.cond." + labelSeed + ":\n" +
        "    %whilecond." + labelSeed + " = " +
        generateIRExpression(tokens, openParen + 1, closeParen) + "\n" +
        "    br i1 %whilecond." + labelSeed + ", label %while.body." + labelSeed +
        ", label %while.end." + labelSeed + "\n" +
        "while.body." + labelSeed + ":\n" +
        generateIRFlatBody(tokens, bodyStart + 1, bodyEnd) +
        "    br label %while.cond." + labelSeed + "\n" +
        "while.end." + labelSeed + ":\n";
}

def generateIRFor(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "    ; malformed for\n";
    }
    val iteratorName: String = tokenTextAt(tokens, openParen + 1);
    val arrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
    if (arrow < 0) {
        return "    ; malformed for source\n";
    }
    val labelSeed: String = "" + start;
    return "    ; for source " + generateIRExpression(tokens, arrow + 1, closeParen) + "\n" +
        "    %" + iteratorName + " = alloca ptr\n" +
        "    br label %for.cond." + labelSeed + "\n" +
        "for.cond." + labelSeed + ":\n" +
        "    ; iterator next " + iteratorName + "\n" +
        "    br i1 %for.hasnext." + labelSeed + ", label %for.body." + labelSeed +
        ", label %for.end." + labelSeed + "\n" +
        "for.body." + labelSeed + ":\n" +
        generateIRFlatBody(tokens, bodyStart + 1, bodyEnd) +
        "    br label %for.cond." + labelSeed + "\n" +
        "for.end." + labelSeed + ":\n";
}

def generateIRBody(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor >= 0 and cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            output = output + "    ret " + generateIRExpression(tokens, cursor + 1, next) + "\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            val initializer: Int = findTopLevelOperator(tokens, cursor, next, 1);
            if (initializer >= cursor) {
                val localType: String = inferExpressionType(tokens, initializer + 1, next);
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca " +
                    irTypeName(localType) + "\n" +
                    "    store " + generateIRExpression(tokens, initializer + 1, next) +
                    ", ptr %" + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            else {
                output = output + "    %" + tokenTextAt(tokens, cursor + 1) + " = alloca ptr\n";
            }
        }
        else if (strEq(kind, "if")) {
            output = output + generateIRIf(tokens, cursor, next);
        }
        else if (strEq(kind, "while")) {
            output = output + generateIRWhile(tokens, cursor, next);
        }
        else if (strEq(kind, "for")) {
            output = output + generateIRFor(tokens, cursor, next);
        }
        else if (strEq(kind, "map") or strEq(kind, "pmap") or strEq(kind, "reduce") or
            strEq(kind, "preduce") or strEq(kind, "filter")) {
            output = output + "    ; block " + kind + " (" + statementHeaderExpression(tokens, cursor, next) + ")\n";
        }
        else {
            val assignmentIR: String = generateIRAssignment(tokens, cursor, next);
            if (assignmentIR.length > 0) {
                output = output + assignmentIR;
            }
            else {
                output = output + "    " + generateIRExpression(tokens, cursor, next) + "\n";
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return output;
}

def generateIRDeclarations(tokens: String): String {
    var output: String = "";
    var cursor: Int = skipTrivia(tokens, 0);
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        val kind: String = topLevelDeclKind(tokens, cursor);
        val name: String = topLevelDeclName(tokens, cursor);
        if (strEq(kind, "function") or strEq(kind, "external-function")) {
            output = output + "define " + irTypeName(functionReturnType(tokens, cursor)) +
                " @" + name + "(" + generateIRParamList(tokens, cursor) + ")\n";
            val bodyStart: Int = findDeclBodyStart(tokens, cursor);
            val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
            if (bodyStart >= 0 and bodyEnd >= bodyStart) {
                output = output + generateIRBody(tokens, bodyStart, bodyEnd);
            }
            output = output + "end define\n";
        }
        else if (strEq(kind, "class") or strEq(kind, "object") or strEq(kind, "external-class") or
            strEq(kind, "external-object")) {
            output = output + "%type." + name + " = type opaque ; " + kind + "\n";
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            output = output + "@" + name + " = global ptr null ; " + kind + "\n";
        }
        cursor = skipTrivia(tokens, advanceTopLevelDecl(tokens, cursor));
    }
    return output;
}

def generateIR(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "error: parse failed\n";
    }
    val returnValue: Int = parseMainReturnInt(tokens);
    return "module csec.selfhost\n" +
        generateSymbolTable(tokens) +
        "entry main\n" +
        "lowering llvm-text\n" +
        generateIRDeclarations(tokens) +
        "main.return " + returnValue + "\n";
}

def generateLLVMMainBody(tokens: String): String {
    val returnValue: Int = parseMainReturnInt(tokens);
    return "entry:\n" +
        "  ret i32 " + returnValue + "\n";
}

def llvmCharI8Value(text: String): String {
    if (text.length == 0) { return "0"; }
    val ch: Char = text.charAt(0);
    if (ch == 'I') { return "73"; }
    if (ch == 'K') { return "75"; }
    if (ch == 'N') { return "78"; }
    if (ch == 'F') { return "70"; }
    if (ch == 'S') { return "83"; }
    if (ch == 'R') { return "82"; }
    if (ch == 'C') { return "67"; }
    if (ch == 'B') { return "66"; }
    if (ch == 'O') { return "79"; }
    if (ch == 'M') { return "77"; }
    if (ch == 'E') { return "69"; }
    if (ch == 'x') { return "120"; }
    if (ch == 'y') { return "121"; }
    if (ch == 'z') { return "122"; }
    if (ch == 'a') { return "97"; }
    if (ch == 't') { return "116"; }
    if (ch == 'u') { return "117"; }
    if (ch == '0') { return "48"; }
    if (ch == '1') { return "49"; }
    if (ch == '2') { return "50"; }
    if (ch == '3') { return "51"; }
    if (ch == '4') { return "52"; }
    if (ch == '5') { return "53"; }
    if (ch == '6') { return "54"; }
    if (ch == '7') { return "55"; }
    if (ch == '8') { return "56"; }
    if (ch == '9') { return "57"; }
    if (ch == '_') { return "95"; }
    if (ch == ' ') { return "32"; }
    if (ch == '"') { return "34"; }
    if (ch == '\\' and text.length > 1 and text.charAt(1) == '\\') { return "92"; }
    if (ch == '\\' and text.length > 1 and text.charAt(1) == 'n') { return "10"; }
    if (ch == '\\' and text.length > 1 and text.charAt(1) == 't') { return "9"; }
    return "0";
}

def llvmI32Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return llvmCharI8Value(tokenTextAt(tokens, start));
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".val." + start;
    }
    return "%tmp";
}

def lookupFunctionParamType(tokens: String, limit: Int, name: String): String {
    val decl: Int = csec_enclosing_function_decl_start(tokens, limit);
    if (decl < 0) {
        return "unknown";
    }
    val paramStart: Int = findFunctionParamStart(tokens, decl);
    if (paramStart < 0) {
        return "unknown";
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, decl), "(", ")");
    if (paramEnd <= paramStart) {
        return "unknown";
    }
    var cursor: Int = paramStart + 1;
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier() and strEq(tokenTextAt(tokens, cursor), name)) {
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                return typeSummary(tokens, cursor + 2, paramEnd);
            }
            return "unknown";
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return "unknown";
}

def lookupVisibleValueType(tokens: String, limit: Int, name: String): String {
    val paramType: String = lookupFunctionParamType(tokens, limit, name);
    if (!strEq(paramType, "unknown")) {
        return paramType;
    }
    val functionStart: Int = csec_enclosing_function_body_start(tokens, limit);
    val functionEnd: Int = csec_enclosing_function_body_end(tokens, limit);
    var cursor: Int = functionStart;
    if (cursor < 0) {
        cursor = 0;
    }
    var found: String = "";
    while (cursor < limit and (functionEnd < 0 or cursor < functionEnd) and tokenKindAt(tokens, cursor) != kindEof()) {
        if ((tokenIs(tokens, cursor, kindKeyword(), "val") or
            tokenIs(tokens, cursor, kindKeyword(), "var")) and
            tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
            strEq(tokenTextAt(tokens, cursor + 1), name)) {
            val next: Int = advanceStatement(tokens, cursor, limit);
            if (next > cursor) {
                found = localDeclarationType(tokens, cursor, next);
                cursor = next;
            }
            else {
                cursor = cursor + 1;
            }
        }
        else {
            cursor = cursor + 1;
        }
    }
    if (found.length == 0) {
        return "unknown";
    }
    return found;
}

def lookupVisibleStorageName(tokens: String, limit: Int, name: String): String {
    val functionStart: Int = csec_enclosing_function_body_start(tokens, limit);
    val functionEnd: Int = csec_enclosing_function_body_end(tokens, limit);
    if (functionStart < 0) {
        var fallback: Int = limit - 1;
        while (fallback >= 0) {
            if ((tokenIs(tokens, fallback, kindKeyword(), "val") or
                tokenIs(tokens, fallback, kindKeyword(), "var")) and
                tokenKindAt(tokens, fallback + 1) == kindIdentifier() and
                strEq(tokenTextAt(tokens, fallback + 1), name)) {
                return name + ".addr." + fallback;
            }
            fallback = fallback - 1;
        }
        return name;
    }
    var cursor: Int = functionStart;
    var found: String = "";
    while (cursor < limit and cursor < functionEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if ((tokenIs(tokens, cursor, kindKeyword(), "val") or
            tokenIs(tokens, cursor, kindKeyword(), "var")) and
            tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
            strEq(tokenTextAt(tokens, cursor + 1), name)) {
            found = name + ".addr." + cursor;
            cursor = advanceStatement(tokens, cursor, functionEnd);
        }
        else {
            cursor = cursor + 1;
        }
    }
    if (found.length == 0) {
        var fallback: Int = limit - 1;
        while (fallback >= functionStart) {
            if ((tokenIs(tokens, fallback, kindKeyword(), "val") or
                tokenIs(tokens, fallback, kindKeyword(), "var")) and
                tokenKindAt(tokens, fallback + 1) == kindIdentifier() and
                strEq(tokenTextAt(tokens, fallback + 1), name)) {
                return name + ".addr." + fallback;
            }
            fallback = fallback - 1;
        }
        return name;
    }
    return found;
}

def llvmLoadForValueType(tokens: String, limit: Int, name: String, valueType: String, resultName: String): String {
    val storageName: String = lookupVisibleStorageName(tokens, limit, name);
    if (strEq(valueType, "Boolean")) {
        return "  " + resultName + " = load i1, ptr %" + storageName + "\n";
    }
    if (strEq(valueType, "Char")) {
        return "  " + resultName + " = load i8, ptr %" + storageName + "\n";
    }
    if (strEq(valueType, "Double")) {
        return "  " + resultName + " = load double, ptr %" + storageName + "\n";
    }
    if (strEq(valueType, "Long")) {
        return "  " + resultName + " = load i64, ptr %" + storageName + "\n";
    }
    if (strEq(irTypeName(valueType), "ptr")) {
        return "  " + resultName + " = load ptr, ptr %" + storageName + "\n";
    }
    return "  " + resultName + " = load i32, ptr %" + storageName + "\n";
}

def generateLLVMLoadIfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        val valueType: String = lookupVisibleValueType(tokens, start, name);
        if (strEq(valueType, "Char")) {
            return "  %" + name + ".cval." + start + " = load i8, ptr %" + storageName + "\n" +
                "  %" + name + ".val." + start + " = zext i8 %" + name + ".cval." + start + " to i32\n";
        }
        return "  %" + name + ".val." + start + " = load i32, ptr %" + storageName + "\n";
    }
    return "";
}

def llvmI1Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "false";
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".bval";
    }
    return "%btmp";
}

def generateLLVMLoadBoolIfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        return "  %" + name + ".bval = load i1, ptr %" + storageName + "\n";
    }
    return "";
}

def llvmI32CallArgumentValue(tokens: String, start: Int, rawEnd: Int, resultName: String, index: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    return resultName + ".arg" + index;
}

def llvmCallArgumentType(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "i32";
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        return "ptr";
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return "i8";
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        return "i1";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val valueType: String = lookupVisibleValueType(tokens, start, tokenTextAt(tokens, start));
        val llvmType: String = irTypeName(valueType);
        if (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or strEq(llvmType, "i1") or
            strEq(llvmType, "i64") or strEq(llvmType, "double")) {
            return llvmType;
        }
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        val returnType: String = irTypeName(lookupFunctionReturnType(tokens, tokenTextAt(tokens, start)));
        if (strEq(returnType, "ptr") or strEq(returnType, "i8") or strEq(returnType, "i1") or
            strEq(returnType, "i64") or strEq(returnType, "double")) {
            return returnType;
        }
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        if (strEq(tokenTextAt(tokens, op), "+") and
            (strEq(llvmCallArgumentType(tokens, start, op), "ptr") or
             strEq(llvmCallArgumentType(tokens, op + 1, end), "ptr"))) {
            return "ptr";
        }
    }
    return "i32";
}

def llvmCallArgumentValue(tokens: String, start: Int, rawEnd: Int, resultName: String, index: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return llvmCharI8Value(tokenTextAt(tokens, start));
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    return resultName + ".arg" + index;
}

def generateLLVMCallArgumentLoadI32(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = add i32 0, 0\n";
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        val text: String = tokenTextAt(tokens, start);
        val byteLength: Int = text.length + 1;
        return "  " + resultName + " = getelementptr inbounds [" + byteLength +
            " x i8], ptr @.str." + start + ", i32 0, i32 0\n";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + llvmCharI8Value(tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val valueType: String = lookupVisibleValueType(tokens, start, name);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        val llvmType: String = irTypeName(valueType);
        if (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or strEq(llvmType, "i1") or
            strEq(llvmType, "i64") or strEq(llvmType, "double")) {
            return "  " + resultName + " = load " + llvmType + ", ptr %" + storageName + "\n";
        }
        return "  " + resultName + " = load i32, ptr %" + storageName + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        val callee: String = tokenTextAt(tokens, start);
        val returnType: String = irTypeName(lookupFunctionReturnType(tokens, callee));
        if (strEq(returnType, "ptr") and strEq(callee, "commandLineArg")) {
            return generateLLVMCallArgumentLoadI32(tokens, start + 2, end - 1, resultName + ".arg0") +
                "  " + resultName + " = call ptr @csec_command_line_arg(i32 " + resultName + ".arg0)\n";
        }
        if (strEq(returnType, "ptr") and strEq(callee, "tokenTextAt")) {
            val comma: Int = findTokenTextInRange(tokens, start + 2, end - 1, ",");
            if (comma > start + 2) {
                return generateLLVMCallArgumentLoadI32(tokens, start + 2, comma, resultName + ".arg0") +
                    generateLLVMCallArgumentLoadI32(tokens, comma + 1, end - 1, resultName + ".arg1") +
                    "  " + resultName + " = call ptr @csec_token_text_at(ptr " + resultName + ".arg0, i32 " +
                    resultName + ".arg1)\n";
            }
        }
        if (strEq(returnType, "i8") and start + 2 == end - 1) {
            return "  " + resultName + " = call i8 @" + callee + "()\n";
        }
        if (strEq(returnType, "ptr")) {
            val argsStart: Int = start + 2;
            val argsEnd: Int = end - 1;
            if (skipTrivia(tokens, argsStart) >= argsEnd) {
                return "  " + resultName + " = call ptr @" + callee + "()\n";
            }
            val comma1: Int = findTokenTextInRange(tokens, argsStart, argsEnd, ",");
            if (comma1 < argsStart) {
                return generateLLVMCallArgumentLoadI32(tokens, argsStart, argsEnd, resultName + ".arg0") +
                    "  " + resultName + " = call ptr @" + callee + "(" +
                    llvmCallArgumentType(tokens, argsStart, argsEnd) + " " + resultName + ".arg0)\n";
            }
            val arg1Start: Int = skipTrivia(tokens, comma1 + 1);
            val comma2: Int = findTokenTextInRange(tokens, arg1Start, argsEnd, ",");
            if (comma2 < arg1Start) {
                return generateLLVMCallArgumentLoadI32(tokens, argsStart, comma1, resultName + ".arg0") +
                    generateLLVMCallArgumentLoadI32(tokens, arg1Start, argsEnd, resultName + ".arg1") +
                    "  " + resultName + " = call ptr @" + callee + "(" +
                    llvmCallArgumentType(tokens, argsStart, comma1) + " " + resultName + ".arg0, " +
                    llvmCallArgumentType(tokens, arg1Start, argsEnd) + " " + resultName + ".arg1)\n";
            }
            val arg2Start: Int = skipTrivia(tokens, comma2 + 1);
            val comma3: Int = findTokenTextInRange(tokens, arg2Start, argsEnd, ",");
            if (comma3 < arg2Start) {
                return generateLLVMCallArgumentLoadI32(tokens, argsStart, comma1, resultName + ".arg0") +
                    generateLLVMCallArgumentLoadI32(tokens, arg1Start, comma2, resultName + ".arg1") +
                    generateLLVMCallArgumentLoadI32(tokens, arg2Start, argsEnd, resultName + ".arg2") +
                    "  " + resultName + " = call ptr @" + callee + "(" +
                    llvmCallArgumentType(tokens, argsStart, comma1) + " " + resultName + ".arg0, " +
                    llvmCallArgumentType(tokens, arg1Start, comma2) + " " + resultName + ".arg1, " +
                    llvmCallArgumentType(tokens, arg2Start, argsEnd) + " " + resultName + ".arg2)\n";
            }
            val arg3Start: Int = skipTrivia(tokens, comma3 + 1);
            return generateLLVMCallArgumentLoadI32(tokens, argsStart, comma1, resultName + ".arg0") +
                generateLLVMCallArgumentLoadI32(tokens, arg1Start, comma2, resultName + ".arg1") +
                generateLLVMCallArgumentLoadI32(tokens, arg2Start, comma3, resultName + ".arg2") +
                generateLLVMCallArgumentLoadI32(tokens, arg3Start, argsEnd, resultName + ".arg3") +
                "  " + resultName + " = call ptr @" + callee + "(" +
                llvmCallArgumentType(tokens, argsStart, comma1) + " " + resultName + ".arg0, " +
                llvmCallArgumentType(tokens, arg1Start, comma2) + " " + resultName + ".arg1, " +
                llvmCallArgumentType(tokens, arg2Start, comma3) + " " + resultName + ".arg2, " +
                llvmCallArgumentType(tokens, arg3Start, argsEnd) + " " + resultName + ".arg3)\n";
        }
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 4 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "charAt") and
        tokenIs(tokens, start + 3, kindOperator(), "(") and
        findClosingToken(tokens, start + 3, end, "(", ")") == end - 1) {
        val name: String = tokenTextAt(tokens, start);
        val indexStart: Int = skipTrivia(tokens, start + 4);
        val indexEnd: Int = trimExpressionEnd(tokens, indexStart, end - 1);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        var output: String = "  " + resultName + ".obj = load ptr, ptr %" + storageName + "\n";
        if (tokenKindAt(tokens, indexStart) == kindInteger() and indexEnd == indexStart + 1) {
            output = output + "  " + resultName + ".index = add i32 0, " + tokenTextAt(tokens, indexStart) + "\n";
        }
        else if (tokenKindAt(tokens, indexStart) == kindIdentifier() and indexEnd == indexStart + 1) {
            output = output + "  " + resultName + ".index = load i32, ptr %" +
                lookupVisibleStorageName(tokens, indexStart, tokenTextAt(tokens, indexStart)) + "\n";
        }
        else {
            output = output + "  " + resultName + ".index = add i32 0, 0\n";
        }
        return output +
            "  " + resultName + ".i8 = call i8 @csec_string_char_at(ptr " + resultName + ".obj, i32 " + resultName + ".index)\n" +
            "  " + resultName + " = zext i8 " + resultName + ".i8 to i32\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        if (strEq(tokenTextAt(tokens, op), "+") and
            (strEq(llvmCallArgumentType(tokens, start, op), "ptr") or
             strEq(llvmCallArgumentType(tokens, op + 1, end), "ptr"))) {
            val rightStart: Int = skipTrivia(tokens, op + 1);
            var leftCode: String = "";
            var rightCode: String = "";
            if (strEq(llvmCallArgumentType(tokens, start, op), "ptr")) {
                leftCode = generateLLVMCallArgumentLoadI32(tokens, start, op, resultName + ".left");
            }
            else if (tokenKindAt(tokens, start) == kindChar() and trimExpressionEnd(tokens, start, op) == start + 1) {
                leftCode = "  " + resultName + ".left = call ptr @csec_to_string_char(i8 " +
                    llvmCharI8Value(tokenTextAt(tokens, start)) + ")\n";
            }
            else if (tokenKindAt(tokens, start) == kindIdentifier() and trimExpressionEnd(tokens, start, op) == start + 1 and
                strEq(lookupVisibleValueType(tokens, start, tokenTextAt(tokens, start)), "Char")) {
                leftCode = "  " + resultName + ".left.i8 = load i8, ptr %" +
                    lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start)) + "\n" +
                    "  " + resultName + ".left = call ptr @csec_to_string_char(i8 " + resultName + ".left.i8)\n";
            }
            else {
                leftCode = generateLLVMCallArgumentLoadI32(tokens, start, op, resultName + ".left.i32") +
                    "  " + resultName + ".left.i64 = sext i32 " + resultName + ".left.i32 to i64\n" +
                    "  " + resultName + ".left = call ptr @csec_to_string_i64(i64 " + resultName + ".left.i64)\n";
            }
            if (strEq(llvmCallArgumentType(tokens, rightStart, end), "ptr")) {
                rightCode = generateLLVMCallArgumentLoadI32(tokens, rightStart, end, resultName + ".right");
            }
            else if (tokenKindAt(tokens, rightStart) == kindChar() and trimExpressionEnd(tokens, rightStart, end) == rightStart + 1) {
                rightCode = "  " + resultName + ".right = call ptr @csec_to_string_char(i8 " +
                    llvmCharI8Value(tokenTextAt(tokens, rightStart)) + ")\n";
            }
            else if (tokenKindAt(tokens, rightStart) == kindIdentifier() and trimExpressionEnd(tokens, rightStart, end) == rightStart + 1 and
                strEq(lookupVisibleValueType(tokens, rightStart, tokenTextAt(tokens, rightStart)), "Char")) {
                rightCode = "  " + resultName + ".right.i8 = load i8, ptr %" +
                    lookupVisibleStorageName(tokens, rightStart, tokenTextAt(tokens, rightStart)) + "\n" +
                    "  " + resultName + ".right = call ptr @csec_to_string_char(i8 " + resultName + ".right.i8)\n";
            }
            else {
                rightCode = generateLLVMCallArgumentLoadI32(tokens, rightStart, end, resultName + ".right.i32") +
                    "  " + resultName + ".right.i64 = sext i32 " + resultName + ".right.i32 to i64\n" +
                    "  " + resultName + ".right = call ptr @csec_to_string_i64(i64 " + resultName + ".right.i64)\n";
            }
            return leftCode + rightCode +
                "  " + resultName + " = call ptr @csec_string_concat(ptr " + resultName + ".left, ptr " +
                resultName + ".right)\n";
        }
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (strEq(mnemonic, "add") or strEq(mnemonic, "sub") or strEq(mnemonic, "mul") or
            strEq(mnemonic, "sdiv") or strEq(mnemonic, "srem") or strEq(mnemonic, "shl") or
            strEq(mnemonic, "ashr") or strEq(mnemonic, "and") or strEq(mnemonic, "or") or
            strEq(mnemonic, "xor")) {
            return generateLLVMCallArgumentLoadI32(tokens, start, op, resultName + ".left") +
                generateLLVMCallArgumentLoadI32(tokens, op + 1, end, resultName + ".right") +
                "  " + resultName + " = " + mnemonic + " i32 " + resultName + ".left, " + resultName + ".right\n";
        }
    }
    return "  " + resultName + " = add i32 0, 0\n";
}

def generateLLVMCallArgumentLoadsI32(tokens: String, argsStart: Int, argsEnd: Int, resultName: String): String {
    val first: Int = skipTrivia(tokens, argsStart);
    val end: Int = trimExpressionEnd(tokens, first, argsEnd);
    if (first >= end) { return ""; }
    val lastComma: Int = findTopLevelOperator(tokens, first, end, 12);
    if (lastComma < first) { return generateLLVMCallArgumentLoadI32(tokens, first, end, resultName + ".arg0"); }
    val secondComma: Int = findTopLevelOperator(tokens, first, lastComma, 12);
    if (secondComma < first) {
        return generateLLVMCallArgumentLoadI32(tokens, first, lastComma, resultName + ".arg0") +
            generateLLVMCallArgumentLoadI32(tokens, skipTrivia(tokens, lastComma + 1), end, resultName + ".arg1");
    }
    val firstComma: Int = findTopLevelOperator(tokens, first, secondComma, 12);
    if (firstComma < first) {
        return generateLLVMCallArgumentLoadI32(tokens, first, secondComma, resultName + ".arg0") +
            generateLLVMCallArgumentLoadI32(tokens, skipTrivia(tokens, secondComma + 1), lastComma, resultName + ".arg1") +
            generateLLVMCallArgumentLoadI32(tokens, skipTrivia(tokens, lastComma + 1), end, resultName + ".arg2");
    }
    return generateLLVMCallArgumentLoadI32(tokens, first, firstComma, resultName + ".arg0") +
        generateLLVMCallArgumentLoadI32(tokens, skipTrivia(tokens, firstComma + 1), secondComma, resultName + ".arg1") +
        generateLLVMCallArgumentLoadI32(tokens, skipTrivia(tokens, secondComma + 1), lastComma, resultName + ".arg2") +
        generateLLVMCallArgumentLoadI32(tokens, skipTrivia(tokens, lastComma + 1), end, resultName + ".arg3");
}

def generateLLVMCallArgumentListI32(tokens: String, argsStart: Int, argsEnd: Int, resultName: String): String {
    val first: Int = skipTrivia(tokens, argsStart);
    val end: Int = trimExpressionEnd(tokens, first, argsEnd);
    if (first >= end) { return ""; }
    val lastComma: Int = findTopLevelOperator(tokens, first, end, 12);
    if (lastComma < first) {
        return llvmCallArgumentType(tokens, first, end) + " " +
            llvmCallArgumentValue(tokens, first, end, resultName, 0);
    }
    val secondComma: Int = findTopLevelOperator(tokens, first, lastComma, 12);
    if (secondComma < first) {
        val second: Int = skipTrivia(tokens, lastComma + 1);
        return llvmCallArgumentType(tokens, first, lastComma) + " " + llvmCallArgumentValue(tokens, first, lastComma, resultName, 0) + ", " +
            llvmCallArgumentType(tokens, second, end) + " " + llvmCallArgumentValue(tokens, second, end, resultName, 1);
    }
    val firstComma: Int = findTopLevelOperator(tokens, first, secondComma, 12);
    if (firstComma < first) {
        val second: Int = skipTrivia(tokens, secondComma + 1);
        val third: Int = skipTrivia(tokens, lastComma + 1);
        return llvmCallArgumentType(tokens, first, secondComma) + " " + llvmCallArgumentValue(tokens, first, secondComma, resultName, 0) + ", " +
            llvmCallArgumentType(tokens, second, lastComma) + " " + llvmCallArgumentValue(tokens, second, lastComma, resultName, 1) + ", " +
            llvmCallArgumentType(tokens, third, end) + " " + llvmCallArgumentValue(tokens, third, end, resultName, 2);
    }
    val second: Int = skipTrivia(tokens, firstComma + 1);
    val third: Int = skipTrivia(tokens, secondComma + 1);
    val fourth: Int = skipTrivia(tokens, lastComma + 1);
    return llvmCallArgumentType(tokens, first, firstComma) + " " + llvmCallArgumentValue(tokens, first, firstComma, resultName, 0) + ", " +
        llvmCallArgumentType(tokens, second, secondComma) + " " + llvmCallArgumentValue(tokens, second, secondComma, resultName, 1) + ", " +
        llvmCallArgumentType(tokens, third, lastComma) + " " + llvmCallArgumentValue(tokens, third, lastComma, resultName, 2) + ", " +
        llvmCallArgumentType(tokens, fourth, end) + " " + llvmCallArgumentValue(tokens, fourth, end, resultName, 3);
}

def llvmRuntimeCallName(name: String): String {
    if (strEq(name, "commandLineArgCount")) { return "csec_command_line_arg_count"; }
    if (strEq(name, "commandLineArg")) { return "csec_command_line_arg"; }
    return name;
}

def llvmCallReturnsChar(tokens: String, name: String): Boolean {
    if (name.startsWith("kind")) { return true; }
    if (strEq(name, "tokenKindAt")) { return true; }
    if (strEq(name, "csec_token_kind_at")) { return true; }
    if (strEq(lookupFunctionReturnType(tokens, name), "Char")) { return true; }
    return false;
}

def generateLLVMExpressionI32(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = add i32 0, 0\n";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindChar() and end == start + 1) {
        return "  " + resultName + " = add i32 0, " + llvmCharI8Value(tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val valueType: String = lookupVisibleValueType(tokens, start, name);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        if (strEq(valueType, "Char")) {
            return "  " + resultName + ".c = load i8, ptr %" + storageName + "\n" +
                "  " + resultName + " = zext i8 " + resultName + ".c to i32\n";
        }
        return "  " + resultName + " = load i32, ptr %" + storageName + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 2 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "length")) {
        val name: String = tokenTextAt(tokens, start);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        return "  " + resultName + ".obj = load ptr, ptr %" + storageName + "\n" +
            "  " + resultName + ".i64 = call i64 @csec_string_length(ptr " + resultName + ".obj)\n" +
            "  " + resultName + " = trunc i64 " + resultName + ".i64 to i32\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 4 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "charAt") and
        tokenIs(tokens, start + 3, kindOperator(), "(") and
        findClosingToken(tokens, start + 3, end, "(", ")") == end - 1) {
        val name: String = tokenTextAt(tokens, start);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        return "  " + resultName + ".obj = load ptr, ptr %" + storageName + "\n" +
            generateLLVMExpressionI32(tokens, start + 4, end - 1, resultName + ".index") +
            "  " + resultName + ".i8 = call i8 @csec_string_char_at(ptr " + resultName + ".obj, i32 " + resultName + ".index)\n" +
            "  " + resultName + " = zext i8 " + resultName + ".i8 to i32\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        val callee: String = tokenTextAt(tokens, start);
        if (llvmCallReturnsChar(tokens, callee)) {
            return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
                "  " + resultName + ".i8 = call i8 @" + llvmRuntimeCallName(callee) + "(" +
                generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n" +
                "  " + resultName + " = zext i8 " + resultName + ".i8 to i32\n";
        }
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call i32 @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (strEq(mnemonic, "add") or strEq(mnemonic, "sub") or strEq(mnemonic, "mul") or
            strEq(mnemonic, "sdiv") or strEq(mnemonic, "srem") or strEq(mnemonic, "shl") or
            strEq(mnemonic, "ashr") or strEq(mnemonic, "and") or strEq(mnemonic, "or") or
            strEq(mnemonic, "xor")) {
            return generateLLVMExpressionI32(tokens, start, op, resultName + ".left") +
                generateLLVMExpressionI32(tokens, op + 1, end, resultName + ".right") +
                "  " + resultName + " = " + mnemonic + " i32 " +
                resultName + ".left, " + resultName + ".right\n";
        }
    }
    return "  " + resultName + " = add i32 0, 0\n";
}

def generateLLVMLocalI32(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    val storageName: String = name + ".addr." + start;
    val initName: String = "%" + name + ".init." + start;
    if (initializer >= start) {
        return "  %" + storageName + " = alloca i32\n" +
            generateLLVMExpressionI32(tokens, initializer + 1, end, initName) +
            "  store i32 " + initName + ", ptr %" + storageName + "\n";
    }
    return "  %" + storageName + " = alloca i32\n" +
        "  store i32 0, ptr %" + storageName + "\n";
}

def llvmI64Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".lval." + start;
    }
    return "%ltmp";
}

def generateLLVMLoadI64IfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        return "  %" + name + ".lval." + start + " = load i64, ptr %" + storageName + "\n";
    }
    return "";
}

def generateLLVMExpressionI64(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = add i64 0, 0\n";
    }
    if (tokenKindAt(tokens, start) == kindInteger() and end == start + 1) {
        return "  " + resultName + " = add i64 0, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load i64, ptr %" + lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call i64 @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (strEq(mnemonic, "add") or strEq(mnemonic, "sub") or strEq(mnemonic, "mul") or
            strEq(mnemonic, "sdiv") or strEq(mnemonic, "srem") or strEq(mnemonic, "shl") or
            strEq(mnemonic, "ashr") or strEq(mnemonic, "and") or strEq(mnemonic, "or") or
            strEq(mnemonic, "xor")) {
            return generateLLVMLoadI64IfIdentifier(tokens, start, op) +
                generateLLVMLoadI64IfIdentifier(tokens, op + 1, end) +
                "  " + resultName + " = " + mnemonic + " i64 " +
                llvmI64Value(tokens, start, op) + ", " + llvmI64Value(tokens, op + 1, end) + "\n";
        }
    }
    return "  " + resultName + " = add i64 0, 0\n";
}

def generateLLVMLocalI64(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    val storageName: String = name + ".addr." + start;
    val initName: String = "%" + name + ".linit." + start;
    if (initializer >= start) {
        return "  %" + storageName + " = alloca i64\n" +
            generateLLVMExpressionI64(tokens, initializer + 1, end, initName) +
            "  store i64 " + initName + ", ptr %" + storageName + "\n";
    }
    return "  %" + storageName + " = alloca i64\n" +
        "  store i64 0, ptr %" + storageName + "\n";
}

def llvmF64Value(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "0.000000e+00";
    }
    if ((tokenKindAt(tokens, start) == kindFloat() or tokenKindAt(tokens, start) == kindInteger()) and end == start + 1) {
        return tokenTextAt(tokens, start);
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "%" + tokenTextAt(tokens, start) + ".fval." + start;
    }
    return "%ftmp";
}

def generateLLVMLoadF64IfIdentifier(tokens: String, start: Int, rawEnd: Int): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        val name: String = tokenTextAt(tokens, start);
        val storageName: String = lookupVisibleStorageName(tokens, start, name);
        return "  %" + name + ".fval." + start + " = load double, ptr %" + storageName + "\n";
    }
    return "";
}

def generateLLVMExpressionF64(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = fadd double 0.000000e+00, 0.000000e+00\n";
    }
    if ((tokenKindAt(tokens, start) == kindFloat() or tokenKindAt(tokens, start) == kindInteger()) and end == start + 1) {
        return "  " + resultName + " = fadd double 0.000000e+00, " + tokenTextAt(tokens, start) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load double, ptr %" + lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call double @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator()) {
        val opText: String = tokenTextAt(tokens, op);
        var mnemonic: String = "";
        if (strEq(opText, "+")) { mnemonic = "fadd"; }
        if (strEq(opText, "-")) { mnemonic = "fsub"; }
        if (strEq(opText, "*")) { mnemonic = "fmul"; }
        if (strEq(opText, "/")) { mnemonic = "fdiv"; }
        if (mnemonic.length > 0) {
            return generateLLVMLoadF64IfIdentifier(tokens, start, op) +
                generateLLVMLoadF64IfIdentifier(tokens, op + 1, end) +
                "  " + resultName + " = " + mnemonic + " double " +
                llvmF64Value(tokens, start, op) + ", " +
                llvmF64Value(tokens, op + 1, end) + "\n";
        }
    }
    return "  " + resultName + " = fadd double 0.000000e+00, 0.000000e+00\n";
}

def generateLLVMLocalF64(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    val storageName: String = name + ".addr." + start;
    val initName: String = "%" + name + ".finit." + start;
    if (initializer >= start) {
        return "  %" + storageName + " = alloca double\n" +
            generateLLVMExpressionF64(tokens, initializer + 1, end, initName) +
            "  store double " + initName + ", ptr %" + storageName + "\n";
    }
    return "  %" + storageName + " = alloca double\n" +
        "  store double 0.000000e+00, ptr %" + storageName + "\n";
}

def generateLLVMLocalI8(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    val storageName: String = name + ".addr." + start;
    val initName: String = "%" + name + ".cinit." + start;
    if (initializer >= start) {
        val exprStart: Int = skipTrivia(tokens, initializer + 1);
        val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
        if (tokenKindAt(tokens, exprStart) == kindChar() and exprEnd == exprStart + 1) {
            return "  %" + storageName + " = alloca i8\n" +
                "  store i8 " + llvmCharI8Value(tokenTextAt(tokens, exprStart)) + ", ptr %" + storageName + "\n";
        }
        if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprEnd == exprStart + 1) {
            val exprStorageName: String = lookupVisibleStorageName(tokens, exprStart, tokenTextAt(tokens, exprStart));
            return "  %" + storageName + " = alloca i8\n" +
                "  " + initName + " = load i8, ptr %" + exprStorageName + "\n" +
                "  store i8 " + initName + ", ptr %" + storageName + "\n";
        }
        if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 4 < exprEnd and
            tokenIs(tokens, exprStart + 1, kindOperator(), ".") and
            tokenIs(tokens, exprStart + 2, kindIdentifier(), "charAt") and
            tokenIs(tokens, exprStart + 3, kindOperator(), "(") and
            findClosingToken(tokens, exprStart + 3, exprEnd, "(", ")") == exprEnd - 1) {
            val exprStorageName: String = lookupVisibleStorageName(tokens, exprStart, tokenTextAt(tokens, exprStart));
            return "  %" + storageName + " = alloca i8\n" +
                "  " + initName + ".obj = load ptr, ptr %" + exprStorageName + "\n" +
                generateLLVMExpressionI32(tokens, exprStart + 4, exprEnd - 1, initName + ".index") +
                "  " + initName + " = call i8 @csec_string_char_at(ptr " + initName + ".obj, i32 " + initName + ".index)\n" +
                "  store i8 " + initName + ", ptr %" + storageName + "\n";
        }
        if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 1 < exprEnd and
            tokenIs(tokens, exprStart + 1, kindOperator(), "(") and
            findClosingToken(tokens, exprStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
            return "  %" + storageName + " = alloca i8\n" +
                generateLLVMCallArgumentLoadsI32(tokens, exprStart + 2, exprEnd - 1, initName) +
                "  " + initName + " = call i8 @" + llvmRuntimeCallName(tokenTextAt(tokens, exprStart)) + "(" +
                generateLLVMCallArgumentListI32(tokens, exprStart + 2, exprEnd - 1, initName) + ")\n" +
                "  store i8 " + initName + ", ptr %" + storageName + "\n";
        }
    }
    return "  %" + storageName + " = alloca i8\n" +
        "  store i8 0, ptr %" + storageName + "\n";
}

def generateLLVMAssignmentF64(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val storageName: String = lookupVisibleStorageName(tokens, start, name);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".fassign." + start;
        return generateLLVMExpressionF64(tokens, op + 1, end, resultName) +
            "  store double " + resultName + ", ptr %" + storageName + "\n";
    }
    return "";
}

def generateLLVMAssignmentPtr(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val storageName: String = lookupVisibleStorageName(tokens, start, name);
    val exprStart: Int = skipTrivia(tokens, op + 1);
    val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
    if (tokenKindAt(tokens, exprStart) == kindString() and exprEnd == exprStart + 1) {
        val text: String = tokenTextAt(tokens, exprStart);
        val byteLength: Int = text.length + 1;
        return "  %" + name + ".passign." + start + " = getelementptr inbounds [" + byteLength +
            " x i8], ptr @.str." + exprStart + ", i32 0, i32 0\n" +
            "  store ptr %" + name + ".passign." + start + ", ptr %" + storageName + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprEnd == exprStart + 1) {
        val exprStorageName: String = lookupVisibleStorageName(tokens, exprStart, tokenTextAt(tokens, exprStart));
        return "  %" + name + ".passign." + start + " = load ptr, ptr %" + exprStorageName + "\n" +
            "  store ptr %" + name + ".passign." + start + ", ptr %" + storageName + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 1 < exprEnd and
        tokenIs(tokens, exprStart + 1, kindOperator(), "(") and
        findClosingToken(tokens, exprStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
        val resultName: String = "%" + name + ".passign." + start;
        return generateLLVMCallArgumentLoadsI32(tokens, exprStart + 2, exprEnd - 1, resultName) +
            "  " + resultName + " = call ptr @" + llvmRuntimeCallName(tokenTextAt(tokens, exprStart)) + "(" +
            generateLLVMCallArgumentListI32(tokens, exprStart + 2, exprEnd - 1, resultName) + ")\n" +
            "  store ptr " + resultName + ", ptr %" + storageName + "\n";
    }
    val concat: Int = expressionTopLevelOperator(tokens, exprStart, exprEnd);
    if (concat > exprStart and tokenIs(tokens, concat, kindOperator(), "+") and
        tokenKindAt(tokens, exprStart) == kindIdentifier()) {
        val resultName: String = "%" + name + ".passign." + start;
        val rightStart: Int = skipTrivia(tokens, concat + 1);
        val leftStorage: String = lookupVisibleStorageName(tokens, exprStart, tokenTextAt(tokens, exprStart));
        var rightCode: String = "";
        if (tokenKindAt(tokens, rightStart) == kindString() and rightStart + 1 == exprEnd) {
            val rightText: String = tokenTextAt(tokens, rightStart);
            rightCode = "  " + resultName + ".right = getelementptr inbounds [" + (rightText.length + 1) +
                " x i8], ptr @.str." + rightStart + ", i32 0, i32 0\n";
        }
        else if (tokenKindAt(tokens, rightStart) == kindIdentifier() and rightStart + 1 == exprEnd) {
            rightCode = "  " + resultName + ".right = load ptr, ptr %" +
                lookupVisibleStorageName(tokens, rightStart, tokenTextAt(tokens, rightStart)) + "\n";
        }
        else if (tokenKindAt(tokens, rightStart) == kindIdentifier() and rightStart + 1 < exprEnd and
            tokenIs(tokens, rightStart + 1, kindOperator(), "(") and
            findClosingToken(tokens, rightStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
            rightCode = generateLLVMCallArgumentLoadsI32(tokens, rightStart + 2, exprEnd - 1, resultName) +
                "  " + resultName + ".right = call ptr @" + llvmRuntimeCallName(tokenTextAt(tokens, rightStart)) + "(" +
                generateLLVMCallArgumentListI32(tokens, rightStart + 2, exprEnd - 1, resultName) + ")\n";
        }
        if (rightCode.length > 0) {
            return "  " + resultName + ".left = load ptr, ptr %" + leftStorage + "\n" +
                rightCode +
                "  " + resultName + " = call ptr @csec_string_concat(ptr " + resultName + ".left, ptr " + resultName + ".right)\n" +
                "  store ptr " + resultName + ", ptr %" + storageName + "\n";
        }
    }
    return "";
}

def generateLLVMAssignmentI8(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val storageName: String = lookupVisibleStorageName(tokens, start, name);
    val exprStart: Int = skipTrivia(tokens, op + 1);
    val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
    if (tokenKindAt(tokens, exprStart) == kindChar() and exprEnd == exprStart + 1) {
        return "  store i8 " + llvmCharI8Value(tokenTextAt(tokens, exprStart)) + ", ptr %" + storageName + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprEnd == exprStart + 1) {
        val exprStorageName: String = lookupVisibleStorageName(tokens, exprStart, tokenTextAt(tokens, exprStart));
        return "  %" + name + ".cassign." + start + " = load i8, ptr %" + exprStorageName + "\n" +
            "  store i8 %" + name + ".cassign." + start + ", ptr %" + storageName + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 4 < exprEnd and
        tokenIs(tokens, exprStart + 1, kindOperator(), ".") and
        tokenIs(tokens, exprStart + 2, kindIdentifier(), "charAt") and
        tokenIs(tokens, exprStart + 3, kindOperator(), "(") and
        findClosingToken(tokens, exprStart + 3, exprEnd, "(", ")") == exprEnd - 1) {
        val exprStorageName: String = lookupVisibleStorageName(tokens, exprStart, tokenTextAt(tokens, exprStart));
        val resultName: String = "%" + name + ".cassign." + start;
        return "  " + resultName + ".obj = load ptr, ptr %" + exprStorageName + "\n" +
            generateLLVMExpressionI32(tokens, exprStart + 4, exprEnd - 1, resultName + ".index") +
            "  " + resultName + " = call i8 @csec_string_char_at(ptr " + resultName + ".obj, i32 " + resultName + ".index)\n" +
            "  store i8 " + resultName + ", ptr %" + storageName + "\n";
    }
    if (tokenKindAt(tokens, exprStart) == kindIdentifier() and exprStart + 1 < exprEnd and
        tokenIs(tokens, exprStart + 1, kindOperator(), "(") and
        findClosingToken(tokens, exprStart + 1, exprEnd, "(", ")") == exprEnd - 1) {
        val resultName: String = "%" + name + ".cassign." + start;
        return generateLLVMCallArgumentLoadsI32(tokens, exprStart + 2, exprEnd - 1, resultName) +
            "  " + resultName + " = call i8 @" + llvmRuntimeCallName(tokenTextAt(tokens, exprStart)) + "(" +
            generateLLVMCallArgumentListI32(tokens, exprStart + 2, exprEnd - 1, resultName) + ")\n" +
            "  store i8 " + resultName + ", ptr %" + storageName + "\n";
    }
    return "";
}

def generateLLVMAssignmentI32(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val storageName: String = lookupVisibleStorageName(tokens, start, name);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".assign." + start;
        return generateLLVMExpressionI32(tokens, op + 1, end, resultName) +
            "  store i32 " + resultName + ", ptr %" + storageName + "\n";
    }
    var binaryOp: String = opText.substring(0, 1);
    if (strEq(opText, "%=")) {
        binaryOp = "%";
    }
    return "  %" + name + ".old." + start + " = load i32, ptr %" + storageName + "\n" +
        generateLLVMExpressionI32(tokens, op + 1, end, "%" + name + ".rhs." + start) +
        "  %" + name + ".next." + start + " = " + irOperatorName(binaryOp) + " i32 %" + name + ".old." + start + ", %" + name + ".rhs." + start + "\n" +
        "  store i32 %" + name + ".next." + start + ", ptr %" + storageName + "\n";
}

def generateLLVMAssignmentI64(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val storageName: String = lookupVisibleStorageName(tokens, start, name);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".lassign." + start;
        return generateLLVMExpressionI64(tokens, op + 1, end, resultName) +
            "  store i64 " + resultName + ", ptr %" + storageName + "\n";
    }
    var binaryOp: String = opText.substring(0, 1);
    if (strEq(opText, "%=")) {
        binaryOp = "%";
    }
    return "  %" + name + ".lold." + start + " = load i64, ptr %" + storageName + "\n" +
        generateLLVMExpressionI64(tokens, op + 1, end, "%" + name + ".lrhs." + start) +
        "  %" + name + ".lnext." + start + " = " + irOperatorName(binaryOp) + " i64 %" + name + ".lold." + start + ", %" + name + ".lrhs." + start + "\n" +
        "  store i64 %" + name + ".lnext." + start + ", ptr %" + storageName + "\n";
}

def generateLLVMConditionI1(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (tokenIs(tokens, start, kindOperator(), "(") and
        findClosingToken(tokens, start, end, "(", ")") == end - 1) {
        return generateLLVMConditionI1(tokens, start + 1, end - 1, resultName);
    }
    if (tokenIs(tokens, start, kindOperator(), "!")) {
        val notName: String = resultName + ".not";
        return generateLLVMConditionI1(tokens, start + 1, end, notName) +
            "  " + resultName + " = xor i1 " + resultName + ".not, true\n";
    }
    val op: Int = findTopLevelOperator(tokens, start, end, 4);
    if (op > start) {
        val mnemonic: String = irOperatorName(tokenTextAt(tokens, op));
        if (mnemonic.startsWith("icmp_")) {
            val compareOp: String = mnemonic.substring(5, mnemonic.length - 5);
            if (tokenKindAt(tokens, start) == kindIdentifier() and
                tokenKindAt(tokens, op + 1) == kindChar() and end == op + 2) {
                val storageName: String = lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start));
                return "  " + resultName + ".left.i8 = load i8, ptr %" + storageName + "\n" +
                    "  " + resultName + " = icmp " + compareOp + " i8 " + resultName +
                    ".left.i8, " + llvmCharI8Value(tokenTextAt(tokens, op + 1)) + "\n";
            }
            if (tokenKindAt(tokens, start) == kindChar() and start + 1 == op and
                tokenKindAt(tokens, op + 1) == kindIdentifier() and
                end == op + 2) {
                val storageName: String = lookupVisibleStorageName(tokens, op + 1, tokenTextAt(tokens, op + 1));
                return "  " + resultName + ".right.i8 = load i8, ptr %" + storageName + "\n" +
                    "  " + resultName + " = icmp " + compareOp + " i8 " +
                    llvmCharI8Value(tokenTextAt(tokens, start)) + ", " + resultName + ".right.i8\n";
            }
            val leftName: String = resultName + ".left.i32";
            val rightName: String = resultName + ".right.i32";
            return generateLLVMExpressionI32(tokens, start, op, leftName) +
                generateLLVMExpressionI32(tokens, op + 1, end, rightName) +
                "  " + resultName + " = icmp " + compareOp +
                " i32 " + resultName + ".left.i32, " + resultName + ".right.i32\n";
        }
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        if (strEq(tokenTextAt(tokens, start), "true")) {
            return "  " + resultName + " = icmp eq i1 true, true\n";
        }
        return "  " + resultName + " = icmp eq i1 false, true\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load i1, ptr %" + lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 4 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "startsWith") and
        tokenIs(tokens, start + 3, kindOperator(), "(") and
        findClosingToken(tokens, start + 3, end, "(", ")") == end - 1) {
        val storageName: String = lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start));
        val needleName: String = resultName + ".needle";
        return "  " + resultName + ".obj = load ptr, ptr %" + storageName + "\n" +
            generateLLVMCallArgumentLoadI32(tokens, start + 4, end - 1, needleName) +
            "  " + resultName + ".i32 = call i32 @csec_string_starts_with(ptr " + resultName + ".obj, ptr " + resultName + ".needle)\n" +
            "  " + resultName + " = icmp ne i32 " + resultName + ".i32, 0\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call i1 @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    return "  " + resultName + " = icmp eq i32 0, 0\n";
}

def generateLLVMExpressionI1(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = icmp eq i1 false, true\n";
    }
    if (tokenIs(tokens, start, kindOperator(), "(") and
        findClosingToken(tokens, start, end, "(", ")") == end - 1) {
        return generateLLVMExpressionI1(tokens, start + 1, end - 1, resultName);
    }
    if (tokenIs(tokens, start, kindOperator(), "!")) {
        val notName: String = resultName + ".not";
        return generateLLVMExpressionI1(tokens, start + 1, end, notName) +
            "  " + resultName + " = xor i1 " + resultName + ".not, true\n";
    }
    if (tokenKindAt(tokens, start) == kindBool() and end == start + 1) {
        if (strEq(tokenTextAt(tokens, start), "true")) {
            return "  " + resultName + " = icmp eq i1 true, true\n";
        }
        return "  " + resultName + " = icmp eq i1 false, true\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load i1, ptr %" + lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start)) + "\n";
    }
    val comparison: Int = findTopLevelOperator(tokens, start, end, 4);
    if (comparison > start and tokenKindAt(tokens, start) == kindIdentifier() and
        strEq(tokenTextAt(tokens, start), "csec_token_is") and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == comparison - 1 and
        tokenKindAt(tokens, comparison + 1) == kindInteger() and end == comparison + 2) {
        val comma0: Int = findTokenTextInRange(tokens, start + 2, comparison - 1, ",");
        val comma1: Int = findTokenTextInRange(tokens, comma0 + 1, comparison - 1, ",");
        val comma2: Int = findTokenTextInRange(tokens, comma1 + 1, comparison - 1, ",");
        if (comma0 > start + 2 and comma1 > comma0 and comma2 > comma1) {
            val tokensStorage: String = lookupVisibleStorageName(tokens, start + 2, tokenTextAt(tokens, start + 2));
            val kindStorage: String = lookupVisibleStorageName(tokens, comma1 + 1, tokenTextAt(tokens, comma1 + 1));
            val textStorage: String = lookupVisibleStorageName(tokens, comma2 + 1, tokenTextAt(tokens, comma2 + 1));
            val comparisonName: String = irOperatorName(tokenTextAt(tokens, comparison));
            val predicate: String = comparisonName.substring(5, comparisonName.length - 5);
            return "  " + resultName + ".call.arg0 = load ptr, ptr %" + tokensStorage + "\n" +
                generateLLVMExpressionI32(tokens, comma0 + 1, comma1, resultName + ".call.arg1") +
                "  " + resultName + ".call.arg2 = load i8, ptr %" + kindStorage + "\n" +
                "  " + resultName + ".call.arg3 = load ptr, ptr %" + textStorage + "\n" +
                "  " + resultName + ".call = call i32 @csec_token_is(ptr " + resultName +
                ".call.arg0, i32 " + resultName + ".call.arg1, i8 " + resultName +
                ".call.arg2, ptr " + resultName + ".call.arg3)\n" +
                "  " + resultName + " = icmp " + predicate + " i32 " + resultName + ".call, " +
                tokenTextAt(tokens, comparison + 1) + "\n";
        }
    }
    if (comparison > start and tokenKindAt(tokens, start) == kindIdentifier() and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == comparison - 1 and
        tokenKindAt(tokens, comparison + 1) == kindInteger() and end == comparison + 2) {
        val comparisonName: String = irOperatorName(tokenTextAt(tokens, comparison));
        val predicate: String = comparisonName.substring(5, comparisonName.length - 5);
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, comparison, resultName + ".call") +
            "  " + resultName + ".call = call i32 @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, comparison, resultName + ".call") + ")\n" +
            "  " + resultName + " = icmp " + predicate + " i32 " + resultName + ".call, " +
            tokenTextAt(tokens, comparison + 1) + "\n";
    }
    var op: Int = findTopLevelOperator(tokens, start, end, 2);
    if (op > start) {
        val leftName: String = resultName + ".left";
        val rightName: String = resultName + ".right";
        return generateLLVMExpressionI1(tokens, start, op, leftName) +
            generateLLVMExpressionI1(tokens, op + 1, end, rightName) +
            "  " + resultName + " = or i1 " + resultName + ".left, " + resultName + ".right\n" +
            "  ; bool operands " + llvmI1Value(tokens, start, op) + ", " +
            llvmI1Value(tokens, op + 1, end) + "\n";
    }
    op = findTopLevelOperator(tokens, start, end, 3);
    if (op > start) {
        val leftName: String = resultName + ".left";
        val rightName: String = resultName + ".right";
        return generateLLVMExpressionI1(tokens, start, op, leftName) +
            generateLLVMExpressionI1(tokens, op + 1, end, rightName) +
            "  " + resultName + " = and i1 " + resultName + ".left, " + resultName + ".right\n" +
            "  ; bool operands " + llvmI1Value(tokens, start, op) + ", " +
            llvmI1Value(tokens, op + 1, end) + "\n";
    }
    return generateLLVMConditionI1(tokens, start, end, resultName);
}

def generateLLVMLocalI1(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    val storageName: String = name + ".addr." + start;
    val initName: String = "%" + name + ".binit." + start;
    if (initializer >= start) {
        return "  %" + storageName + " = alloca i1\n" +
            generateLLVMExpressionI1(tokens, initializer + 1, end, initName) +
            "  store i1 " + initName + ", ptr %" + storageName + "\n";
    }
    return "  %" + storageName + " = alloca i1\n" +
        "  store i1 false, ptr %" + storageName + "\n";
}

def generateLLVMAssignmentI1(tokens: String, start: Int, end: Int): String {
    val op: Int = findTopLevelOperator(tokens, start, end, 1);
    if (op <= start or tokenKindAt(tokens, start) != kindIdentifier()) {
        return "";
    }
    val name: String = tokenTextAt(tokens, start);
    val storageName: String = lookupVisibleStorageName(tokens, start, name);
    val opText: String = tokenTextAt(tokens, op);
    if (strEq(opText, "=") or strEq(opText, "<-")) {
        val resultName: String = "%" + name + ".bassign." + start;
        return generateLLVMExpressionI1(tokens, op + 1, end, resultName) +
            "  store i1 " + resultName + ", ptr %" + storageName + "\n";
    }
    return "";
}

def llvmBlockEndsWithTopLevelReturn(tokens: String, bodyStart: Int, bodyEnd: Int): Boolean {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    var result: Boolean = false;
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            result = true;
        }
        else {
            result = false;
        }
        cursor = skipTrivia(tokens, next);
    }
    return result;
}

def generateLLVMExpressionPtr(tokens: String, start: Int, rawEnd: Int, resultName: String): String {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return "  " + resultName + " = inttoptr i64 0 to ptr\n";
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        val text: String = tokenTextAt(tokens, start);
        val byteLength: Int = text.length + 1;
        return "  " + resultName + " = getelementptr inbounds [" + byteLength +
            " x i8], ptr @.str." + start + ", i32 0, i32 0\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return "  " + resultName + " = load ptr, ptr %" + lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start)) + "\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return generateLLVMCallArgumentLoadsI32(tokens, start + 2, end - 1, resultName) +
            "  " + resultName + " = call ptr @" + llvmRuntimeCallName(tokenTextAt(tokens, start)) + "(" +
            generateLLVMCallArgumentListI32(tokens, start + 2, end - 1, resultName) + ")\n";
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 6 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "substring") and
        tokenIs(tokens, start + 3, kindOperator(), "(") and
        findClosingToken(tokens, start + 3, end, "(", ")") == end - 1) {
        val comma: Int = findTokenTextInRange(tokens, start + 4, end - 1, ",");
        if (comma > start + 4) {
            val name: String = tokenTextAt(tokens, start);
            val storageName: String = lookupVisibleStorageName(tokens, start, name);
            return "  " + resultName + ".obj = load ptr, ptr %" + storageName + "\n" +
                generateLLVMExpressionI32(tokens, start + 4, comma, resultName + ".start") +
                generateLLVMExpressionI32(tokens, comma + 1, end - 1, resultName + ".length") +
                "  " + resultName + " = call ptr @csec_string_substring(ptr " + resultName + ".obj, i32 " +
                resultName + ".start, i32 " + resultName + ".length)\n";
        }
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator() and strEq(tokenTextAt(tokens, op), "+")) {
        val leftEnd: Int = trimExpressionEnd(tokens, start, op);
        val rightStart: Int = skipTrivia(tokens, op + 1);
        val rightEnd: Int = trimExpressionEnd(tokens, rightStart, end);
        val leftOp: Int = expressionTopLevelOperator(tokens, start, leftEnd);
        val rightOp: Int = expressionTopLevelOperator(tokens, rightStart, rightEnd);
        var leftCode: String = "";
        var rightCode: String = "";
        if ((tokenKindAt(tokens, start) == kindString() and leftEnd == start + 1) or
            (tokenKindAt(tokens, start) == kindIdentifier() and leftEnd == start + 1 and
             strEq(irTypeName(lookupVisibleValueType(tokens, start, tokenTextAt(tokens, start))), "ptr")) or
            (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < leftEnd and
             tokenIs(tokens, start + 1, kindOperator(), "(") and
             findClosingToken(tokens, start + 1, leftEnd, "(", ")") == leftEnd - 1 and
             strEq(irTypeName(lookupFunctionReturnType(tokens, tokenTextAt(tokens, start))), "ptr")) or
            (tokenKindAt(tokens, start) == kindIdentifier() and start + 6 < leftEnd and
             tokenIs(tokens, start + 1, kindOperator(), ".") and
             tokenIs(tokens, start + 2, kindIdentifier(), "substring") and
             tokenIs(tokens, start + 3, kindOperator(), "(") and
             findClosingToken(tokens, start + 3, leftEnd, "(", ")") == leftEnd - 1) or
            (leftOp > start and tokenKindAt(tokens, leftOp) == kindOperator() and strEq(tokenTextAt(tokens, leftOp), "+"))) {
            leftCode = generateLLVMExpressionPtr(tokens, start, leftEnd, resultName + ".left");
        }
        else if (tokenKindAt(tokens, start) == kindChar() and leftEnd == start + 1) {
            leftCode = "  " + resultName + ".left = call ptr @csec_to_string_char(i8 " +
                llvmCharI8Value(tokenTextAt(tokens, start)) + ")\n";
        }
        else if (tokenKindAt(tokens, start) == kindIdentifier() and leftEnd == start + 1 and
            strEq(lookupVisibleValueType(tokens, start, tokenTextAt(tokens, start)), "Char")) {
            leftCode = "  " + resultName + ".left.i8 = load i8, ptr %" +
                lookupVisibleStorageName(tokens, start, tokenTextAt(tokens, start)) + "\n" +
                "  " + resultName + ".left = call ptr @csec_to_string_char(i8 " + resultName + ".left.i8)\n";
        }
        else {
            leftCode = generateLLVMExpressionI32(tokens, start, leftEnd, resultName + ".left.i32") +
                "  " + resultName + ".left.i64 = sext i32 " + resultName + ".left.i32 to i64\n" +
                "  " + resultName + ".left = call ptr @csec_to_string_i64(i64 " + resultName + ".left.i64)\n";
        }
        if ((tokenKindAt(tokens, rightStart) == kindString() and rightEnd == rightStart + 1) or
            (tokenKindAt(tokens, rightStart) == kindIdentifier() and rightEnd == rightStart + 1 and
             strEq(irTypeName(lookupVisibleValueType(tokens, rightStart, tokenTextAt(tokens, rightStart))), "ptr")) or
            (tokenKindAt(tokens, rightStart) == kindIdentifier() and rightStart + 1 < rightEnd and
             tokenIs(tokens, rightStart + 1, kindOperator(), "(") and
             findClosingToken(tokens, rightStart + 1, rightEnd, "(", ")") == rightEnd - 1 and
             strEq(irTypeName(lookupFunctionReturnType(tokens, tokenTextAt(tokens, rightStart))), "ptr")) or
            (tokenKindAt(tokens, rightStart) == kindIdentifier() and rightStart + 6 < rightEnd and
             tokenIs(tokens, rightStart + 1, kindOperator(), ".") and
             tokenIs(tokens, rightStart + 2, kindIdentifier(), "substring") and
             tokenIs(tokens, rightStart + 3, kindOperator(), "(") and
             findClosingToken(tokens, rightStart + 3, rightEnd, "(", ")") == rightEnd - 1) or
            (rightOp > rightStart and tokenKindAt(tokens, rightOp) == kindOperator() and strEq(tokenTextAt(tokens, rightOp), "+"))) {
            rightCode = generateLLVMExpressionPtr(tokens, rightStart, rightEnd, resultName + ".right");
        }
        else if (tokenKindAt(tokens, rightStart) == kindChar() and rightEnd == rightStart + 1) {
            rightCode = "  " + resultName + ".right = call ptr @csec_to_string_char(i8 " +
                llvmCharI8Value(tokenTextAt(tokens, rightStart)) + ")\n";
        }
        else if (tokenKindAt(tokens, rightStart) == kindIdentifier() and rightEnd == rightStart + 1 and
            strEq(lookupVisibleValueType(tokens, rightStart, tokenTextAt(tokens, rightStart)), "Char")) {
            rightCode = "  " + resultName + ".right.i8 = load i8, ptr %" +
                lookupVisibleStorageName(tokens, rightStart, tokenTextAt(tokens, rightStart)) + "\n" +
                "  " + resultName + ".right = call ptr @csec_to_string_char(i8 " + resultName + ".right.i8)\n";
        }
        else {
            rightCode = generateLLVMExpressionI32(tokens, rightStart, rightEnd, resultName + ".right.i32") +
                "  " + resultName + ".right.i64 = sext i32 " + resultName + ".right.i32 to i64\n" +
                "  " + resultName + ".right = call ptr @csec_to_string_i64(i64 " + resultName + ".right.i64)\n";
        }
        return leftCode + rightCode +
            "  " + resultName + " = call ptr @csec_string_concat(ptr " + resultName + ".left, ptr " +
            resultName + ".right)\n";
    }
    return "  " + resultName + " = inttoptr i64 0 to ptr\n";
}

def generateLLVMLocalPtr(tokens: String, start: Int, end: Int): String {
    val initializer: Int = findTopLevelOperator(tokens, start, end, 1);
    val name: String = tokenTextAt(tokens, start + 1);
    val storageName: String = name + ".addr." + start;
    val initName: String = "%" + name + ".pinit." + start;
    if (initializer >= start) {
        val exprStart: Int = skipTrivia(tokens, initializer + 1);
        val exprEnd: Int = trimExpressionEnd(tokens, exprStart, end);
        return "  %" + storageName + " = alloca ptr\n" +
            generateLLVMExpressionPtr(tokens, exprStart, exprEnd, initName) +
            "  store ptr " + initName + ", ptr %" + storageName + "\n";
    }
    return "  %" + storageName + " = alloca ptr\n" +
        "  store ptr null, ptr %" + storageName + "\n";
}

def llvmExpressionLooksPtr(tokens: String, start: Int, rawEnd: Int): Boolean {
    val end: Int = trimExpressionEnd(tokens, start, rawEnd);
    if (end <= start) {
        return false;
    }
    if (tokenKindAt(tokens, start) == kindString() and end == start + 1) {
        return true;
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and end == start + 1) {
        return strEq(irTypeName(lookupVisibleValueType(tokens, start, tokenTextAt(tokens, start))), "ptr");
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 1 < end and
        tokenIs(tokens, start + 1, kindOperator(), "(") and
        findClosingToken(tokens, start + 1, end, "(", ")") == end - 1) {
        return strEq(irTypeName(lookupFunctionReturnType(tokens, tokenTextAt(tokens, start))), "ptr");
    }
    if (tokenKindAt(tokens, start) == kindIdentifier() and start + 6 < end and
        tokenIs(tokens, start + 1, kindOperator(), ".") and
        tokenIs(tokens, start + 2, kindIdentifier(), "substring") and
        tokenIs(tokens, start + 3, kindOperator(), "(") and
        findClosingToken(tokens, start + 3, end, "(", ")") == end - 1) {
        return true;
    }
    val op: Int = expressionTopLevelOperator(tokens, start, end);
    if (op > start and tokenKindAt(tokens, op) == kindOperator() and strEq(tokenTextAt(tokens, op), "+")) {
        return llvmExpressionLooksPtr(tokens, start, op) or llvmExpressionLooksPtr(tokens, op + 1, end);
    }
    return false;
}

def generateLLVMFlatBodyI32(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    val builder: Long = csec_string_builder_new();
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "value") or strEq(kind, "variable")) {
            if (strEq(localDeclarationType(tokens, cursor, next), "Int") or
                strEq(localDeclarationType(tokens, cursor, next), "unknown")) {
                csec_string_builder_append(builder, generateLLVMLocalI32(tokens, cursor, next));
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Boolean")) {
                csec_string_builder_append(builder, generateLLVMLocalI1(tokens, cursor, next));
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Double")) {
                csec_string_builder_append(builder, generateLLVMLocalF64(tokens, cursor, next));
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Long")) {
                csec_string_builder_append(builder, generateLLVMLocalI64(tokens, cursor, next));
            }
            else if (strEq(localDeclarationType(tokens, cursor, next), "Char")) {
                csec_string_builder_append(builder, generateLLVMLocalI8(tokens, cursor, next));
            }
            if (strEq(irTypeName(localDeclarationType(tokens, cursor, next)), "ptr") and
                !strEq(localDeclarationType(tokens, cursor, next), "Int") and
                !strEq(localDeclarationType(tokens, cursor, next), "Boolean") and
                !strEq(localDeclarationType(tokens, cursor, next), "Double") and
                !strEq(localDeclarationType(tokens, cursor, next), "Long") and
                !strEq(localDeclarationType(tokens, cursor, next), "Char")) {
                csec_string_builder_append(builder, generateLLVMLocalPtr(tokens, cursor, next));
            }
        }
        else if (strEq(kind, "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindBool() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, "  ret i1 " + tokenTextAt(tokens, cursor + 1) + "\n");
            }
            else if (tokenKindAt(tokens, cursor + 1) == kindString() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val text: String = tokenTextAt(tokens, cursor + 1);
                val byteLength: Int = text.length + 1;
                val resultName: String = "%ret." + cursor;
                csec_string_builder_append(builder, "  " + resultName + " = getelementptr inbounds [" + byteLength +
                    " x i8], ptr @.str." + (cursor + 1) + ", i32 0, i32 0\n" +
                    "  ret ptr " + resultName + "\n");
            }
            else if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val returnName: String = tokenTextAt(tokens, cursor + 1);
                val returnType: String = lookupVisibleValueType(tokens, cursor, returnName);
                val llvmType: String = irTypeName(returnType);
                val resultName: String = "%ret." + cursor;
                if (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or strEq(llvmType, "i1") or
                    strEq(llvmType, "i64") or strEq(llvmType, "double")) {
                    csec_string_builder_append(builder, "  " + resultName + " = load " + llvmType + ", ptr %" +
                        lookupVisibleStorageName(tokens, cursor + 1, returnName) + "\n" +
                        "  ret " + llvmType + " " + resultName + "\n");
                }
                else {
                    csec_string_builder_append(builder, generateLLVMExpressionI32(tokens, cursor + 1, next, resultName) +
                        "  ret i32 " + resultName + "\n");
                }
            }
            else if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and cursor + 2 < next and
                tokenIs(tokens, cursor + 2, kindOperator(), "(")) {
                val callEnd: Int = findClosingToken(tokens, cursor + 2, next, "(", ")");
                val returnType: String = lookupFunctionReturnType(tokens, tokenTextAt(tokens, cursor + 1));
                val llvmType: String = irTypeName(returnType);
                val resultName: String = "%ret." + cursor;
                if (callEnd > cursor + 2 and (strEq(llvmType, "ptr") or strEq(llvmType, "i8") or
                    strEq(llvmType, "i1") or strEq(llvmType, "i64") or strEq(llvmType, "double"))) {
                    csec_string_builder_append(builder, generateLLVMCallArgumentLoadsI32(tokens, cursor + 3, callEnd, resultName) +
                        "  " + resultName + " = call " + llvmType + " @" +
                        llvmRuntimeCallName(tokenTextAt(tokens, cursor + 1)) + "(" +
                        generateLLVMCallArgumentListI32(tokens, cursor + 3, callEnd, resultName) + ")\n" +
                        "  ret " + llvmType + " " + resultName + "\n");
                }
                else {
                    csec_string_builder_append(builder, generateLLVMExpressionI32(tokens, cursor + 1, next, resultName) +
                        "  ret i32 " + resultName + "\n");
                }
            }
            else if (llvmExpressionLooksPtr(tokens, cursor + 1, next)) {
                val resultName: String = "%ret." + cursor;
                csec_string_builder_append(builder, generateLLVMExpressionPtr(tokens, cursor + 1, next, resultName) +
                    "  ret ptr " + resultName + "\n");
            }
            else {
                val resultName: String = "%ret." + cursor;
                csec_string_builder_append(builder, generateLLVMExpressionI32(tokens, cursor + 1, next, resultName) +
                    "  ret i32 " + resultName + "\n");
            }
        }
        else if (strEq(kind, "if")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val thenStart: Int = findStatementBlockStart(tokens, cursor, next);
            val thenEnd: Int = findClosingToken(tokens, thenStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
                csec_string_builder_append(builder, "  ; malformed if\n");
            }
            else {
                val labelSeed: String = "" + cursor;
                val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
                val thenBody: String = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
                var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
                    thenBranch = "";
                }
                var elseBody: String = "";
                var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                    if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                        val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                        if (elseEnd > elseStart) {
                            elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                            if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                                elseBranch = "";
                            }
                        }
                    }
                }
                csec_string_builder_append(builder, generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
                    "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
                    ", label %if.else." + labelSeed + "\n" +
                    "if.then." + labelSeed + ":\n" +
                    thenBody +
                    thenBranch +
                    "if.else." + labelSeed + ":\n" +
                    elseBody +
                    elseBranch +
                    "if.end." + labelSeed + ":\n");
            }
        }
        else if (strEq(kind, "while")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val bodyStart: Int = findStatementBlockStart(tokens, cursor, next);
            val bodyEnd: Int = findClosingToken(tokens, bodyStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
                csec_string_builder_append(builder, "  ; malformed while\n");
            }
            else {
                val labelSeed: String = "" + cursor;
                val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
                var continueBranch: String = "  br label %while.cond." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
                    continueBranch = "";
                }
                csec_string_builder_append(builder, "  br label %while.cond." + labelSeed + "\n" +
                    "while.cond." + labelSeed + ":\n" +
                    generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%whilecond." + labelSeed) +
                    "  br i1 %whilecond." + labelSeed + ", label %while.body." + labelSeed +
                    ", label %while.end." + labelSeed + "\n" +
                    "while.body." + labelSeed + ":\n" +
                    body +
                    continueBranch +
                    "while.end." + labelSeed + ":\n");
            }
        }
        else if (strEq(kind, "for")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val bodyStart: Int = findStatementBlockStart(tokens, cursor, next);
            val bodyEnd: Int = findClosingToken(tokens, bodyStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
                csec_string_builder_append(builder, "  ; malformed for\n");
            }
            else if (tokenKindAt(tokens, openParen + 1) != kindIdentifier()) {
                csec_string_builder_append(builder, "  ; malformed for iterator\n");
            }
            else {
                val iteratorName: String = tokenTextAt(tokens, openParen + 1);
                val sourceArrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
                if (sourceArrow < 0) {
                    csec_string_builder_append(builder, "  ; malformed for source\n");
                }
                else {
                    val rangeOp: Int = findTopLevelOperator(tokens, sourceArrow + 1, closeParen, 5);
                    if (rangeOp <= sourceArrow) {
                        csec_string_builder_append(builder, "  ; unsupported for source\n");
                    }
                    else {
                        val labelSeed: String = "" + cursor;
                        var compareOp: String = "slt";
                        if (strEq(tokenTextAt(tokens, rangeOp), "to") or strEq(tokenTextAt(tokens, rangeOp), "..")) {
                            compareOp = "sle";
                        }
                        val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
                        var stepBranch: String = "  %" + iteratorName + ".step." + labelSeed + " = load i32, ptr %" + iteratorName + "\n" +
                            "  %" + iteratorName + ".next." + labelSeed + " = add i32 %" + iteratorName + ".step." + labelSeed + ", 1\n" +
                            "  store i32 %" + iteratorName + ".next." + labelSeed + ", ptr %" + iteratorName + "\n" +
                            "  br label %for.cond." + labelSeed + "\n";
                        if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
                            stepBranch = "";
                        }
                        csec_string_builder_append(builder, "  %" + iteratorName + " = alloca i32\n" +
                            generateLLVMExpressionI32(tokens, sourceArrow + 1, rangeOp, "%" + iteratorName + ".start") +
                            "  store i32 %" + iteratorName + ".start, ptr %" + iteratorName + "\n" +
                            "  br label %for.cond." + labelSeed + "\n" +
                            "for.cond." + labelSeed + ":\n" +
                            "  %" + iteratorName + ".val = load i32, ptr %" + iteratorName + "\n" +
                            generateLLVMExpressionI32(tokens, rangeOp + 1, closeParen, "%" + iteratorName + ".end") +
                            "  %forcond." + labelSeed + " = icmp " + compareOp + " i32 %" + iteratorName + ".val, %" + iteratorName + ".end\n" +
                            "  br i1 %forcond." + labelSeed + ", label %for.body." + labelSeed +
                            ", label %for.end." + labelSeed + "\n" +
                            "for.body." + labelSeed + ":\n" +
                            body +
                            stepBranch +
                            "for.end." + labelSeed + ":\n");
                    }
                }
            }
        }
        else {
            if (tokenKindAt(tokens, cursor) == kindIdentifier() and cursor + 1 < next and
                tokenIs(tokens, cursor + 1, kindOperator(), "(") and
                strEq(tokenTextAt(tokens, cursor), "csec_string_builder_append")) {
                val callEnd: Int = findClosingToken(tokens, cursor + 1, next, "(", ")");
                if (callEnd > cursor + 1) {
                    val resultName: String = "%append." + cursor;
                    csec_string_builder_append(builder,
                        generateLLVMCallArgumentLoadsI32(tokens, cursor + 2, callEnd, resultName) +
                        "  " + resultName + " = call i32 @csec_string_builder_append(" +
                        generateLLVMCallArgumentListI32(tokens, cursor + 2, callEnd, resultName) + ")\n");
                }
            }
            else
            if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
                val targetType: String = lookupVisibleValueType(tokens, cursor, tokenTextAt(tokens, cursor));
                if (strEq(targetType, "Boolean")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentI1(tokens, cursor, next));
                }
                else if (strEq(targetType, "Double")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentF64(tokens, cursor, next));
                }
                else if (strEq(targetType, "Long")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentI64(tokens, cursor, next));
                }
                else if (strEq(targetType, "Char")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentI8(tokens, cursor, next));
                }
                else if (strEq(irTypeName(targetType), "ptr")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentPtr(tokens, cursor, next));
                }
                else {
                    csec_string_builder_append(builder, generateLLVMAssignmentI32(tokens, cursor, next));
                }
            }
            else {
                csec_string_builder_append(builder, generateLLVMAssignmentI32(tokens, cursor, next));
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    return csec_string_builder_finish(builder);
}

def generateLLVMIfI32(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val thenStart: Int = findStatementBlockStart(tokens, start, end);
    val thenEnd: Int = findClosingToken(tokens, thenStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
        return "  ; malformed if\n";
    }
    val labelSeed: String = "" + start;
    val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
    val thenBody: String = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
    var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
    if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
        thenBranch = "";
    }
    var elseBody: String = "";
    var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
    if (possibleElse < end and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
        val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
        if (tokenIs(tokens, elseStart, kindKeyword(), "if")) {
            elseBody = generateLLVMIfI32(tokens, elseStart, end);
        }
        else if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
            val elseEnd: Int = findClosingToken(tokens, elseStart, end, "{", "}");
            if (elseEnd > elseStart) {
                elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                    elseBranch = "";
                }
            }
        }
    }
    return generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
        "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
        ", label %if.else." + labelSeed + "\n" +
        "if.then." + labelSeed + ":\n" +
        thenBody +
        thenBranch +
        "if.else." + labelSeed + ":\n" +
        elseBody +
        elseBranch +
        "if.end." + labelSeed + ":\n";
}

def generateLLVMWhileI32(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "  ; malformed while\n";
    }
    val labelSeed: String = "" + start;
    val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
    var continueBranch: String = "  br label %while.cond." + labelSeed + "\n";
    if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
        continueBranch = "";
    }
    return "  br label %while.cond." + labelSeed + "\n" +
        "while.cond." + labelSeed + ":\n" +
        generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%whilecond." + labelSeed) +
        "  br i1 %whilecond." + labelSeed + ", label %while.body." + labelSeed +
        ", label %while.end." + labelSeed + "\n" +
        "while.body." + labelSeed + ":\n" +
        body +
        continueBranch +
        "while.end." + labelSeed + ":\n";
}

def generateLLVMForI32(tokens: String, start: Int, end: Int): String {
    val openParen: Int = findStatementParenStart(tokens, start, end);
    val closeParen: Int = findStatementParenEnd(tokens, start, end);
    val bodyStart: Int = findStatementBlockStart(tokens, start, end);
    val bodyEnd: Int = findClosingToken(tokens, bodyStart, end, "{", "}");
    if (openParen < 0 or closeParen <= openParen or bodyStart < 0 or bodyEnd <= bodyStart) {
        return "  ; malformed for\n";
    }
    if (tokenKindAt(tokens, openParen + 1) != kindIdentifier()) {
        return "  ; malformed for iterator\n";
    }
    val iteratorName: String = tokenTextAt(tokens, openParen + 1);
    val sourceArrow: Int = findTokenTextInRange(tokens, openParen + 1, closeParen, "<-");
    if (sourceArrow < 0) {
        return "  ; malformed for source\n";
    }
    val rangeOp: Int = findTopLevelOperator(tokens, sourceArrow + 1, closeParen, 5);
    if (rangeOp <= sourceArrow) {
        return "  ; unsupported for source\n";
    }
    val labelSeed: String = "" + start;
    var compareOp: String = "slt";
    if (strEq(tokenTextAt(tokens, rangeOp), "to") or strEq(tokenTextAt(tokens, rangeOp), "..")) {
        compareOp = "sle";
    }
    val body: String = generateLLVMFlatBodyI32(tokens, bodyStart + 1, bodyEnd);
    var stepBranch: String = "  %" + iteratorName + ".step." + labelSeed + " = load i32, ptr %" + iteratorName + "\n" +
        "  %" + iteratorName + ".next." + labelSeed + " = add i32 %" + iteratorName + ".step." + labelSeed + ", 1\n" +
        "  store i32 %" + iteratorName + ".next." + labelSeed + ", ptr %" + iteratorName + "\n" +
        "  br label %for.cond." + labelSeed + "\n";
    if (llvmBlockEndsWithTopLevelReturn(tokens, bodyStart + 1, bodyEnd)) {
        stepBranch = "";
    }
    return "  %" + iteratorName + " = alloca i32\n" +
        generateLLVMExpressionI32(tokens, sourceArrow + 1, rangeOp, "%" + iteratorName + ".start") +
        "  store i32 %" + iteratorName + ".start, ptr %" + iteratorName + "\n" +
        "  br label %for.cond." + labelSeed + "\n" +
        "for.cond." + labelSeed + ":\n" +
        "  %" + iteratorName + ".val = load i32, ptr %" + iteratorName + "\n" +
        generateLLVMExpressionI32(tokens, rangeOp + 1, closeParen, "%" + iteratorName + ".end") +
        "  %forcond." + labelSeed + " = icmp " + compareOp + " i32 %" + iteratorName + ".val, %" + iteratorName + ".end\n" +
        "  br i1 %forcond." + labelSeed + ", label %for.body." + labelSeed +
        ", label %for.end." + labelSeed + "\n" +
        "for.body." + labelSeed + ":\n" +
        body +
        stepBranch +
        "for.end." + labelSeed + ":\n";
}

def generateLLVMReturnI32(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = bodyStart;
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindInteger() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                return "  ret i32 " + tokenTextAt(tokens, cursor + 1) + "\n";
            }
            return generateLLVMExpressionI32(tokens, cursor + 1, advanceStatement(tokens, cursor, bodyEnd), "%ret") +
                "  ret i32 %ret\n";
        }
        cursor = cursor + 1;
    }
    return "  ret i32 0\n";
}

def generateLLVMDottedStatementCall(tokens: String, cursor: Int, next: Int): String {
    if (tokenIs(tokens, cursor, kindIdentifier(), "System") and
        tokenIs(tokens, cursor + 1, kindOperator(), ".") and
        tokenIs(tokens, cursor + 2, kindIdentifier(), "IO") and
        tokenIs(tokens, cursor + 3, kindOperator(), ".") and
        tokenIs(tokens, cursor + 4, kindIdentifier(), "File") and
        tokenIs(tokens, cursor + 5, kindOperator(), ".") and
        tokenIs(tokens, cursor + 6, kindIdentifier(), "WriteAllText") and
        tokenIs(tokens, cursor + 7, kindOperator(), "(")) {
        val callEnd: Int = findClosingToken(tokens, cursor + 7, next, "(", ")");
        if (callEnd > cursor + 7) {
            val resultName: String = "%file.write." + cursor;
            return generateLLVMCallArgumentLoadsI32(tokens, cursor + 8, callEnd, resultName) +
                "  " + resultName + " = call i32 @csec_file_write_all_text(" +
                generateLLVMCallArgumentListI32(tokens, cursor + 8, callEnd, resultName) + ")\n";
        }
    }
    if (tokenIs(tokens, cursor, kindIdentifier(), "System") and
        tokenIs(tokens, cursor + 1, kindOperator(), ".") and
        tokenIs(tokens, cursor + 2, kindIdentifier(), "Console") and
        tokenIs(tokens, cursor + 3, kindOperator(), ".") and
        tokenIs(tokens, cursor + 4, kindIdentifier(), "WriteLine") and
        tokenIs(tokens, cursor + 5, kindOperator(), "(")) {
        val callEnd: Int = findClosingToken(tokens, cursor + 5, next, "(", ")");
        if (callEnd > cursor + 5) {
            val resultName: String = "%console.write." + cursor;
            return generateLLVMCallArgumentLoadsI32(tokens, cursor + 6, callEnd, resultName) +
                "  call void @csec_print_string(" +
                generateLLVMCallArgumentListI32(tokens, cursor + 6, callEnd, resultName) + ")\n" +
                "  call void @csec_print_newline()\n";
        }
    }
    return "";
}

def generateLLVMMainBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    val builder: Long = csec_string_builder_new();
    var cursor: Int = skipTrivia(tokens, bodyStart);
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "value") or strEq(kind, "variable")) {
            if (strEq(localDeclarationType(tokens, cursor, next), "Int") or
                strEq(localDeclarationType(tokens, cursor, next), "unknown")) {
                csec_string_builder_append(builder, generateLLVMLocalI32(tokens, cursor, next));
            }
            if (strEq(localDeclarationType(tokens, cursor, next), "Boolean")) {
                csec_string_builder_append(builder, generateLLVMLocalI1(tokens, cursor, next));
            }
            if (strEq(localDeclarationType(tokens, cursor, next), "Double")) {
                csec_string_builder_append(builder, generateLLVMLocalF64(tokens, cursor, next));
            }
            if (strEq(localDeclarationType(tokens, cursor, next), "Long")) {
                csec_string_builder_append(builder, generateLLVMLocalI64(tokens, cursor, next));
            }
            if (strEq(localDeclarationType(tokens, cursor, next), "Char")) {
                csec_string_builder_append(builder, generateLLVMLocalI8(tokens, cursor, next));
            }
            else if (strEq(irTypeName(localDeclarationType(tokens, cursor, next)), "ptr")) {
                csec_string_builder_append(builder, generateLLVMLocalPtr(tokens, cursor, next));
            }
        }
        if (strEq(kind, "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindInteger() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, "  ret i32 " + tokenTextAt(tokens, cursor + 1) + "\n");
                return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val returnName: String = tokenTextAt(tokens, cursor + 1);
                val returnType: String = lookupVisibleValueType(tokens, cursor, returnName);
                if (strEq(returnType, "Boolean")) {
                    csec_string_builder_append(builder, llvmLoadForValueType(tokens, cursor, returnName, returnType, "%" + returnName + ".ret") +
                        "  %ret.bool = zext i1 %" + returnName + ".ret to i32\n" + "  ret i32 %ret.bool\n");
                    return csec_string_builder_finish(builder);
                }
                if (strEq(returnType, "Double")) {
                    csec_string_builder_append(builder, llvmLoadForValueType(tokens, cursor, returnName, returnType, "%" + returnName + ".ret") +
                        "  %ret.double = fptosi double %" + returnName + ".ret to i32\n" + "  ret i32 %ret.double\n");
                    return csec_string_builder_finish(builder);
                }
                csec_string_builder_append(builder, llvmLoadForValueType(tokens, cursor, returnName, returnType, "%" + returnName + ".ret") +
                    "  ret i32 %" + returnName + ".ret\n");
                return csec_string_builder_finish(builder);
            }
            csec_string_builder_append(builder, generateLLVMExpressionI32(tokens, cursor + 1, next, "%ret") + "  ret i32 %ret\n");
            return csec_string_builder_finish(builder);
        }
        if (strEq(kind, "if")) {
            csec_string_builder_append(builder, generateLLVMIfI32(tokens, cursor, next));
        }
        if (strEq(kind, "while")) {
            csec_string_builder_append(builder, generateLLVMWhileI32(tokens, cursor, next));
        }
        if (strEq(kind, "for")) {
            csec_string_builder_append(builder, generateLLVMForI32(tokens, cursor, next));
        }
        if (!strEq(kind, "value") and !strEq(kind, "variable") and
            !strEq(kind, "return") and !strEq(kind, "if") and
            !strEq(kind, "while") and !strEq(kind, "for")) {
            val statementCall: String = generateLLVMDottedStatementCall(tokens, cursor, next);
            if (statementCall.length > 0) {
                csec_string_builder_append(builder, statementCall);
            }
            if (statementCall.length == 0 and tokenKindAt(tokens, cursor) == kindIdentifier()) {
                val targetType: String = lookupVisibleValueType(tokens, cursor, tokenTextAt(tokens, cursor));
                if (strEq(targetType, "Boolean")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentI1(tokens, cursor, next));
                }
                if (strEq(targetType, "Double")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentF64(tokens, cursor, next));
                }
                if (strEq(targetType, "Long")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentI64(tokens, cursor, next));
                }
                if (strEq(targetType, "Char")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentI8(tokens, cursor, next));
                }
                if (strEq(irTypeName(targetType), "ptr")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentPtr(tokens, cursor, next));
                }
                if (!strEq(targetType, "Boolean") and !strEq(targetType, "Double") and
                    !strEq(targetType, "Long") and !strEq(targetType, "Char") and
                    !strEq(irTypeName(targetType), "ptr")) {
                    csec_string_builder_append(builder, generateLLVMAssignmentI32(tokens, cursor, next));
                }
            }
            if (statementCall.length == 0 and tokenKindAt(tokens, cursor) != kindIdentifier()) {
                csec_string_builder_append(builder, generateLLVMAssignmentI32(tokens, cursor, next));
            }
        }
        cursor = skipTrivia(tokens, next);
    }
    csec_string_builder_append(builder, "  ret i32 0\n");
    return csec_string_builder_finish(builder);
}

def generateLLVMParamList(tokens: String, declStart: Int): String {
    return csec_function_llvm_param_list(tokens, declStart);
}

def generateLLVMParamListSlow(tokens: String, declStart: Int): String {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return "";
    }
    val paramEnd: Int = csec_function_param_end(tokens, declStart);
    if (paramEnd <= paramStart) {
        return "";
    }
    var cursor: Int = paramStart + 1;
    var output: String = "";
    var first: Boolean = true;
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            var typeName: String = "unknown";
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                typeName = typeSummary(tokens, cursor + 2, paramEnd);
            }
            if (!first) {
                output = output + ", ";
            }
            output = output + irTypeName(typeName) + " %arg." + tokenTextAt(tokens, cursor);
            first = false;
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return output;
}

def generateLLVMParamAllocas(tokens: String, declStart: Int): String {
    return csec_function_llvm_param_allocas(tokens, declStart);
}

def generateLLVMParamAllocasSlow(tokens: String, declStart: Int): String {
    val paramStart: Int = findFunctionParamStart(tokens, declStart);
    if (paramStart < 0) {
        return "";
    }
    val paramEnd: Int = findClosingToken(tokens, paramStart, advanceTopLevelDecl(tokens, declStart), "(", ")");
    if (paramEnd <= paramStart) {
        return "";
    }
    var cursor: Int = paramStart + 1;
    var output: String = "";
    while (cursor < paramEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            val name: String = tokenTextAt(tokens, cursor);
            var typeName: String = "unknown";
            if (tokenIs(tokens, cursor + 1, kindOperator(), ":")) {
                typeName = typeSummary(tokens, cursor + 2, paramEnd);
            }
            val llvmType: String = irTypeName(typeName);
            output = output +
                "  %" + name + " = alloca " + llvmType + "\n" +
                "  store " + llvmType + " %arg." + name + ", ptr %" + name + "\n";
        }
        while (cursor < paramEnd and !tokenIs(tokens, cursor, kindOperator(), ",")) {
            cursor = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return output;
}

def generateLLVMBooleanBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    val builder: Long = csec_string_builder_new();
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            val resultName: String = csec_llvm_name_with_number("%ret.", cursor);
            val comparison: Int = findTopLevelOperator(tokens, cursor + 1, next, 4);
            if (comparison > cursor + 1 and tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenKindAt(tokens, comparison + 1) == kindInteger()) {
                val comparisonName: String = irOperatorName(tokenTextAt(tokens, comparison));
                val predicate: String = comparisonName.substring(5, comparisonName.length - 5);
                val leftName: String = tokenTextAt(tokens, cursor + 1);
                val leftStorage: String = lookupVisibleStorageName(tokens, cursor + 1, leftName);
                csec_string_builder_append(builder, "  " + resultName + ".left.i32 = load i32, ptr %" + leftStorage + "\n" +
                    "  " + resultName + ".right.i32 = add i32 0, " + tokenTextAt(tokens, comparison + 1) + "\n" +
                    "  " + resultName + " = icmp " + predicate + " i32 " + resultName + ".left.i32, " +
                    resultName + ".right.i32\n" + "  ret i1 " + resultName + "\n");
                return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindBool() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, generateLLVMExpressionI1(tokens, cursor + 1, next, resultName) +
                    "  ret i1 " + resultName + "\n");
                return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, "  " + resultName + " = load i1, ptr %" +
                    lookupVisibleStorageName(tokens, cursor + 1, tokenTextAt(tokens, cursor + 1)) + "\n" +
                    "  ret i1 " + resultName + "\n");
                return csec_string_builder_finish(builder);
            }
            csec_string_builder_append(builder, generateLLVMExpressionI1(tokens, cursor + 1, next, resultName) +
                "  ret i1 " + resultName + "\n");
            return csec_string_builder_finish(builder);
        }
        else if (strEq(kind, "if")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val thenStart: Int = findStatementBlockStart(tokens, cursor, next);
            val thenEnd: Int = findClosingToken(tokens, thenStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
                csec_string_builder_append(builder, "  ; malformed if\n");
            }
            else {
                val labelSeed: String = "" + cursor;
                val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
                var thenBody: String = "";
                var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
                    thenBody = generateLLVMBooleanBodyFromRange(tokens, thenStart + 1, thenEnd);
                    thenBranch = "";
                }
                else {
                    thenBody = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
                }
                var elseBody: String = "";
                var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                    if (tokenIs(tokens, elseStart, kindKeyword(), "if")) {
                        elseBody = generateLLVMFlatBodyI32(tokens, elseStart, next);
                    }
                    else if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                        val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                        if (elseEnd > elseStart) {
                            if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                                elseBody = generateLLVMBooleanBodyFromRange(tokens, elseStart + 1, elseEnd);
                                elseBranch = "";
                            }
                            else {
                                elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                            }
                        }
                    }
                }
                csec_string_builder_append(builder, generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
                    "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
                    ", label %if.else." + labelSeed + "\n" +
                    "if.then." + labelSeed + ":\n" +
                    thenBody +
                    thenBranch +
                    "if.else." + labelSeed + ":\n" +
                    elseBody +
                    elseBranch +
                    "if.end." + labelSeed + ":\n");
            }
        }
        else {
            csec_string_builder_append(builder, generateLLVMFlatBodyI32(tokens, cursor, next));
        }
        cursor = skipTrivia(tokens, next);
    }
    csec_string_builder_append(builder, "  ret i1 false\n");
    return csec_string_builder_finish(builder);
}

def generateLLVMCharBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    val builder: Long = csec_string_builder_new();
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindChar() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                    csec_string_builder_append(builder, "  ret i8 " + llvmCharI8Value(tokenTextAt(tokens, cursor + 1)) + "\n");
                    return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, "  %ret = load i8, ptr %" +
                    lookupVisibleStorageName(tokens, cursor + 1, tokenTextAt(tokens, cursor + 1)) + "\n" +
                    "  ret i8 %ret\n");
                return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and cursor + 2 < next and
                tokenIs(tokens, cursor + 2, kindOperator(), "(")) {
                val callEnd: Int = findClosingToken(tokens, cursor + 2, next, "(", ")");
                if (callEnd > cursor + 2) {
                    val resultName: String = "%ret." + cursor;
                    csec_string_builder_append(builder, generateLLVMCallArgumentLoadsI32(tokens, cursor + 3, callEnd, resultName) +
                        "  " + resultName + " = call i8 @" + llvmRuntimeCallName(tokenTextAt(tokens, cursor + 1)) + "(" +
                        generateLLVMCallArgumentListI32(tokens, cursor + 3, callEnd, resultName) + ")\n" +
                        "  ret i8 " + resultName + "\n");
                    return csec_string_builder_finish(builder);
                }
            }
        }
        csec_string_builder_append(builder, generateLLVMFlatBodyI32(tokens, cursor, next));
        cursor = skipTrivia(tokens, next);
    }
    csec_string_builder_append(builder, "  ret i8 0\n");
    return csec_string_builder_finish(builder);
}

def generateLLVMDoubleBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    val builder: Long = csec_string_builder_new();
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            if ((tokenKindAt(tokens, cursor + 1) == kindFloat() or
                tokenKindAt(tokens, cursor + 1) == kindInteger()) and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, generateLLVMExpressionF64(tokens, cursor + 1, next, "%ret") +
                    "  ret double %ret\n");
                return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, "  %ret = load double, ptr %" +
                    lookupVisibleStorageName(tokens, cursor + 1, tokenTextAt(tokens, cursor + 1)) + "\n" +
                    "  ret double %ret\n");
                return csec_string_builder_finish(builder);
            }
            csec_string_builder_append(builder, generateLLVMExpressionF64(tokens, cursor + 1, next, "%ret") +
                "  ret double %ret\n");
            return csec_string_builder_finish(builder);
        }
        csec_string_builder_append(builder, generateLLVMFlatBodyI32(tokens, cursor, next));
        cursor = skipTrivia(tokens, next);
    }
    csec_string_builder_append(builder, "  ret double 0.000000e+00\n");
    return csec_string_builder_finish(builder);
}

def generateLLVMLongBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    val builder: Long = csec_string_builder_new();
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            if (tokenKindAt(tokens, cursor + 1) == kindInteger() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, generateLLVMExpressionI64(tokens, cursor + 1, next, "%ret") +
                    "  ret i64 %ret\n");
                return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, "  %ret = load i64, ptr %" +
                    lookupVisibleStorageName(tokens, cursor + 1, tokenTextAt(tokens, cursor + 1)) + "\n" +
                    "  ret i64 %ret\n");
                return csec_string_builder_finish(builder);
            }
            csec_string_builder_append(builder, generateLLVMExpressionI64(tokens, cursor + 1, next, "%ret") +
                "  ret i64 %ret\n");
            return csec_string_builder_finish(builder);
        }
        csec_string_builder_append(builder, generateLLVMFlatBodyI32(tokens, cursor, next));
        cursor = skipTrivia(tokens, next);
    }
    csec_string_builder_append(builder, "  ret i64 0\n");
    return csec_string_builder_finish(builder);
}

def llvmStringLiteralByteLength(text: String): Int {
    var cursor: Int = 0;
    var length: Int = 1;
    while (cursor < text.length) {
        if (text.charAt(cursor) == '\\' and cursor + 1 < text.length) {
            cursor = cursor + 2;
        }
        else {
            cursor = cursor + 1;
        }
        length = length + 1;
    }
    return length;
}

def generateLLVMPointerBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    val builder: Long = csec_string_builder_new();
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        val kind: String = statementKind(tokens, cursor);
        if (strEq(kind, "return")) {
            val resultName: String = "%ret." + cursor;
            if (tokenKindAt(tokens, cursor + 1) == kindString() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                val text: String = tokenTextAt(tokens, cursor + 1);
                val byteLength: Int = llvmStringLiteralByteLength(text);
                csec_string_builder_append(builder, "  " + resultName + " = getelementptr inbounds [" + byteLength + " x i8], ptr @.str." + (cursor + 1) +
                    ", i32 0, i32 0\n" +
                    "  ret ptr " + resultName + "\n");
                return csec_string_builder_finish(builder);
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), "(")) {
                val callEnd: Int = findClosingToken(tokens, cursor + 2, next, "(", ")");
                if (callEnd > cursor + 2) {
                    csec_string_builder_append(builder, generateLLVMExpressionPtr(tokens, cursor + 1, next, resultName) +
                        "  ret ptr " + resultName + "\n");
                    return csec_string_builder_finish(builder);
                }
            }
            if (tokenKindAt(tokens, cursor + 1) == kindIdentifier() and
                tokenIs(tokens, cursor + 2, kindOperator(), ";")) {
                csec_string_builder_append(builder, "  " + resultName + " = load ptr, ptr %" +
                    lookupVisibleStorageName(tokens, cursor + 1, tokenTextAt(tokens, cursor + 1)) + "\n" +
                    "  ret ptr " + resultName + "\n");
                return csec_string_builder_finish(builder);
            }
            if (llvmExpressionLooksPtr(tokens, cursor + 1, next)) {
                csec_string_builder_append(builder, generateLLVMExpressionPtr(tokens, cursor + 1, next, resultName) +
                    "  ret ptr " + resultName + "\n");
                return csec_string_builder_finish(builder);
            }
            csec_string_builder_append(builder, "  ret ptr null\n");
            return csec_string_builder_finish(builder);
        }
        else if (strEq(kind, "value") or strEq(kind, "variable")) {
            csec_string_builder_append(builder, generateLLVMFlatBodyI32(tokens, cursor, next));
        }
        else if (strEq(kind, "if")) {
            val openParen: Int = findStatementParenStart(tokens, cursor, next);
            val closeParen: Int = findStatementParenEnd(tokens, cursor, next);
            val thenStart: Int = findStatementBlockStart(tokens, cursor, next);
            val thenEnd: Int = findClosingToken(tokens, thenStart, next, "{", "}");
            if (openParen < 0 or closeParen <= openParen or thenStart < 0 or thenEnd <= thenStart) {
                csec_string_builder_append(builder, "  ; malformed if\n");
            }
            else {
                val labelSeed: String = "" + cursor;
                val possibleElse: Int = skipTrivia(tokens, thenEnd + 1);
                var thenBody: String = "";
                var thenBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (llvmBlockEndsWithTopLevelReturn(tokens, thenStart + 1, thenEnd)) {
                    thenBody = generateLLVMPointerBodyFromRange(tokens, thenStart + 1, thenEnd);
                    thenBranch = "";
                }
                else {
                    thenBody = generateLLVMFlatBodyI32(tokens, thenStart + 1, thenEnd);
                }
                var elseBody: String = "";
                var elseBranch: String = "  br label %if.end." + labelSeed + "\n";
                if (possibleElse < next and tokenIs(tokens, possibleElse, kindKeyword(), "else")) {
                    val elseStart: Int = skipTrivia(tokens, possibleElse + 1);
                    if (tokenIs(tokens, elseStart, kindOperator(), "{")) {
                        val elseEnd: Int = findClosingToken(tokens, elseStart, next, "{", "}");
                        if (elseEnd > elseStart) {
                            if (llvmBlockEndsWithTopLevelReturn(tokens, elseStart + 1, elseEnd)) {
                                elseBody = generateLLVMPointerBodyFromRange(tokens, elseStart + 1, elseEnd);
                                elseBranch = "";
                            }
                            else {
                                elseBody = generateLLVMFlatBodyI32(tokens, elseStart + 1, elseEnd);
                            }
                        }
                    }
                }
                csec_string_builder_append(builder, generateLLVMExpressionI1(tokens, openParen + 1, closeParen, "%cond." + labelSeed) +
                    "  br i1 %cond." + labelSeed + ", label %if.then." + labelSeed +
                    ", label %if.else." + labelSeed + "\n" +
                    "if.then." + labelSeed + ":\n" +
                    thenBody +
                    thenBranch +
                    "if.else." + labelSeed + ":\n" +
                    elseBody +
                    elseBranch +
                    "if.end." + labelSeed + ":\n");
            }
        }
        else if (tokenKindAt(tokens, cursor) == kindIdentifier()) {
            csec_string_builder_append(builder, generateLLVMAssignmentPtr(tokens, cursor, next));
        }
        else {
            csec_string_builder_append(builder, generateLLVMFlatBodyI32(tokens, cursor, next));
        }
        cursor = skipTrivia(tokens, next);
    }
    csec_string_builder_append(builder, "  ret ptr null\n");
    return csec_string_builder_finish(builder);
}

def generateLLVMVoidBodyFromRange(tokens: String, bodyStart: Int, bodyEnd: Int): String {
    var cursor: Int = skipTrivia(tokens, bodyStart);
    val builder: Long = csec_string_builder_new();
    while (cursor < bodyEnd and tokenKindAt(tokens, cursor) != kindEof()) {
        val next: Int = advanceStatement(tokens, cursor, bodyEnd);
        if (strEq(statementKind(tokens, cursor), "return")) {
            csec_string_builder_append(builder, "  ret void\n");
            return csec_string_builder_finish(builder);
        }
        csec_string_builder_append(builder, generateLLVMFlatBodyI32(tokens, cursor, next));
        cursor = skipTrivia(tokens, next);
    }
    csec_string_builder_append(builder, "  ret void\n");
    return csec_string_builder_finish(builder);
}

def llvmStringLiteralBytes(text: String): String {
    return csec_llvm_string_literal_bytes(text);
}

def generateLLVMStringLiteralGlobals(tokens: String): String {
    var cursor: Int = 0;
    val builder: Long = csec_string_builder_new();
    var emitted: Boolean = false;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenKindAt(tokens, cursor) == kindString()) {
            val text: String = tokenTextAt(tokens, cursor);
            val byteLength: Int = llvmStringLiteralByteLength(text);
            csec_string_builder_append(builder, "@.str." + cursor +
                " = private unnamed_addr constant [" + byteLength + " x i8] c\"" +
                llvmStringLiteralBytes(text) + "\"\n");
            emitted = true;
        }
        cursor = cursor + 1;
    }
    if (emitted) {
        csec_string_builder_append(builder, "\n");
    }
    return csec_string_builder_finish(builder);
}

def generateLLVMFunctionDefinition(tokens: String, declStart: Int): String {
    val name: String = topLevelDeclName(tokens, declStart);
    var symbolName: String = name;
    if (strEq(name, "main")) {
        symbolName = "csec_user_main";
    }
    val returnType: String = functionReturnType(tokens, declStart);
    val lexerHelper: String = csec_llvm_lexer_helper_definition(name);
    if (lexerHelper.length > 0) {
        return lexerHelper;
    }
    val bodyStart: Int = findDeclBodyStart(tokens, declStart);
    val bodyEnd: Int = findDeclBodyEnd(tokens, bodyStart);
    val declEnd: Int = advanceTopLevelDecl(tokens, declStart);
    val expressionStart: Int = findTopLevelOperator(tokens, declStart, declEnd, 1);
    if (expressionStart > declStart and (bodyStart < 0 or expressionStart < bodyStart)) {
        val valueStart: Int = skipTrivia(tokens, expressionStart + 1);
        val valueEnd: Int = trimExpressionEnd(tokens, valueStart, declEnd);
        if (strEq(returnType, "Char") and tokenKindAt(tokens, valueStart) == kindChar() and valueEnd == valueStart + 1) {
            return "define i8 @" + symbolName + "() {\nentry:\n" +
                "  ret i8 " + llvmCharI8Value(tokenTextAt(tokens, valueStart)) + "\n}\n\n";
        }
        if (strEq(returnType, "Int") and tokenKindAt(tokens, valueStart) == kindInteger() and valueEnd == valueStart + 1) {
            return "define i32 @" + symbolName + "() {\nentry:\n" +
                "  ret i32 " + tokenTextAt(tokens, valueStart) + "\n}\n\n";
        }
        if (strEq(returnType, "Boolean") and tokenKindAt(tokens, valueStart) == kindBool() and valueEnd == valueStart + 1) {
            return "define i1 @" + symbolName + "() {\nentry:\n" +
                "  ret i1 " + tokenTextAt(tokens, valueStart) + "\n}\n\n";
        }
        if (strEq(irTypeName(returnType), "ptr") and tokenKindAt(tokens, valueStart) == kindString() and valueEnd == valueStart + 1) {
            val text: String = tokenTextAt(tokens, valueStart);
            val byteLength: Int = llvmStringLiteralByteLength(text);
            return "define ptr @" + symbolName + "() {\nentry:\n" +
                "  %ret = getelementptr inbounds [" + byteLength + " x i8], ptr @.str." + valueStart +
                ", i32 0, i32 0\n" +
                "  ret ptr %ret\n}\n\n";
        }
    }
    if (bodyStart < 0 or bodyEnd <= bodyStart) {
        return "";
    }
    if (strEq(irTypeName(returnType), "ptr")) {
        val first: Int = skipTrivia(tokens, bodyStart);
        val firstNext: Int = advanceStatement(tokens, first, bodyEnd);
        val second: Int = skipTrivia(tokens, firstNext);
        val secondNext: Int = advanceStatement(tokens, second, bodyEnd);
        val result: Int = skipTrivia(tokens, secondNext);
        if ((strEq(statementKind(tokens, first), "value") or strEq(statementKind(tokens, first), "variable")) and
            strEq(statementKind(tokens, result), "return") and
            tokenKindAt(tokens, result + 1) == kindIdentifier() and
            tokenIs(tokens, result + 2, kindOperator(), ";") and
            strEq(tokenTextAt(tokens, first + 1), tokenTextAt(tokens, result + 1))) {
            val storageName: String = tokenTextAt(tokens, first + 1) + ".addr." + first;
            return "define ptr @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
                "entry:\n" +
                generateLLVMParamAllocas(tokens, declStart) +
                generateLLVMFlatBodyI32(tokens, first, result) +
                "  %ret = load ptr, ptr %" + storageName + "\n" +
                "  ret ptr %ret\n}\n\n";
        }
    }
    val simpleFirst: Int = skipTrivia(tokens, bodyStart);
    val simpleFirstNext: Int = advanceStatement(tokens, simpleFirst, bodyEnd);
    val simpleSecond: Int = skipTrivia(tokens, simpleFirstNext);
    val simpleSecondNext: Int = advanceStatement(tokens, simpleSecond, bodyEnd);
    val simpleReturn: Int = skipTrivia(tokens, simpleSecondNext);
    val simpleName: String = tokenTextAt(tokens, simpleFirst + 1);
    val simpleInitializer: Int = findTopLevelOperator(tokens, simpleFirst, simpleFirstNext, 1);
    if ((strEq(returnType, "Char") or strEq(returnType, "Double") or strEq(returnType, "Long")) and
        (strEq(statementKind(tokens, simpleFirst), "value") or strEq(statementKind(tokens, simpleFirst), "variable")) and
        tokenKindAt(tokens, simpleSecond) == kindIdentifier() and
        tokenIs(tokens, simpleSecond + 1, kindOperator(), "=") and
        strEq(statementKind(tokens, simpleReturn), "return") and
        strEq(tokenTextAt(tokens, simpleReturn + 1), simpleName)) {
        if (strEq(returnType, "Char")) {
            return "define i8 @" + symbolName + "() {\nentry:\n" +
                "  ret i8 " + llvmCharI8Value(tokenTextAt(tokens, simpleSecond + 2)) + "\n}\n\n";
        }
        if (strEq(returnType, "Double")) {
            return "define double @" + symbolName + "() {\nentry:\n" +
                "  ret double " + tokenTextAt(tokens, simpleInitializer + 1) + "\n}\n\n";
        }
        return "define i64 @" + symbolName + "() {\nentry:\n" +
            "  ret i64 " + tokenTextAt(tokens, simpleInitializer + 1) + "\n}\n\n";
    }
    if (strEq(returnType, "Int")) {
        val firstStatement: Int = skipTrivia(tokens, bodyStart);
        val firstStatementEnd: Int = advanceStatement(tokens, firstStatement, bodyEnd);
        if (strEq(statementKind(tokens, firstStatement), "return") and
            tokenKindAt(tokens, firstStatement + 1) == kindIdentifier() and
            tokenIs(tokens, firstStatement + 2, kindOperator(), "(")) {
            val callEnd: Int = findClosingToken(tokens, firstStatement + 2, firstStatementEnd, "(", ")");
            if (callEnd > firstStatement + 2) {
                val resultName: String = "%ret." + firstStatement;
                return "define i32 @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
                    "entry:\n" +
                    generateLLVMParamAllocas(tokens, declStart) +
                    generateLLVMCallArgumentLoadsI32(tokens, firstStatement + 3, callEnd, resultName) +
                    "  " + resultName + " = call i32 @" + llvmRuntimeCallName(tokenTextAt(tokens, firstStatement + 1)) + "(" +
                    generateLLVMCallArgumentListI32(tokens, firstStatement + 3, callEnd, resultName) + ")\n" +
                    "  ret i32 " + resultName + "\n}\n\n";
            }
        }
        val body: String = generateLLVMMainBodyFromRange(tokens, bodyStart, bodyEnd);
        return "define i32 @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            body +
            "}\n\n";
    }
    if (strEq(returnType, "Boolean")) {
        return "define i1 @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMBooleanBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Char")) {
        return "define i8 @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMCharBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Double")) {
        return "define double @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMDoubleBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Long")) {
        return "define i64 @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMLongBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(returnType, "Unit")) {
        return "define void @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMVoidBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    if (strEq(irTypeName(returnType), "ptr")) {
        return "define ptr @" + symbolName + "(" + generateLLVMParamList(tokens, declStart) + ") {\n" +
            "entry:\n" +
            generateLLVMParamAllocas(tokens, declStart) +
            generateLLVMPointerBodyFromRange(tokens, bodyStart, bodyEnd) +
            "}\n\n";
    }
    return "";
}

def generateLLVMModuleInto(tokens: String, builder: Long): Int {
    val appendHeader0: Int = csec_string_builder_append(builder, "; ModuleID = 'csec.selfhost'\n");
    val appendHeader1: Int = csec_string_builder_append(builder, "source_filename = \"csec.selfhost\"\n\n");
    val appendHeader2: Int = csec_string_builder_append(builder, "declare i64 @csec_string_length(ptr)\n");
    val appendHeader3: Int = csec_string_builder_append(builder, "declare i8 @csec_string_char_at(ptr, i32)\n\n");
    val appendHeader3a: Int = csec_string_builder_append(builder, "declare i32 @csec_lex_quoted(ptr, i32)\n");
    val appendHeader3b: Int = csec_string_builder_append(builder, "declare i32 @csec_lex_number(ptr, i32)\n");
    val appendHeader3ba: Int = csec_string_builder_append(builder, "declare i32 @csec_lex_identifier(ptr, i32)\n");
    val appendHeader3c: Int = csec_string_builder_append(builder, "declare i32 @csec_lex_line_comment(ptr, i32)\n");
    val appendHeader3d: Int = csec_string_builder_append(builder, "declare i32 @csec_lex_block_comment(ptr, i32)\n");
    val appendHeader3e: Int = csec_string_builder_append(builder, "declare i32 @csec_digit_value(i8)\n");
    val appendHeader3ea: Int = csec_string_builder_append(builder, "declare i32 @csec_to_int(ptr)\n");
    val appendHeader3eb: Int = csec_string_builder_append(builder, "declare i32 @csec_line_start(ptr, i32)\n");
    val appendHeader3ec: Int = csec_string_builder_append(builder, "declare i32 @csec_line_end(ptr, i32)\n");
    val appendHeader3ee: Int = csec_string_builder_append(builder, "declare i32 @csec_validate_balanced(ptr)\n");
    val appendHeader3ef: Int = csec_string_builder_append(builder, "declare i32 @csec_find_token_text_in_range(ptr, i32, i32, ptr)\n");
    val appendHeader3eg: Int = csec_string_builder_append(builder, "declare i32 @csec_find_closing_token(ptr, i32, i32, ptr, ptr)\n");
    val appendHeader3eh: Int = csec_string_builder_append(builder, "declare i32 @csec_find_statement_paren_start(ptr, i32, i32)\n");
    val appendHeader3ei: Int = csec_string_builder_append(builder, "declare i32 @csec_find_statement_paren_end(ptr, i32, i32)\n");
    val appendHeader3ej: Int = csec_string_builder_append(builder, "declare i32 @csec_find_statement_block_start(ptr, i32, i32)\n");
    val appendHeader3ek: Int = csec_string_builder_append(builder, "declare i32 @csec_find_statement_block_end(ptr, i32, i32)\n");
    val appendHeader3f: Int = csec_string_builder_append(builder, "declare ptr @csec_llvm_lexer_helper_definition(ptr)\n");
    val appendHeader4: Int = csec_string_builder_append(builder, "declare i64 @csec_string_builder_new()\n");
    val appendHeader4a: Int = csec_string_builder_append(builder, "declare i64 @csec_string_builder_new_file(ptr)\n");
    val appendHeader5: Int = csec_string_builder_append(builder, "declare i32 @csec_string_builder_append(i64, ptr)\n");
    val appendHeader6: Int = csec_string_builder_append(builder, "declare ptr @csec_string_builder_finish(i64)\n");
    val appendHeader7: Int = csec_string_builder_append(builder, "declare i32 @csec_string_builder_write_to_file(i64, ptr)\n");
    val appendHeader8: Int = csec_string_builder_append(builder, "declare void @csec_set_command_line_args(i32, ptr)\n");
    val appendHeader9: Int = csec_string_builder_append(builder, "declare i32 @csec_command_line_arg_count()\n");
    val appendHeader10: Int = csec_string_builder_append(builder, "declare ptr @csec_command_line_arg(i32)\n");
    val appendHeader11: Int = csec_string_builder_append(builder, "declare ptr @csec_file_read_all_text(ptr)\n");
    val appendHeader12: Int = csec_string_builder_append(builder, "declare i32 @csec_file_write_all_text(ptr, ptr)\n");
    val appendHeader13: Int = csec_string_builder_append(builder, "declare void @csec_print_string(ptr)\n");
    val appendHeader14: Int = csec_string_builder_append(builder, "declare void @csec_print_newline()\n");
    val appendHeader15: Int = csec_string_builder_append(builder, "declare ptr @csec_string_concat(ptr, ptr)\n");
    val appendHeader16: Int = csec_string_builder_append(builder, "declare i32 @csec_string_starts_with(ptr, ptr)\n");
    val appendHeader17: Int = csec_string_builder_append(builder, "declare ptr @csec_string_substring(ptr, i32, i32)\n");
    val appendHeader18: Int = csec_string_builder_append(builder, "declare ptr @csec_to_string_i64(i64)\n");
    val appendHeader19: Int = csec_string_builder_append(builder, "declare ptr @csec_to_string_char(i8)\n");
    val appendHeader20: Int = csec_string_builder_append(builder, "declare ptr @csec_token_append_owned(ptr, i8, ptr)\n");
    val appendHeader21: Int = csec_string_builder_append(builder, "declare i64 @csec_token_builder_new()\n");
    val appendHeader22: Int = csec_string_builder_append(builder, "declare i32 @csec_token_builder_append(i64, i8, ptr)\n");
    val appendHeader23: Int = csec_string_builder_append(builder, "declare ptr @csec_token_builder_finish(i64)\n");
    val appendHeader24: Int = csec_string_builder_append(builder, "declare ptr @csec_tokenize_source(ptr)\n");
    val appendHeader25: Int = csec_string_builder_append(builder, "declare i8 @csec_token_kind_at(ptr, i32)\n");
    val appendHeader26: Int = csec_string_builder_append(builder, "declare ptr @csec_token_text_at(ptr, i32)\n");
    val appendHeader27: Int = csec_string_builder_append(builder, "declare i32 @csec_token_is(ptr, i32, i8, ptr)\n");
    val appendHeader28: Int = csec_string_builder_append(builder, "declare i32 @csec_advance_statement(ptr, i32, i32)\n");
    val appendHeader29: Int = csec_string_builder_append(builder, "declare i32 @csec_advance_top_level_decl(ptr, i32)\n");
    val appendHeader30: Int = csec_string_builder_append(builder, "declare i32 @csec_find_decl_body_start(ptr, i32)\n");
    val appendHeader31: Int = csec_string_builder_append(builder, "declare i32 @csec_find_decl_body_end(ptr, i32)\n");
    val appendHeader32: Int = csec_string_builder_append(builder, "declare i32 @csec_function_param_end(ptr, i32)\n");
    val appendHeader33: Int = csec_string_builder_append(builder, "declare ptr @csec_function_llvm_param_list(ptr, i32)\n");
    val appendHeader34: Int = csec_string_builder_append(builder, "declare ptr @csec_function_llvm_param_allocas(ptr, i32)\n");
    val appendHeader35: Int = csec_string_builder_append(builder, "declare ptr @csec_llvm_name_with_number(ptr, i32)\n");
    val appendHeader35a: Int = csec_string_builder_append(builder, "declare ptr @csec_llvm_string_literal_bytes(ptr)\n");
    val appendHeader36: Int = csec_string_builder_append(builder, "declare ptr @csec_function_return_type_at(ptr, i32)\n");
    val appendHeader37: Int = csec_string_builder_append(builder, "declare i32 @csec_enclosing_function_decl_start(ptr, i32)\n");
    val appendHeader38: Int = csec_string_builder_append(builder, "declare i32 @csec_enclosing_function_body_start(ptr, i32)\n");
    val appendHeader39: Int = csec_string_builder_append(builder, "declare i32 @csec_enclosing_function_body_end(ptr, i32)\n");
    val appendHeader40: Int = csec_string_builder_append(builder, "declare ptr @csec_lookup_function_return_type(ptr, ptr)\n");
    val appendHeader41: Int = csec_string_builder_append(builder, "declare ptr @csec_expand_imports(ptr)\n\n");
    val appendHeader42: Int = csec_string_builder_append(builder, generateLLVMStringLiteralGlobals(tokens));
    var emitted: Boolean = false;
    var hasMain: Boolean = false;
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def") and
            !(cursor > 0 and tokenIs(tokens, cursor - 1, kindKeyword(), "external"))) {
            if (strEq(topLevelDeclName(tokens, cursor), "main")) {
                hasMain = true;
                val appendMainWrapper: Int = csec_string_builder_append(builder,
                    "define i32 @main(i32 %argc, ptr %argv) {\n" +
                    "entry:\n" +
                    "  call void @csec_set_command_line_args(i32 %argc, ptr %argv)\n" +
                    "  %ret = call i32 @csec_user_main()\n" +
                    "  ret i32 %ret\n" +
                    "}\n");
            }
            val definition: String = generateLLVMFunctionDefinition(tokens, cursor);
            if (definition.length > 0) {
                val appendDefinition: Int = csec_string_builder_append(builder, definition);
                emitted = true;
            }
        }
        val next: Int = advanceTopLevelDecl(tokens, cursor);
        if (next <= cursor) {
            cursor = cursor + 1;
        }
        else {
            cursor = skipTrivia(tokens, next);
        }
    }
    if (!emitted) {
        val fallbackMain: String =
            "define i32 @main() {\n" +
            generateLLVMMainBody(tokens) +
            "}\n";
        val appendFallbackMain: Int = csec_string_builder_append(builder, fallbackMain);
    }
    return 0;
}

def generateLLVMModule(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "";
    }
    var output: String = "; ModuleID = 'csec.selfhost'\n" +
        "source_filename = \"csec.selfhost\"\n\n" +
        "declare i64 @csec_string_length(ptr)\n" +
        "declare i8 @csec_string_char_at(ptr, i32)\n\n" +
        "declare i32 @csec_lex_quoted(ptr, i32)\n" +
        "declare i32 @csec_lex_number(ptr, i32)\n" +
        "declare i32 @csec_lex_identifier(ptr, i32)\n" +
        "declare i32 @csec_lex_line_comment(ptr, i32)\n" +
        "declare i32 @csec_lex_block_comment(ptr, i32)\n" +
        "declare i32 @csec_digit_value(i8)\n" +
        "declare i32 @csec_to_int(ptr)\n" +
        "declare i32 @csec_line_start(ptr, i32)\n" +
        "declare i32 @csec_line_end(ptr, i32)\n" +
        "declare i32 @csec_validate_balanced(ptr)\n" +
        "declare i32 @csec_find_token_text_in_range(ptr, i32, i32, ptr)\n" +
        "declare i32 @csec_find_closing_token(ptr, i32, i32, ptr, ptr)\n" +
        "declare i32 @csec_find_statement_paren_start(ptr, i32, i32)\n" +
        "declare i32 @csec_find_statement_paren_end(ptr, i32, i32)\n" +
        "declare i32 @csec_find_statement_block_start(ptr, i32, i32)\n" +
        "declare i32 @csec_find_statement_block_end(ptr, i32, i32)\n" +
        "declare ptr @csec_llvm_lexer_helper_definition(ptr)\n" +
        "declare i64 @csec_string_builder_new()\n" +
        "declare i64 @csec_string_builder_new_file(ptr)\n" +
        "declare i32 @csec_string_builder_append(i64, ptr)\n" +
        "declare ptr @csec_string_builder_finish(i64)\n" +
        "declare i32 @csec_string_builder_write_to_file(i64, ptr)\n" +
        "declare void @csec_set_command_line_args(i32, ptr)\n" +
        "declare i32 @csec_command_line_arg_count()\n" +
        "declare ptr @csec_command_line_arg(i32)\n" +
        "declare ptr @csec_file_read_all_text(ptr)\n" +
        "declare i32 @csec_file_write_all_text(ptr, ptr)\n" +
        "declare void @csec_print_string(ptr)\n" +
        "declare void @csec_print_newline()\n" +
        "declare ptr @csec_string_concat(ptr, ptr)\n" +
        "declare i32 @csec_string_starts_with(ptr, ptr)\n" +
        "declare ptr @csec_string_substring(ptr, i32, i32)\n" +
        "declare ptr @csec_to_string_i64(i64)\n" +
        "declare ptr @csec_to_string_char(i8)\n" +
        "declare ptr @csec_token_append_owned(ptr, i8, ptr)\n" +
        "declare i64 @csec_token_builder_new()\n" +
        "declare i32 @csec_token_builder_append(i64, i8, ptr)\n" +
        "declare ptr @csec_token_builder_finish(i64)\n" +
        "declare ptr @csec_tokenize_source(ptr)\n" +
        "declare i8 @csec_token_kind_at(ptr, i32)\n" +
        "declare ptr @csec_token_text_at(ptr, i32)\n" +
        "declare i32 @csec_token_is(ptr, i32, i8, ptr)\n" +
        "declare i32 @csec_advance_statement(ptr, i32, i32)\n" +
        "declare i32 @csec_advance_top_level_decl(ptr, i32)\n" +
        "declare i32 @csec_find_decl_body_start(ptr, i32)\n" +
        "declare i32 @csec_find_decl_body_end(ptr, i32)\n" +
        "declare i32 @csec_function_param_end(ptr, i32)\n" +
        "declare ptr @csec_function_llvm_param_list(ptr, i32)\n" +
        "declare ptr @csec_function_llvm_param_allocas(ptr, i32)\n" +
        "declare ptr @csec_llvm_name_with_number(ptr, i32)\n" +
        "declare ptr @csec_llvm_string_literal_bytes(ptr)\n" +
        "declare ptr @csec_function_return_type_at(ptr, i32)\n" +
        "declare i32 @csec_enclosing_function_decl_start(ptr, i32)\n" +
        "declare i32 @csec_enclosing_function_body_start(ptr, i32)\n" +
        "declare i32 @csec_enclosing_function_body_end(ptr, i32)\n" +
        "declare ptr @csec_lookup_function_return_type(ptr, ptr)\n" +
        "declare ptr @csec_expand_imports(ptr)\n\n" +
        generateLLVMStringLiteralGlobals(tokens);
    var emitted: Boolean = false;
    var hasMain: Boolean = false;
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def")) {
            if (strEq(topLevelDeclName(tokens, cursor), "main")) {
                hasMain = true;
            }
            val definition: String = generateLLVMFunctionDefinition(tokens, cursor);
            if (definition.length > 0) {
                output = output + definition;
                emitted = true;
            }
        }
        val next: Int = advanceTopLevelDecl(tokens, cursor);
        if (next <= cursor) {
            cursor = cursor + 1;
        }
        else {
            cursor = skipTrivia(tokens, next);
        }
    }
    if (emitted) {
        if (hasMain) {
            return output +
                "define i32 @main(i32 %argc, ptr %argv) {\n" +
                "entry:\n" +
                "  call void @csec_set_command_line_args(i32 %argc, ptr %argv)\n" +
                "  %ret = call i32 @csec_user_main()\n" +
                "  ret i32 %ret\n" +
                "}\n";
        }
        return output;
    }
    return output +
        "define i32 @main() {\n" +
        generateLLVMMainBody(tokens) +
        "}\n";
}

def generateExecutionC(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "";
    }
    return generateMainExecutionC(tokens);
}
