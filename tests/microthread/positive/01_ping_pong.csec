import std.microthread
// Two processes bounce a counter back and forth; the parent collects the final value.
def main(): Int {
    val parent = self();
    val ponger = spawn([=]() -> {
        var running: Boolean = true;
        while (running) {
            val n = receive();
            if (n >= 10) {
                send(parent, n);
                running = false;
            } else {
                send(parent, n + 1);
            }
        }
        return 0;
    });
    send(ponger, 0);
    var last: Int = 0;
    var done: Boolean = false;
    while (!done) {
        val n = receive();
        if (n >= 10) {
            last = n;
            done = true;
        } else {
            send(ponger, n + 1);
        }
    }
    if (last != 10) { return 1; }
    return 0;
}
