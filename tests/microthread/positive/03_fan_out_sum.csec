import std.microthread
// Spawn 1000 workers; each squares its captured input and reports back. The parent sums replies.
def main(): Int {
    val parent = self();
    val workers = 1000;
    var i: Int = 1;
    while (i <= workers) {
        val k = i;
        spawn([=]() -> {
            send(parent, k * k % 1000);
            return 0;
        });
        i = i + 1;
    }
    var total: Int = 0;
    var got: Int = 0;
    while (got < workers) {
        total = total + receive();
        got = got + 1;
    }
    var expected: Int = 0;
    var j: Int = 1;
    while (j <= workers) {
        expected = expected + j * j % 1000;
        j = j + 1;
    }
    if (total != expected) { return 1; }
    return 0;
}
