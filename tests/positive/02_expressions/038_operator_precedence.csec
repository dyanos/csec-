def main(): Int {
    /* mul before add */
    var a: Int = 2 + 3 * 4;

    /* shift before comparison */
    var b: Int = 1 << 3;

    /* comparison before equality */
    val c = 1 < 2 == true;

    /* equality before bitwise AND */
    var d: Int = 1 & 2;

    /* bitwise before logical */
    val e = 1 == 1 and 2 == 2;

    /* parentheses override */
    var f: Int = (2 + 3) * 4;
    var g: Int = 2 * (3 + 4);

    /* left associativity */
    var h: Int = 10 - 3 - 2;
    var i: Int = 100 / 10 / 2;

    return a;
}
