// Nat = Gaussian integer  re + im*i  (built-in value type). Construction, field access, + - *.
def natNorm(z: Nat): BigInt = z.re * z.re + z.im * z.im
def main(): Int {
    val a: Nat = new Nat(3, 2);
    val b: Nat = new Nat(1, 4);
    val sum: Nat = a + b;       // 4 + 6i
    val diff: Nat = a - b;      // 2 - 2i
    val prod: Nat = a * b;      // (3+2i)(1+4i) = -5 + 14i

    // Unbounded scale: 2^100 is exact (a signed 64-bit int overflows far below it). Comparing a BigInt
    // to a decimal string checks its exact value.
    val two: Nat = new Nat(2, 0);
    var p2: Nat = new Nat(1, 0);
    var k: Int = 0;
    while (k < 100) {
        p2 = p2 * two;
        k = k + 1;
    }

    // norm is multiplicative: N(a*b) = N(a) * N(b)
    if (sum.re == 4 and sum.im == 6 and
        diff.re == 2 and diff.im == (0 - 2) and
        prod.re == (0 - 5) and prod.im == 14 and
        natNorm(a) == 13 and
        natNorm(prod) == natNorm(a) * natNorm(b) and
        p2.re == "1267650600228229401496703205376") {
        return 0;
    }
    return 1;
}
