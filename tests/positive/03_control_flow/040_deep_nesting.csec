def main(): Int {
    var total: Int = 0;

    for (i <- 0 to 3) {
        for (j <- 0 to 3) {
            if (i == j) {
                total = total + 1;
            }
            else {
                if (i < j) {
                    total = total + 2;
                }
                else {
                    var k: Int = 0;
                    while (k < 2) {
                        total = total + 1;
                        k = k + 1;
                    }
                }
            }
        }
    }

    return total;
}
