def main(): Int {
    val xs = [10, 20, 30, 40, 50];
    val ys = [1, 2, 3];

    /* map then use */
    map (x <- xs) {
        x * 2;
    }

    /* filter then use */
    filter (x <- xs) {
        x > 20;
    }

    /* reduce to value */
    reduce (x <- ys, 0) {
        x + 1;
    }

    return 0;
}
