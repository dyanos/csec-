def main(): Int {
    val xs = [1, 2, 3, 4];
    val offset = 10;
    val cpu = pmap(cpu, x <- xs) {
        x + offset;
    };
    val simd = pmap(simd, x <- xs) {
        x * 2;
    };
    val gpu = pmap(gpu, x <- xs) {
        x - 1;
    };
    val implicitCpu = pmap (x <- xs) {
        x + 1;
    };
    return 0;
}
