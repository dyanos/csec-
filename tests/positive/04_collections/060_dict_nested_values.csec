// Dictionary values may be lists, nested dictionaries, and class instances:
// {key1: value, key2: [v1, v2, ...]}.
class Pet(name: String) {
    def label(): String = name
}

def main(): Int {
    val scores = {"math": [90, 85, 77], "art": [60, 70]};   // Dict<String, Vector[Int]>
    val math = scores["math"];
    if (math[0] + math[2] != 167) { return 1; }
    if (scores["art"][1] != 70) { return 2; }
    if (scores.toString() != "{'math': [90, 85, 77], 'art': [60, 70]}") { return 3; }

    val points = {"p": {"x": 1.5, "y": 2.0}, "q": {"x": 3.0}};   // Dict<String, Dict<String, Float>>
    if (points["p"]["y"] != 2.0) { return 4; }

    val config: Dict<String, Dict<String, Long>> = {"limits": {"max": 10}};
    config["limits"]["min"] = 1;
    if (config["limits"].size() != 2) { return 5; }
    val pets = {"rex": new Pet("dog"), "tom": new Pet("cat")};   // Dict<String, Pet>
    if (pets["tom"].label() != "cat") { return 6; }
    println(scores);
    println(points);
    return 0;
}
