object StringUtils {
    def length(s: String): Int = 0
    def isEmpty(s: String): Boolean = false
    def concat(a: String, b: String): String = a
}

object MathUtils {
    def max(a: Int, b: Int): Int {
        if (a > b) {
            return a;
        }
        else {
            return b;
        }
    }

    def min(a: Int, b: Int): Int {
        if (a < b) {
            return a;
        }
        else {
            return b;
        }
    }

    def abs(x: Int): Int {
        if (x < 0) {
            return 0 - x;
        }
        return x;
    }

    def clamp(x: Int, lo: Int, hi: Int): Int {
        if (x < lo) {
            return lo;
        }
        if (x > hi) {
            return hi;
        }
        return x;
    }
}

def main(): Int {
    val a = MathUtils.max(10, 20);
    val b = MathUtils.min(10, 20);
    val c = MathUtils.abs(0 - 5);
    val d = MathUtils.clamp(50, 0, 100);
    return a + b + c + d;
}
