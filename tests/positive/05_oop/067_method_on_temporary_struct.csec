// A method call on a temporary struct (the result of a struct-returning call) must read the
// temporary's real fields, not garbage.
struct Vec3(x: Double, y: Double, z: Double) {
    def norm(): Double = sqrt(x * x + y * y + z * z)
}
def diff(a: Vec3, b: Vec3): Vec3 = new Vec3(a.x - b.x, a.y - b.y, a.z - b.z)
def main(): Int {
    val p: Vec3 = new Vec3(0.0, 4.0, 0.0);
    val q: Vec3 = new Vec3(0.0 - 3.0, 0.0, 0.0);
    val d: Double = diff(p, q).norm();   // sqrt(3^2 + 4^2) = 5
    if (d > 4.999 and d < 5.001) {
        return 0;
    }
    return 1;
}
