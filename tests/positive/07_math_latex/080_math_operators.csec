def main(): Int {
    /* basic arithmetic in math mode */
    val a = $x + y$;
    val b = $x - y$;
    val c = $x * y$;
    val d = $x / y$;

    /* latex operators */
    val e = $x \times y$;
    val f = $x \div y$;
    val g = $x \cdot y$;
    val h = $x \pm y$;

    /* power */
    val i = $x^{2}$;
    val j = $x^{n}$;

    return 0;
}
