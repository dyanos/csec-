// LaTeX `^` evaluates as exponentiation and `\cdot` / `\times` as multiplication.
def main(): Int {
    val r: Double = 3.0;
    val a: Double = 6.0;
    val b: Double = 2.0;
    val cube: Double = $r^3$;              // 27
    val prod: Double = $a \cdot b$;        // 12
    val prod2: Double = $a \times b$;      // 12
    val mixed: Double = $\frac{a \cdot b}{r^2}$;   // 12 / 9
    if (cube > 26.99 and cube < 27.01 and
        prod > 11.99 and prod < 12.01 and
        prod2 > 11.99 and prod2 < 12.01 and
        mixed > 1.33 and mixed < 1.34) {
        return 0;
    }
    return 1;
}
