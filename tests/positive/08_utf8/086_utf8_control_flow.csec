def 피보나치(번째: Int): Int {
    if (번째 <= 1) {
        return 번째;
    }
    else {
        return 피보나치(번째 - 1) + 피보나치(번째 - 2);
    }
}

def main(): Int {
    var 합: Int = 0;

    for (숫자 <- 1 to 10) {
        합 = 합 + 숫자;
    }

    var 카운터: Int = 0;
    while (카운터 < 5) {
        카운터 = 카운터 + 1;
    }

    val 피보값 = 피보나치(10);
    return 합 + 카운터 + 피보값;
}
