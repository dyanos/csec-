/* Comprehensive program using many language features */

import std.math

constexpr val MAX: Int = 100;

external def puts(s: String): Void;

[@entry]
def main(): Int {
    /* variables of different types */
    val name: String = "test";
    val pi: Float = 3.14;
    var counter: Int = 0;
    val flag: Boolean = true;

    /* arithmetic */
    var total: Int = (10 + 20) * 3;
    total = total - 5;
    total = total % 7;

    /* for loop with range */
    for (i <- 0 to 10) {
        counter = counter + i;
    }

    /* while loop */
    while (counter > 50) {
        counter = counter - 1;
    }

    /* conditional */
    if (flag) {
        counter = counter + 1;
    }
    else {
        counter = counter - 1;
    }

    /* match expression */
    val grade = counter match {
        case 0 => 100
        case 1 => 90
        case _ => 50
    };

    /* array */
    val data = [1, 2, 3, 4, 5];

    /* map */
    map (x <- data) {
        x * 2;
    }

    /* filter */
    filter (x <- data) {
        x > 2;
    }

    /* reduce */
    reduce (x <- data, 0) {
        x + 1;
    }

    /* lambda */
    val transform = [=](x) -> {
        return x + 1;
    };

    return counter + grade;
}
