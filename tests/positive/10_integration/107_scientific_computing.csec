/* Scientific computing with LaTeX math */

def main(): Int {
    /* Euler's identity components */
    val euler = $\e^{\i * \pi} + 1$;

    /* Quadratic formula */
    val discriminant = $$b^{2} - 4 * a * c$$;

    /* Pythagorean theorem */
    val hypotenuse = $\sqrt{a^{2} + b^{2}}$;

    /* Sum of series */
    val series = $$\sum_{n=1}^{100} \frac{1}{n}$$;

    /* Product */
    val factorialExpr = $$\prod_{k=1}^{n} k$$;

    /* Matrix multiplication result */
    val mat = $$\begin{bmatrix} 1 & 0 \\ 0 & 1 \end{bmatrix}$$;

    /* Trigonometric identity */
    val trig = $\sin(x)^{2} + \cos(x)^{2}$;

    /* Natural log */
    val logExpr = $\ln(\e^{x})$;

    return 0;
}
