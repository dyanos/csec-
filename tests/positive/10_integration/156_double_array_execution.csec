def sum(values: &Vector[Double]): Double {
    return values[0] + values[1] + values[2];
}

def main(): Int {
    val values = new Double[3];
    values[0] = 1.25;
    values[1] = 2.5;
    values[2] = 3.75;
    if (sum(&values) == 7.5 and values[0] + values[1] == 3.75) {
        return 0;
    }
    return 1;
}
