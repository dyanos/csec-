def build(size: Int): Vector[Int] {
    val values = new Int[size];
    values[0] = 42;
    values[1] = 7;
    return values;
}

def firstOf(xs: Array[Int]): Int {
    return xs[0];
}

def main(): Int {
    val made: Vector[Int] = build(2);
    if (firstOf(<- made) == 42) {
        return 0;
    }
    return 1;
}
