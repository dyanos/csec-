def isEven(n: Int): Boolean {
    if (n == 0) {
        return true;
    }
    return isOdd(n - 1);
}

def isOdd(n: Int): Boolean {
    if (n == 0) {
        return false;
    }
    return isEven(n - 1);
}

def main(): Int {
    if (isEven(10) and isOdd(7) and isEven(0) and isOdd(1)) {
        return 0;
    }
    return 1;
}
