template<typename T, Int N>
class Holder(value: T) {
    def get(): T { return value; }
    def capacity(): Int { return N; }
}

def split(value: Int): (Int, Int) {
    return value / 2, value % 2;
}

def classify(value: Int): Int {
    return value match {
        case 0 => 10;
        case 1 => 20;
        case _ => 30;
    };
}

def main(): Int {
    val holder = new Holder<Int, 8>(41);
    half, remainder = split(holder.get() + 1);
    var checksum: Int = 0;
    for (i <- 0 until 3) {
        checksum = checksum + (i << 1);
    }
    if (half == 21 and remainder == 0 and holder.capacity() == 8 and
        classify(checksum) == 30) {
        return 0;
    }
    return 1;
}
