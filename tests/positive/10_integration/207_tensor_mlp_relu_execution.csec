// A two-layer tensor MLP: matmul (@), bias add, and an element-wise ReLU loop, checked numerically.
// Self-checking: returns 0 on success.
def relu4(z: Tensor<Double, 1, 4>): Tensor<Double, 1, 4> {
    val out: Tensor<Double, 1, 4> = new Tensor<Double, 1, 4>(0.0);
    var j: Int = 0;
    while (j < 4) {
        val v: Double = z[0, j];
        if (v > 0.0) { out[0, j] = v; } else { out[0, j] = 0.0; }
        j = j + 1;
    }
    return out;
}
def main(): Int {
    val x: Tensor<Double, 1, 3> = new Tensor<Double, 1, 3>(0.0);
    x[0, 0] = 1.0; x[0, 1] = 0.5; x[0, 2] = -1.0;
    val w1: Tensor<Double, 3, 4> = new Tensor<Double, 3, 4>(0.5);
    val b1: Tensor<Double, 1, 4> = new Tensor<Double, 1, 4>(0.0);
    b1[0, 0] = -2.0;
    val w2: Tensor<Double, 4, 2> = new Tensor<Double, 4, 2>(0.5);
    val b2: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(0.5);   // exact
    val z1: Tensor<Double, 1, 4> = (x @ w1) + b1;
    val h:  Tensor<Double, 1, 4> = relu4(z1);   // [0, 0.25, 0.25, 0.25]
    val y:  Tensor<Double, 1, 2> = (h @ w2) + b2;   // 0.375 + 0.5 = 0.875 (exact)
    if (h[0, 0] == 0.0 and h[0, 1] == 0.25 and y[0, 0] == 0.875 and y[0, 1] == 0.875) {
        return 0;
    }
    return 1;
}
