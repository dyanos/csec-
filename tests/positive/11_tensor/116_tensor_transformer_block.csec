def linear(
    x: Tensor<Double, 2, 4>,
    weight: Tensor<Double, 4, 4>,
    bias: Tensor<Double, 2, 4>
): Tensor<Double, 2, 4> {
    return (x @ weight) + bias;
}

def feedForward(
    x: Tensor<Double, 2, 4>,
    w1: Tensor<Double, 4, 8>,
    b1: Tensor<Double, 2, 8>,
    w2: Tensor<Double, 8, 4>,
    b2: Tensor<Double, 2, 4>
): Tensor<Double, 2, 4> {
    val hidden: Tensor<Double, 2, 8> = (x @ w1) + b1;
    return (hidden @ w2) + b2;
}

def scaledDotProductAttention(
    query: Tensor<Double, 2, 4>,
    key: Tensor<Double, 2, 4>,
    value: Tensor<Double, 2, 4>
): Tensor<Double, 2, 4> {
    val scale = 0.5;
    val scores: Tensor<Double, 2, 2> = (query @ transpose(key)) * scale;
    val probabilities: Tensor<Double, 2, 2> = scores;
    return probabilities @ value;
}

def residualAdd(
    input: Tensor<Double, 2, 4>,
    update: Tensor<Double, 2, 4>
): Tensor<Double, 2, 4> {
    return input + update;
}

def randomInit(seed: Double): Double {
    return sin(seed * 12.9898) * 0.02;
}

def transformerBlock(
    tokens: Tensor<Double, 2, 4>,
    wq: Tensor<Double, 4, 4>,
    wk: Tensor<Double, 4, 4>,
    wv: Tensor<Double, 4, 4>,
    wo: Tensor<Double, 4, 4>,
    attentionBias: Tensor<Double, 2, 4>,
    ffnW1: Tensor<Double, 4, 8>,
    ffnB1: Tensor<Double, 2, 8>,
    ffnW2: Tensor<Double, 8, 4>,
    ffnB2: Tensor<Double, 2, 4>
): Tensor<Double, 2, 4> {
    val query = tokens @ wq;
    val key = tokens @ wk;
    val value = tokens @ wv;
    val context = scaledDotProductAttention(query, key, value);
    val projected = linear(context, wo, attentionBias);
    val attentionResidual = residualAdd(tokens, projected);
    val ffnUpdate = feedForward(attentionResidual, ffnW1, ffnB1, ffnW2, ffnB2);
    return residualAdd(attentionResidual, ffnUpdate);
}

def transformerEncoder2Layer(
    tokens: Tensor<Double, 2, 4>,
    layer1Wq: Tensor<Double, 4, 4>,
    layer1Wk: Tensor<Double, 4, 4>,
    layer1Wv: Tensor<Double, 4, 4>,
    layer1Wo: Tensor<Double, 4, 4>,
    layer1AttentionBias: Tensor<Double, 2, 4>,
    layer1FfnW1: Tensor<Double, 4, 8>,
    layer1FfnB1: Tensor<Double, 2, 8>,
    layer1FfnW2: Tensor<Double, 8, 4>,
    layer1FfnB2: Tensor<Double, 2, 4>,
    layer2Wq: Tensor<Double, 4, 4>,
    layer2Wk: Tensor<Double, 4, 4>,
    layer2Wv: Tensor<Double, 4, 4>,
    layer2Wo: Tensor<Double, 4, 4>,
    layer2AttentionBias: Tensor<Double, 2, 4>,
    layer2FfnW1: Tensor<Double, 4, 8>,
    layer2FfnB1: Tensor<Double, 2, 8>,
    layer2FfnW2: Tensor<Double, 8, 4>,
    layer2FfnB2: Tensor<Double, 2, 4>
): Tensor<Double, 2, 4> {
    val hidden1 = transformerBlock(
        tokens,
        layer1Wq,
        layer1Wk,
        layer1Wv,
        layer1Wo,
        layer1AttentionBias,
        layer1FfnW1,
        layer1FfnB1,
        layer1FfnW2,
        layer1FfnB2
    );
    return transformerBlock(
        hidden1,
        layer2Wq,
        layer2Wk,
        layer2Wv,
        layer2Wo,
        layer2AttentionBias,
        layer2FfnW1,
        layer2FfnB1,
        layer2FfnW2,
        layer2FfnB2
    );
}

def mseLoss(
    prediction: Tensor<Double, 2, 4>,
    target: Tensor<Double, 2, 4>
): Double {
    val d00 = prediction[0, 0] - target[0, 0];
    val d01 = prediction[0, 1] - target[0, 1];
    val d02 = prediction[0, 2] - target[0, 2];
    val d03 = prediction[0, 3] - target[0, 3];
    val d10 = prediction[1, 0] - target[1, 0];
    val d11 = prediction[1, 1] - target[1, 1];
    val d12 = prediction[1, 2] - target[1, 2];
    val d13 = prediction[1, 3] - target[1, 3];
    return (
        d00 * d00 +
        d01 * d01 +
        d02 * d02 +
        d03 * d03 +
        d10 * d10 +
        d11 * d11 +
        d12 * d12 +
        d13 * d13
    ) / 8.0;
}

def sgd4x4(
    weight: Tensor<Double, 4, 4>,
    learningRate: Double,
    loss: Double
): Tensor<Double, 4, 4> {
    val gradient = new Tensor<Double, 4, 4>(learningRate * loss);
    return weight - gradient;
}

def sgd4x8(
    weight: Tensor<Double, 4, 8>,
    learningRate: Double,
    loss: Double
): Tensor<Double, 4, 8> {
    val gradient = new Tensor<Double, 4, 8>(learningRate * loss);
    return weight - gradient;
}

def sgd8x4(
    weight: Tensor<Double, 8, 4>,
    learningRate: Double,
    loss: Double
): Tensor<Double, 8, 4> {
    val gradient = new Tensor<Double, 8, 4>(learningRate * loss);
    return weight - gradient;
}

def main(): Int {
    val tokens: Tensor<Double, 2, 4> = new Tensor<Double, 2, 4>(randomInit(1.0));
    val target: Tensor<Double, 2, 4> = new Tensor<Double, 2, 4>(0.25);
    val learningRate = 0.001;
    var epoch: Int = 0;
    var loss: Double = 0.0;

    var layer1Wq: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(2.0));
    var layer1Wk: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(3.0));
    var layer1Wv: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(4.0));
    var layer1Wo: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(5.0));
    val layer1AttentionBias: Tensor<Double, 2, 4> = new Tensor<Double, 2, 4>(0.0);
    var layer1FfnW1: Tensor<Double, 4, 8> = new Tensor<Double, 4, 8>(randomInit(6.0));
    val layer1FfnB1: Tensor<Double, 2, 8> = new Tensor<Double, 2, 8>(0.0);
    var layer1FfnW2: Tensor<Double, 8, 4> = new Tensor<Double, 8, 4>(randomInit(7.0));
    val layer1FfnB2: Tensor<Double, 2, 4> = new Tensor<Double, 2, 4>(0.0);

    var layer2Wq: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(8.0));
    var layer2Wk: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(9.0));
    var layer2Wv: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(10.0));
    var layer2Wo: Tensor<Double, 4, 4> = new Tensor<Double, 4, 4>(randomInit(11.0));
    val layer2AttentionBias: Tensor<Double, 2, 4> = new Tensor<Double, 2, 4>(0.0);
    var layer2FfnW1: Tensor<Double, 4, 8> = new Tensor<Double, 4, 8>(randomInit(12.0));
    val layer2FfnB1: Tensor<Double, 2, 8> = new Tensor<Double, 2, 8>(0.0);
    var layer2FfnW2: Tensor<Double, 8, 4> = new Tensor<Double, 8, 4>(randomInit(13.0));
    val layer2FfnB2: Tensor<Double, 2, 4> = new Tensor<Double, 2, 4>(0.0);

    var encoded: Tensor<Double, 2, 4> = transformerEncoder2Layer(
        tokens,
        layer1Wq,
        layer1Wk,
        layer1Wv,
        layer1Wo,
        layer1AttentionBias,
        layer1FfnW1,
        layer1FfnB1,
        layer1FfnW2,
        layer1FfnB2,
        layer2Wq,
        layer2Wk,
        layer2Wv,
        layer2Wo,
        layer2AttentionBias,
        layer2FfnW1,
        layer2FfnB1,
        layer2FfnW2,
        layer2FfnB2
    );

    while (epoch < 3) {
        encoded = transformerEncoder2Layer(
            tokens,
            layer1Wq,
            layer1Wk,
            layer1Wv,
            layer1Wo,
            layer1AttentionBias,
            layer1FfnW1,
            layer1FfnB1,
            layer1FfnW2,
            layer1FfnB2,
            layer2Wq,
            layer2Wk,
            layer2Wv,
            layer2Wo,
            layer2AttentionBias,
            layer2FfnW1,
            layer2FfnB1,
            layer2FfnW2,
            layer2FfnB2
        );
        loss = mseLoss(encoded, target);

        layer1Wq = sgd4x4(layer1Wq, learningRate, loss);
        layer1Wk = sgd4x4(layer1Wk, learningRate, loss);
        layer1Wv = sgd4x4(layer1Wv, learningRate, loss);
        layer1Wo = sgd4x4(layer1Wo, learningRate, loss);
        layer1FfnW1 = sgd4x8(layer1FfnW1, learningRate, loss);
        layer1FfnW2 = sgd8x4(layer1FfnW2, learningRate, loss);

        layer2Wq = sgd4x4(layer2Wq, learningRate, loss);
        layer2Wk = sgd4x4(layer2Wk, learningRate, loss);
        layer2Wv = sgd4x4(layer2Wv, learningRate, loss);
        layer2Wo = sgd4x4(layer2Wo, learningRate, loss);
        layer2FfnW1 = sgd4x8(layer2FfnW1, learningRate, loss);
        layer2FfnW2 = sgd8x4(layer2FfnW2, learningRate, loss);

        epoch = epoch + 1;
    }

    val firstTokenFirstChannel = encoded[0, 0];
    return 0;
}
