def main(): Int {
    val mdEnergy = molecule water {
        atom O at (0.0, 0.0, 0.0);
        atom H at (0.96, 0.0, 0.0);
        atom H at (-0.24, 0.93, 0.0);
        bond 0, 1;
        bond 0, 2;
        steps 25;
        dt 0.001;
        temperature 300.0;
    };

    val residual = cfd cavity {
        grid 16 x 16;
        steps 20;
        dt 0.01;
        viscosity 0.001;
        velocity 1.0;
    };

    return 0;
}

