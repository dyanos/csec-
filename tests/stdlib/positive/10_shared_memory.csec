import std.shared
import std.thread
import std.microthread
// Shared memory: atomic counters from OS threads, a lock-protected update from microthreads, and two
// handles to the same named region seeing each other's writes.
def main(): Int {
    val mem = sharedNew(1024);
    if (sharedSize(mem) != 1024) { return 1; }
    val t1 = threadStart([=]() -> {
        var i: Int = 0;
        while (i < 1000) { sharedAddLong(mem, 0, 1); i = i + 1; }
        return 0;
    });
    val t2 = threadStart([=]() -> {
        var i: Int = 0;
        while (i < 1000) { sharedAddLong(mem, 0, 2); i = i + 1; }
        return 0;
    });
    threadJoin(t1);
    threadJoin(t2);
    if (sharedGetLong(mem, 0) != 3000) { return 2; }

    // Microthreads update slot 1 under the region lock, yielding while holding it.
    var k: Int = 0;
    while (k < 4) {
        spawn([=]() -> {
            sharedLock(mem);
            val before = sharedGetLong(mem, 1);
            yield();
            sharedSetLong(mem, 1, before + 10);
            sharedUnlock(mem);
            return 0;
        });
        k = k + 1;
    }
    joinProcesses();
    if (sharedGetLong(mem, 1) != 40) { return 3; }

    sharedSetDouble(mem, 2, 2.5);
    if (sharedGetDouble(mem, 2) != 2.5) { return 4; }
    if (sharedWriteString(mem, 100, "hello shared") != 12) { return 5; }
    if (sharedReadString(mem, 100) != "hello shared") { return 6; }
    if (sharedGetByte(mem, 100) != 104) { return 7; }
    if (!sharedCompareExchange(mem, 0, 3000, 7)) { return 8; }
    if (sharedGetLong(mem, 5000) != 0) { return 9; }

    // Named regions: a second open of the same name is the same memory.
    val a = sharedOpen("csec_test_region", 256);
    val b = sharedOpen("csec_test_region", 256);
    sharedSetLong(a, 3, 99);
    if (sharedGetLong(b, 3) != 99) { return 10; }
    sharedClose(a);
    sharedClose(b);
    sharedRemove("csec_test_region");
    return 0;
}
