import std.dataframe
// Parquet logical types map to long / double / string, and nested columns are reported unless the
// flat columns are selected explicitly.

def main(): Int {
    val t = dfReadParquet("tests/stdlib/data/types.parquet");
    if (t == 0) {
        println(dfLastError());
        return 1;
    }
    // DATE: days since 1970-01-01.
    if (dfColumnType(t, "day") != "long") { return 2; }
    if (dfGetLong(t, "day", 0) != 1 or dfGetLong(t, "day", 1) != 19782) { return 3; }
    if (!dfIsNull(t, "day", 2)) { return 4; }
    // TIMESTAMP(MILLIS): milliseconds since the epoch.
    if (dfGetLong(t, "at_ms", 0) != 1000 or dfGetLong(t, "at_ms", 1) != 946684800000) { return 5; }
    // DECIMAL in FIXED_LEN_BYTE_ARRAY: scaled to a double.
    if (dfColumnType(t, "price") != "double") { return 6; }
    if (dfGetDouble(t, "price", 0) != 12.34e0 or dfGetDouble(t, "price", 1) != -0.05e0) { return 7; }
    if (dfGetDouble(t, "big_price", 0) != 123456789012.345e0 or dfGetDouble(t, "big_price", 2) != -1.0e0) { return 8; }
    if (!dfIsNull(t, "big_price", 1)) { return 9; }
    // FLOAT widens to double.
    if (dfGetDouble(t, "ratio", 1) != -2.25e0) { return 10; }
    // FIXED_LEN_BYTE_ARRAY without a logical type stays bytes (a string).
    if (dfGetString(t, "code", 1) != "xyz") { return 11; }
    dfFree(t);

    // INT96 timestamps: nanoseconds since the epoch.
    val ns = dfReadParquet("tests/stdlib/data/types_int96.parquet");
    if (ns == 0) { return 12; }
    if (dfGetLong(ns, "at_ns", 0) != 2000000000) { return 13; }
    if (dfGetLong(ns, "at_ns", 1) != 1000000000000000000) { return 14; }
    dfFree(ns);

    // Nested columns: the whole file is refused, the flat columns can be read.
    if (dfReadParquet("tests/stdlib/data/nested.parquet") != 0) { return 15; }
    val flat = dfReadParquetColumns("tests/stdlib/data/nested.parquet", "id,label");
    if (flat == 0) {
        println(dfLastError());
        return 16;
    }
    if (dfRows(flat) != 3 or dfGetString(flat, "label", 2) != "three") { return 17; }
    if (dfReadParquetColumns("tests/stdlib/data/nested.parquet", "tags") != 0) { return 18; }
    return 0;
}
