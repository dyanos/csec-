import std.dataframe
// Frame operations on the people fixture: filter, sort, group-by, join, computed columns, concat,
// value counts, null handling, building frames, and CSV.

def main(): Int {
    val df = readParquet("tests/stdlib/data/people_snappy_dict.parquet");
    if (df == 0) {
        println(dfLastError());
        return 1;
    }

    // ---- filter ----
    val high = dfFilter(df, "score", ">=", 5.0e0);
    if (dfRows(high) != 5 or dfGetLong(high, "id", 0) != 6) { return 2; }
    val east = dfFilterString(df, "region", "==", "east");
    if (dfRows(east) != 4 or dfSum(east, "id") != 19.0e0) { return 3; }
    val withA = dfFilterString(df, "name", "contains", "a");
    // alice, carol, dave, frank, grace (nulls never match)
    if (dfRows(withA) != 5) { return 4; }
    if (dfFilter(df, "name", ">", 1.0e0) != 0) { return 5; }  // string column: use dfFilterString
    if (dfFilter(df, "nope", ">", 1.0e0) != 0) { return 6; }

    // ---- sort ----
    val byScore = dfSort(df, "-score");
    if (dfGetLong(byScore, "id", 0) != 10) { return 7; }
    if (!dfIsNull(byScore, "score", 9)) { return 8; }  // nulls last
    val byRegion = dfSort(df, "region, -id");
    if (dfGetLong(byRegion, "id", 0) != 9 or dfGetLong(byRegion, "id", 4) != 7 or dfGetLong(byRegion, "id", 9) != 2) { return 9; }

    // ---- group by ----
    val g = dfGroupBy(df, "region", "score:sum, score:mean, score:count, count, name:first");
    if (g == 0) {
        println(dfLastError());
        return 10;
    }
    if (dfRows(g) != 3 or dfColumns(g) != 6) { return 11; }
    if (dfColumnName(g, 1) != "score_sum" or dfColumnName(g, 4) != "count") { return 12; }
    // groups in order of first appearance: east, west, north
    if (dfGetString(g, "region", 1) != "west") { return 13; }
    if (dfGetDouble(g, "score_sum", 0) != 19.75e0 or dfGetDouble(g, "score_mean", 0) != 4.9375e0) { return 14; }
    if (dfGetDouble(g, "score_mean", 1) != 7.25e0 or dfGetLong(g, "score_count", 1) != 3) { return 15; }
    // north is rows 3 (name null) and 6 ("frank"); first skips nulls
    if (dfGetLong(g, "count", 2) != 2 or dfGetString(g, "name_first", 2) != "frank") { return 16; }
    val all = dfGroupBy(df, "", "id:sum, id:max, small:min, region:nunique");
    if (dfRows(all) != 1 or dfGetLong(all, "id_sum", 0) != 55 or dfGetLong(all, "id_max", 0) != 10) { return 17; }
    if (dfGetLong(all, "small_min", 0) != -3 or dfGetLong(all, "region_nunique", 0) != 3) { return 18; }
    if (dfGroupBy(df, "region", "name:sum") != 0) { return 19; }  // sum of a string column
    if (dfGroupBy(df, "region", "score:median") != 0) { return 20; }

    // ---- column statistics ----
    if (dfMean(df, "id") != 5.5e0 or dfMin(df, "score") != 1.5e0 or dfMax(df, "score") != 10.75e0) { return 21; }
    if (dfCount(df, "score") != 9 or dfCount(df, "missing") != -1) { return 22; }
    val sd = dfStd(df, "id");  // sample standard deviation of 1..10 = 3.0277
    if (sd < 3.02e0 or sd > 3.03e0) { return 23; }

    // ---- build a frame and join ----
    val managers = dfNew();
    dfAddColumn(managers, "region", "string");
    dfAddColumn(managers, "manager", "string");
    dfAddColumn(managers, "budget", "long");
    dfAppendString(managers, "region", "east");
    dfAppendString(managers, "manager", "Kim");
    dfAppendLong(managers, "budget", 100);
    dfAppendString(managers, "region", "west");
    dfAppendString(managers, "manager", "Lee");
    dfAppendNull(managers, "budget");
    if (dfRows(managers) != 2 or !dfIsNull(managers, "budget", 1)) { return 24; }
    if (dfAddColumn(managers, "budget", "long")) { return 25; }  // duplicate name
    if (dfAddColumn(managers, "x", "int")) { return 26; }  // unknown type
    val inner = dfJoin(df, managers, "region", "inner");
    if (dfRows(inner) != 8 or dfColumns(inner) != 8) { return 27; }
    val left = dfJoin(df, managers, "region", "left");
    if (dfRows(left) != 10 or dfNullCount(left, "manager") != 2) { return 28; }
    if (dfGetString(left, "manager", 1) != "Lee" or dfGetLong(left, "budget", 0) != 100) { return 29; }
    if (dfJoin(df, managers, "id=region", "inner") != 0) { return 30; }  // long vs string keys

    // ---- computed columns ----
    val c1 = dfCompute(df, "product", "id", "*", "small");
    if (dfColumnType(c1, "product") != "long" or dfSum(c1, "product") != 165.0e0) { return 31; }
    val c2 = dfCompute(c1, "mixed", "id", "+", "score");
    if (dfColumnType(c2, "mixed") != "double" or !dfIsNull(c2, "mixed", 4) or dfGetDouble(c2, "mixed", 0) != 2.5e0) { return 32; }
    val c3 = dfComputeScalar(c2, "score", "score", "*", 2.0e0);  // replaces the column
    if (dfColumns(c3) != 8 or dfGetDouble(c3, "score", 9) != 21.5e0) { return 33; }
    val ratio = dfComputeScalar(df, "half", "id", "/", 2.0e0);
    if (dfColumnType(ratio, "half") != "double" or dfGetDouble(ratio, "half", 0) != 0.5e0) { return 34; }
    val label = dfCompute(df, "label", "region", "+", "name");
    if (dfGetString(label, "label", 0) != "eastalice" or !dfIsNull(label, "label", 3)) { return 35; }

    // ---- select / drop / rename / slice / nulls / concat / value counts ----
    val sel = dfSelect(df, "name,id");
    if (dfColumns(sel) != 2 or dfColumnName(sel, 0) != "name") { return 36; }
    val dropped = dfDrop(df, "flag, small");
    if (dfColumns(dropped) != 4 or dfHasColumn(dropped, "flag")) { return 37; }
    val renamed = dfRename(df, "score", "points");
    if (!dfHasColumn(renamed, "points") or dfHasColumn(renamed, "score")) { return 38; }
    if (dfRename(df, "score", "id") != 0) { return 39; }
    val head = dfHead(df, 3);
    val tail = dfTail(df, 2);
    if (dfRows(head) != 3 or dfGetLong(tail, "id", 0) != 9 or dfRows(tail) != 2) { return 40; }
    if (dfRows(dfSlice(df, 8, 100)) != 2) { return 41; }
    val complete = dfDropNulls(df, "");
    if (dfRows(complete) != 7) { return 42; }
    if (dfRows(dfDropNulls(df, "score")) != 9) { return 43; }
    val twice = dfConcat(df, df);
    if (dfRows(twice) != 20 or dfSum(twice, "id") != 110.0e0) { return 44; }
    val counts = dfValueCounts(df, "region");
    if (dfGetString(counts, "region", 0) != "east" or dfGetLong(counts, "count", 0) != 4) { return 45; }
    if (dfGetString(counts, "region", 2) != "north" or dfGetLong(counts, "count", 2) != 2) { return 46; }

    // ---- CSV ----
    val csv = frameToCsv(df);
    val back = csvToFrame(csv);
    if (dfRows(back) != 10 or dfColumnType(back, "score") != "double" or dfColumnType(back, "id") != "long") { return 47; }
    if (dfSum(back, "score") != 52.5e0 or dfNullCount(back, "name") != 2) { return 48; }
    val quoted = csvToFrame("a,b\n1,\"x,y\"\n2,\"say \"\"hi\"\"\"\n3,\n");
    if (dfRows(quoted) != 3 or dfGetString(quoted, "b", 0) != "x,y") { return 49; }
    if (dfGetString(quoted, "b", 1) != "say \"hi\"" or !dfIsNull(quoted, "b", 2)) { return 50; }

    // ---- display ----
    val text = dfToString(dfHead(df, 3), 10);
    if (text.length < 40) { return 51; }
    println(dfToString(g, 10));
    return 0;
}
